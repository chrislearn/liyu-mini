                    if shop_side == "shop" { SegmentOn{text: "挑礼物" on_click: || {shop_side = "shop"; refresh()}} } else { Segment{text: "挑礼物" on_click: || {shop_side = "shop"; refresh()}} }
                    if shop_side == "wish" { SegmentOn{text: "熟人的心愿单" on_click: || {shop_side = "wish"; refresh()}} } else { Segment{text: "熟人的心愿单" on_click: || {shop_side = "wish"; refresh()}} }
