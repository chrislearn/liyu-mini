fn demo_reply(code, body){ return {is_ok: true, error: "", data: {status: code, body: body.to_json().parse_json()}} }
fn demo_fail(message){ return demo_reply(400, {error: message}) }
fn demo_merge(target, patch){ for k v in patch { target[k] = v }; return target }
fn demo_id(){ demo_data.next_id = demo_data.next_id + 1; return demo_data.next_id }
fn demo_product(id){ for p in demo_data.products { if p.id == id { return p } }; return nil }
fn demo_gift_view(g){
    let v = g.to_json().parse_json()
    let revealed = g.state != "sealed" && g.state != "opened"
    v.sender = if revealed && g.side == "inbox" {g.hidden_sender} else {nil}
    v.answer = nil; v.hidden_sender = nil
    if !revealed { v.message = ""; v.contract_text = ""; v.voucher_code = nil }
    if g.state != "opened" { v.clue = "" }
    if g.side == "outbox" && (g.state == "accepted" || g.state == "cashed_out" || g.state == "exchanged") { v.state = "handled" }
    return v
}
fn demo_gift_list(side){ let list = []; for g in demo_data.gifts { if g.side == side { list.push(demo_gift_view(g)) } }; return list }
fn demo_contracts(){
    let list = []; for g in demo_data.gifts { if g.state == "accepted" && g.contract_text != "" {
        list.push({gift_id: g.id, text: g.contract_text, contract_text: g.contract_text, mine: g.side == "inbox", peer_name: if g.side == "inbox" {g.hidden_sender.display_name} else {g.recipient.display_name}, created_on: "本次演示", status: g.contract_status, side: if g.side == "inbox" {"promised_to_me"} else {"promised_by_me"}, sender: g.hidden_sender, recipient: g.recipient, other: if g.side == "inbox" {g.hidden_sender} else {g.recipient}})
    } }; return list
}
fn demo_add_item(w, input){
    let item = demo_merge({id: demo_id(), product_id: nil, kind: "", max_price_cents: 0, wants: "", status: "open"}, input)
    if item.product_id != nil { for old in w.items { if old.product_id == item.product_id { return {id: old.id, already_present: true, error: ""} } } }
    if w.items.len() >= 8 { return {id: -1, already_present: false, error: "最多添加 8 项商品或商品需求。"} }
    w.items.push(item); w.item_count = w.items.len(); return {id: item.id, already_present: false, error: ""}
}
fn demo_new_gift(pid, recipient){
    let p = demo_product(pid)
    let g = {id: demo_id(), side: "outbox", product_id: pid, product: p, price_cents: p.price_cents, physical: p.physical, state: "sealed", unlock_kind: "free", clue: "", answer: "", hidden_sender: {id: 9000, display_name: demo_data.user.display_name}, sender: nil, recipient: {id: recipient, display_name: "熟人"}, ready: false, attempts_left: 3, expires_at: time_now() + 86400, transfer_child_id: nil, transfer_child_state: nil, message: "", contract_text: "", contract_status: nil, voucher_code: "DEMO-ONLY-NOT-REDEEMABLE", can_withdraw: true, carrier_delivered: false, recipient_confirmed: false}
    for f in demo_data.friends { if f.id == recipient { g.recipient.display_name = f.display_name } }
    demo_data.gifts.push(g); return g
}
fn demo_credit(g, amount, kind){
    demo_data.wallet.balance_cents = demo_data.wallet.balance_cents + amount
    demo_data.wallet.ledger.push({id: demo_id(), kind: kind, amount_cents: amount, gift_id: g.id, created_at_epoch: time_now()})
}
fn demo_tag_members(tag, ids){
    tag.member_ids = ids; tag.member_count = ids.len(); tag.member_names = []
    for id in ids { for f in demo_data.friends { if f.id == id { tag.member_names.push(f.display_name) } } }
}
fn demo_request(request){
    let path = request.path.split("?")[0]; let method = request.method; let body = if request.body == nil {{}} else {request.body}
    if path == "/catalog/categories" { return demo_reply(200, demo_data.categories) }
    if path == "/catalog" { return demo_reply(200, {items: demo_data.products}) }
    if path == "/me" || path == "/me/profile" {
        if method == "PATCH" { demo_merge(demo_data.user, body) }
        return demo_reply(200, demo_data.user)
    }
    if path == "/wallet" { return demo_reply(200, demo_data.wallet) }
    if path == "/friends" { return demo_reply(200, demo_data.friends) }
    if path == "/notifications" { return demo_reply(200, demo_data.notifications) }
    if path == "/contract-templates" { return demo_reply(200, demo_data.templates) }
    if path == "/contracts" { return demo_reply(200, demo_contracts()) }
    if path == "/gifts/inbox" { return demo_reply(200, demo_gift_list("inbox")) }
    if path == "/gifts/outbox" { return demo_reply(200, demo_gift_list("outbox")) }
    if path == "/wishlists/mine" || path == "/wishlists/friends" {
        let list = []; for w in demo_data.wishes { if (path == "/wishlists/mine" && w.owner.id == 9000) || (path == "/wishlists/friends" && w.owner.id != 9000 && w.status == "published") { list.push(w) } }; return demo_reply(200, list)
    }
    if path == "/wishlists/drafts" && method == "POST" {
        let w = demo_merge({id: demo_id(), owner: {id: 9000, display_name: demo_data.user.display_name}, title: "新心愿单", note: "", occasion: "other", event_on: "", status: "draft", is_open: false, item_count: 0, items: [], audience_user_ids: [], expires_at: 2440000000}, body)
        let pending = w.items; w.items = []; for item in pending { demo_add_item(w, item) }
        demo_data.wishes.push(w); return demo_reply(200, {id: w.id})
    }
    if path == "/me/addresses" {
        if method == "GET" { return demo_reply(200, demo_data.addresses) }
        let a = demo_merge({id: demo_id(), recipient_name: "", phone: "", address: "", is_default: false}, body)
        if a.is_default { for old in demo_data.addresses { old.is_default = false } }
        demo_data.addresses.push(a); return demo_reply(200, a)
    }
    let parts = path.split("/"); let id = if parts.len() > 2 {parts[2].to_f64()} else {-1}
    let action = if parts.len() > 3 {parts[3]} else {""}
    if path.search("/me/addresses/") == 0 {
        let aid = parts[3].to_f64(); let kept = []
        for a in demo_data.addresses { if a.id == aid && method == "PUT" { demo_merge(a, body); if a.is_default { for other in demo_data.addresses { if other.id != aid { other.is_default = false } } } }; if a.id != aid || method != "DELETE" { kept.push(a) } }
        demo_data.addresses = kept; return demo_reply(200, {id: aid})
    }
    if path.search("/wishlists/") == 0 {
        for w in demo_data.wishes { if w.id == id {
            if method == "GET" { return demo_reply(200, w) }
            if w.owner.id != 9000 { return demo_fail("演示中请在自己的心愿单里编辑商品。") }
            if action == "items" {
                if w.status != "draft" { return demo_fail("已发布的心愿单不能修改商品。") }
                if method == "POST" { let result = demo_add_item(w, body); if result.error != "" { return demo_fail(result.error) }; return demo_reply(200, result) }
                let kept = []; for item in w.items { if item.id != parts[4].to_f64() { kept.push(item) } }; w.items = kept; w.item_count = kept.len(); return demo_reply(200, {id: id})
            }
            if method == "DELETE" { let kept = []; for old in demo_data.wishes { if old.id != id { kept.push(old) } }; demo_data.wishes = kept; return demo_reply(200, {id: id}) }
            if action == "close" { w.status = "closed"; w.is_open = false }
            else { demo_merge(w, body); if action == "publish" { w.status = "published"; w.is_open = true } }
            return demo_reply(200, {id: id})
        } }; return demo_fail("没有找到这张心愿单。")
    }
    if path == "/orders/quote" || path == "/orders" {
        let input = demo_merge({product_id: -1, recipient_ids: [], recipient_id: -1, items: []}, body)
        let items = input.items
        if items.len() == 0 { for recipient in input.recipient_ids { items.push({product_id: input.product_id, recipient_id: recipient}) } }
        if items.len() == 0 && input.recipient_id >= 0 { items.push({product_id: input.product_id, recipient_id: input.recipient_id}) }
        let total = 0; for item in items { let p = demo_product(item.product_id); if p == nil { return demo_fail("请选择商品。") }; total = total + p.price_cents }
        if items.len() == 0 { return demo_fail("请选择收礼人。") }
        if path == "/orders/quote" { return demo_reply(200, {total_cents: total, count: items.len()}) }
        for old in demo_data.orders { if old.request_key == request.idempotency_key { return demo_reply(200, old) } }
        let order = {id: demo_id(), items: [], total_cents: total, request_key: request.idempotency_key}
        for item in items { let g = demo_new_gift(item.product_id, item.recipient_id); order.items.push({gift_id: g.id, product_id: item.product_id, recipient_id: item.recipient_id}) }
        demo_data.orders.push(order); return demo_reply(200, order)
    }
    if path.search("/orders/") == 0 { for order in demo_data.orders { if order.id == id { return demo_reply(200, order) } } }
    if path.search("/contracts/") == 0 { for g in demo_data.gifts { if g.id == id { g.contract_status = body.status; return demo_reply(200, {status: body.status}) } } }
    if path.search("/gifts/") == 0 {
        for g in demo_data.gifts { if g.id == id {
            if action == "" { return demo_reply(200, demo_gift_view(g)) }
            if action == "recovery-quote" { return demo_reply(200, {recovery_cents: floor(g.price_cents * 0.8)}) }
            if action == "puzzle" { demo_merge(g, body); g.ready = true; return demo_reply(200, {id: id}) }
            if action == "withdraw" { if !g.can_withdraw { return demo_fail("只能撤回未打开的礼盒。") }; g.state = "withdrawn"; g.can_withdraw = false; demo_credit(g, g.price_cents, "withdraw"); return demo_reply(200, {id: id}) }
            if g.side != "inbox" { return demo_fail("请在收到的礼盒中体验拆盒。") }
            if action == "open" { if g.state == "sealed" { g.state = if g.unlock_kind == "free" {"revealed"} else {"opened"} }; return demo_reply(200, {id: id, state: g.state}) }
            if action == "answer" {
                if g.state != "opened" || g.attempts_left <= 0 { return demo_fail("请先打开礼盒；次数用尽后可重新进入本地演示。") }
                let correct = body.answer.trim() == g.answer || (g.unlock_kind == "guess_who" && body.answer.trim() == g.hidden_sender.display_name)
                g.attempts_left = g.attempts_left - 1; if correct { g.state = "revealed" }
                return demo_reply(200, {correct: correct, state: g.state, attempts_left: g.attempts_left})
            }
            if g.state != "revealed" && g.state != "exchanged" { return demo_fail("请先答对问题并拆开礼盒。") }
            if action == "accept" { g.state = "accepted"; g.contract_status = "pending"; return demo_reply(200, {id: id}) }
            if action == "cash-out" { g.state = "cashed_out"; demo_credit(g, floor(g.price_cents * 0.8), "cash_out"); return demo_reply(200, {id: id}) }
            if action == "exchange" {
                let p = demo_product(body.product_id); if p == nil { return demo_fail("请选择商品。") }
                if demo_data.wallet.balance_cents + floor(g.price_cents * 0.8) < p.price_cents { return demo_fail("演示钱包余额不足。") }; demo_credit(g, floor(g.price_cents * 0.8) - p.price_cents, "exchange")
                g.product_id = p.id; g.product = p; g.price_cents = p.price_cents; g.physical = p.physical; g.state = "exchanged"; return demo_reply(200, {id: id})
            }
            if action == "transfer" { let child = demo_new_gift(g.product_id, body.recipient_id); demo_merge(child, body); child.ready = true; g.state = "transferred"; g.transfer_child_id = child.id; g.transfer_child_state = "sealed"; return demo_reply(200, {id: id}) }
        } }
    }
    if path.search("/shipments/") == 0 { return demo_reply(200, {carrier: "演示物流", tracking_number: "DEMO0001", carrier_delivered: true, recipient_confirmed: action == "confirm-receipt", events: [{at: "今天", description: "演示包裹已送达，未产生真实发货。"}]}) }
    if path == "/friend-tags" {
        if method == "GET" { return demo_reply(200, demo_data.tags) }
        let tag = {id: demo_id(), name: body.name, member_count: 0, member_ids: [], member_names: []}; demo_data.tags.push(tag); return demo_reply(200, tag)
    }
    if path.search("/friend-tags/") == 0 {
        if method == "DELETE" { let kept = []; for tag in demo_data.tags { if tag.id != id { kept.push(tag) } }; demo_data.tags = kept; return demo_reply(200, {id: id}) }
        for tag in demo_data.tags { if tag.id == id {
            if action == "members" { demo_tag_members(tag, body.friend_ids) } else { tag.name = body.name }
            return demo_reply(200, {id: id})
        } }
    }
    if path.search("/friends/") == 0 {
        for f in demo_data.friends { if f.id == id {
            if action == "details" { demo_merge(f, body); f.display_name = if f.nickname == "" {f.account_name} else {f.nickname} }
            if action == "tags" {
                for tag in demo_data.tags {
                    let ids = []; for member in tag.member_ids { if member != id { ids.push(member) } }
                    for tid in body.tag_ids { if tid == tag.id { ids.push(id) } }
                    demo_tag_members(tag, ids)
                }
            }
            return demo_reply(200, {id: id})
        } }
    }
    return demo_fail("此操作需要真实账号；可退出本地演示后登录体验。")
}
// Keep the established response shape so business actions share one transport.
fn api_request(input, done){
    let request = {method: "GET", path: "", token: nil, body: nil, idempotency_key: nil}
    for k v in input { request[k] = v }
    if demo_mode {
        let response = demo_request(request)
        start_timeout(0.01, || done(response)); return
    }
    let headers = {"Content-Type": ["application/json"], "Accept": ["application/json"]}
    let token = if request.token != nil {request.token} else {session_token}
    if token != "" { headers["Authorization"] = ["Bearer " + token] }
    if request.idempotency_key != nil { headers["Idempotency-Key"] = [request.idempotency_key] }
    let method = net.HttpMethod.GET
    if request.method == "POST" { method = net.HttpMethod.POST }
    if request.method == "PUT" { method = net.HttpMethod.PUT }
    if request.method == "PATCH" { method = net.HttpMethod.PATCH }
    if request.method == "DELETE" { method = net.HttpMethod.DELETE }
    let body = if request.body != nil {request.body.to_json().to_bytes()} else {nil}
    let settled = false
    net.http_request(net.HttpRequest{url: service_origin + "/api/v1" + request.path method: method headers: headers body: body}) do net.HttpEvents{
        on_response: |res| { if settled { return }; settled = true; done({is_ok: true, error: "", data: {status: res.status_code, body: if res.body == nil {nil} else {res.body.to_string().parse_json()}}}) }
        on_error: |_err| { if settled { return }; settled = true; done({is_ok: false, data: {status: 0, body: nil}, error: "无法连接礼遇服务，请检查网络和证书。"}) }
    }
    start_timeout(20.0, || { if !settled { settled = true; done({is_ok: false, data: {status: 0, body: nil}, error: "礼遇服务响应超时，请重试。"}) } })
}
fn flush_revocations(){
    if demo_mode { return }
    for token in revocations {
        api_request({method: "POST", path: "/auth/logout", token: token, body: {}}, fn(r){
            if r.is_ok && (r.data.status == 204 || r.data.status == 401) {
                let remaining = []; for value in revocations { if value != token { remaining.push(value) } }
                revocations = remaining; fs.write("revocations.json", {tokens: revocations}.to_json())
            }
        })
    }
}
fn revoke_later(token){
    if token == "" { return }
    revocations.push(token); fs.write("revocations.json", {tokens: revocations}.to_json()); flush_revocations()
}
