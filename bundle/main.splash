// LIYU-MINI: account credentials and bearer sessions belong to the host.
// Every business request is mediated by its LIYU host service.
let assets = "{{assets}}"
let products = []
let categories = [{id: "", name: "全部"}]
let friends = []
let my_wishes = []
let friend_wishes = []
let inbox = []
let outbox = []
let contracts = []
let contract_templates = []
let account = nil
let auth_state = "checking"
let auth_message = "正在检查登录状态…"
let auth_generation = 0
let profile = nil
let wallet = nil
let addresses = []
let wish_previews = []
let wish_detail = nil
let edit_title = ""
let edit_note = ""
let edit_date = ""
let gift_detail = nil
let gift_side = "inbox"
let shop_side = "shop"
let pact_side = "mine"
let contact_index = -1
let contact_id = -1
let contact_section_kind = "wishes"
let contact_wish_origin = "contact_detail"
let gift_from_contact = false
let friend_edit_field = ""
let friend_edit_value = ""
let tab = "discover"
let stage = "browse"
let selected_product = -1
let category_index = 0
let product_search = ""
let status = "正在连接 LIYU 服务…"
let notice = ""
let draft_command = ""
let draft_kind = ""
let draft_product = -1
let draft_wish_item_id = -1
let show_all_products = false
let draft_recipient_ids = []
let draft_title = ""
let draft_note = ""
let draft_date = ""
let draft_expiry_hours = "24"
let draft_message = ""
let draft_contract = ""
let draft_clue = ""
let draft_answer = ""
let draft_error = ""
let draft_unlock = "free"
let draft_occasion = "other"
let draft_audience = -1
let draft_item_mode = "exact"
let draft_vague_kind = ""
let draft_budget_cents = 0
let draft_wants = ""
let quote = nil
let order_key = ""
let guess = ""
let recipient_name = ""
let recipient_phone = ""
let recipient_address = ""
let edit_expiry_hours = ""
let desktop_mode = false

fn refresh(){ ui.content.render() }
fn pad2(n){ if n < 10 { return "0" + n } return "" + n }
fn today(){ let t = local_time(time_now() + 8 * 3600); return "" + t.year + "-" + pad2(t.month) + "-" + pad2(t.day) }
fn expiry_time(epoch){ let t = local_time(epoch + 8 * 3600); return "" + t.year + "-" + pad2(t.month) + "-" + pad2(t.day) + " " + pad2(t.hour) + ":" + pad2(t.minute) }
fn expiry_short(epoch){ let t = local_time(epoch + 8 * 3600); return "" + t.month + "/" + t.day + " " + pad2(t.hour) + ":" + pad2(t.minute) }
fn expiry_hours(){ let s = draft_expiry_hours.trim(); if !regex("^[0-9]+$", "").test(s) { return -1 }; let n = s.to_f64(); if n < 1 || n > 720 { return -1 }; return floor(n) }
fn money(cents){ if cents % 100 == 0 { return "¥" + floor(cents / 100) } return "¥" + floor(cents / 100) + "." + pad2(cents % 100) }
fn product_by_id(id){ for p in products { if p.id == id { return p } } return nil }
fn product_for_item(item){
    if item.product_id != nil { return product_by_id(item.product_id) }
    for p in products { if p.kind == item.kind && (item.max_price_cents == 0 || p.price_cents <= item.max_price_cents) { return p } }
    for p in products { if p.name.search(item.kind) >= 0 && (item.max_price_cents == 0 || p.price_cents <= item.max_price_cents) { return p } }
    return nil
}
fn open_wish_count(w){ let n = 0; for item in w.items { if item.status == "open" { n = n + 1 } } return n }
fn wish_state_name(state){ if state == "open" { return "还没人送" }; if state == "by_me" { return "由我送出" }; return "已有人送" }
fn product_image(p){ return "https://liyu.localhost:8443" + p.image_detail_url }
fn category_name(id){ for c in categories { if c.id == id { return c.name } } return id }
fn product_meta(p){
    let result = category_name(p.category) + " · " + p.brand
    for tag in p.tags { result = result + " · " + tag }
    return result
}
fn initial(name){ let parts = name.split(""); if parts.len() > 1 { return parts[1] } return "?" }
fn preview_by_id(id){ for w in wish_previews { if w.id == id { return w } } return nil }
fn occasion_name(kind){
    if kind == "birthday" { return "生日" }
    if kind == "wedding" { return "结婚" }
    if kind == "housewarming" { return "乔迁" }
    if kind == "graduation" { return "毕业" }
    if kind == "baby" { return "宝宝" }
    return "其他"
}
fn visible_product(p){
    if category_index > 0 && p.category != categories[category_index].id { return false }
    let q = product_search.trim()
    return q == "" || p.name.search(q) >= 0 || p.kind.search(q) >= 0 || p.description.search(q) >= 0
}
fn state_name(s){
    if s == "sealed" { return "待打开" }
    if s == "opened" || s == "revealed" || s == "accepted" || s == "handled" || s == "exchanged" || s == "cashed_out" { return "已打开" }
    if s == "withdrawn" { return "已撤回" }
    if s == "expired" { return "过期退回" }
    return s
}
fn pact_count(side){ let n = 0; for c in contracts { if (side == "mine" && c.mine) || (side == "theirs" && !c.mine) { n = n + 1 } } return n }
fn fulfilled_count(){ let n = 0; for c in contracts { if c.mine && c.status == "fulfilled" { n = n + 1 } } return n }
fn contract_state(status){ if status == "fulfilled" { return "已兑现" }; if status == "waived" { return "已免除" }; return "待兑现" }
fn clear_account_data(){
    auth_generation = auth_generation + 1
    products = []; categories = [{id: "", name: "全部"}]; friends = []
    my_wishes = []; friend_wishes = []; inbox = []; outbox = []; contracts = []; contract_templates = []
    draft_recipient_ids = []
    account = nil; profile = nil; wallet = nil; addresses = []; wish_previews = []
    wish_detail = nil; gift_detail = nil; quote = nil
    tab = "discover"; stage = "browse"; notice = ""; contact_index = -1; contact_id = -1; gift_from_contact = false
}
fn auth_lost(message){ clear_account_data(); auth_state = "signed_out"; auth_message = message; refresh() }
fn auth_ready(){ clear_account_data(); auth_state = "signed_in"; auth_message = ""; refresh(); load_all() }
fn check_auth(){
    host.request("liyu.status", {}, fn(r){
        if !r.is_ok { auth_state = "error"; auth_message = r.error; refresh(); return }
        if r.data.signed_in { auth_ready() }
        else { auth_lost(if r.data.expired { "登录已过期，请重新登录。" } else { "请登录或注册 LIYU 账号。" }) }
    })
}
fn sign_in(){
    auth_message = "请在 LIYU 登录弹层中继续。"; refresh()
    host.request("liyu.sign_in", {}, fn(r){
        if r.is_ok { auth_ready() }
        else { auth_state = "signed_out"; auth_message = r.error; refresh() }
    })
}
fn logout(){
    auth_lost("已退出 LIYU 账号。")
    host.request("liyu.logout", {}, fn(r){ if !r.is_ok { auth_message = r.error; refresh() } })
}
fn get(path, kind){
    if auth_state != "signed_in" { return }
    let generation = auth_generation
    host.request("liyu.request", {method: "GET", path: path}, fn(r){
            if generation != auth_generation { return }
            if !r.is_ok { status = r.error + "（" + kind + "）"; refresh(); return }
            if r.data.status == 401 { auth_lost("登录已过期，请重新登录。"); return }
            if r.data.status < 200 || r.data.status >= 300 {
                status = "LIYU 服务返回 " + r.data.status + "（" + kind + "）"; refresh(); return
            }
            let data = r.data.body
            if data == nil { status = "LIYU 服务响应无法解析（" + kind + "）"; refresh(); return }
            if kind == "catalog" { products = data.items; status = "已连接 LIYU 服务 · " + products.len() + " 件商品" }
            if kind == "categories" { categories = [{id: "", name: "全部"}]; for c in data { categories.push(c) } }
            if kind == "friends" {
                friends = data
                if contact_id >= 0 {
                    contact_index = -1
                    for i in friends.len() { if friends[i].id == contact_id { contact_index = i } }
                }
                let valid = []
                for id in draft_recipient_ids { for friend in friends { if friend.id == id { valid.push(id) } } }
                if valid.len() != draft_recipient_ids.len() { quote = nil }
                draft_recipient_ids = valid
            }
            if kind == "mine" { my_wishes = data }
            if kind == "friend_wishes" { friend_wishes = data; wish_previews = []; for w in data { get("/wishlists/" + w.id, "preview") } }
            if kind == "preview" { wish_previews.push(data) }
            if kind == "inbox" { inbox = data }
            if kind == "outbox" { outbox = data }
            if kind == "contracts" { contracts = data }
            if kind == "contract_templates" { contract_templates = data }
            if kind == "me" { account = data }
            if kind == "profile" { profile = data }
            if kind == "wallet" { wallet = data }
            if kind == "addresses" { addresses = data }
            if kind == "wish_detail" { wish_detail = data }
            if kind == "gift_detail" { gift_detail = data }
            refresh()
    })
}
fn mutate(path, method, payload, done){
    if auth_state != "signed_in" { return }
    let generation = auth_generation
    host.request("liyu.request", {method: method, path: path, body: payload}, fn(r){
        if generation != auth_generation { return }
        if !r.is_ok { notice = r.error; refresh(); return }
        if r.data.status == 401 { auth_lost("登录已过期，请重新登录。"); return }
        if r.data.status < 200 || r.data.status >= 300 {
            notice = "服务端拒绝操作（HTTP " + r.data.status + "）：" + r.data.body.error; refresh(); return
        }
        done(r.data.body)
    })
}
fn load_all(){
    get("/catalog/categories", "categories")
    get("/catalog?limit=50", "catalog")
    get("/me", "me")
    get("/me/profile", "profile")
    get("/wallet", "wallet")
    get("/me/addresses", "addresses")
    get("/friends", "friends")
    get("/wishlists/mine", "mine")
    get("/wishlists/friends", "friend_wishes")
    get("/gifts/inbox", "inbox")
    get("/gifts/outbox", "outbox")
    get("/contracts", "contracts")
    get("/contract-templates", "contract_templates")
}
fn go(next){ tab = next; stage = "browse"; notice = ""; gift_from_contact = false; refresh() }
fn choose_product(i){ selected_product = i; stage = "detail"; refresh() }
fn gift_product_id(id){ for i in products.len() { if products[i].id == id { begin("gift", i); return } } notice = "这件商品已不在服务端目录中。"; refresh() }
fn gift_wish_item(item){
    let p = product_for_item(item)
    if p == nil { notice = "服务端目录没有符合这份心愿的商品。"; refresh(); return }
    gift_product_id(p.id)
    draft_wish_item_id = item.id
    if wish_detail != nil { for friend in friends { if friend.id == wish_detail.owner.id { draft_recipient_ids.push(friend.id) } } }
    refresh()
}
fn choose_wish(id){ wish_detail = nil; stage = "wish_detail"; get("/wishlists/" + id, "wish_detail"); refresh() }
fn edit_wish(){
    if wish_detail == nil { return }
    edit_title = wish_detail.title; edit_note = wish_detail.note; edit_date = wish_detail.event_on; edit_expiry_hours = ""
    stage = "wish_edit"; refresh()
}
fn save_wish_edit(){
    if wish_detail == nil { return }
    if edit_expiry_hours.trim() != "" && (!regex("^[0-9]+$", "").test(edit_expiry_hours.trim()) || edit_expiry_hours.trim().to_f64() < 1 || edit_expiry_hours.trim().to_f64() > 720) { notice = "有效期请输入 1–720 小时。"; refresh(); return }
    let id = wish_detail.id
    let body = {title: edit_title.trim(), note: edit_note.trim(), occasion: wish_detail.occasion, event_on: edit_date.trim()}
    if edit_expiry_hours.trim() != "" { body.expires_hours = floor(edit_expiry_hours.trim().to_f64()) }
    mutate("/wishlists/" + id, "PUT", body, |_data| {
        notice = "心愿单已更新。"; stage = "wish_detail"; get("/wishlists/" + id, "wish_detail"); get("/wishlists/mine", "mine"); refresh()
    })
}
fn confirm_wish_action(action){
    if wish_detail == nil { return }
    let id = wish_detail.id
    if action == "close" { mutate("/wishlists/" + id + "/close", "POST", {}, |_data| { notice = "心愿单已提前结束。"; stage = "wish_detail"; get("/wishlists/" + id, "wish_detail"); get("/wishlists/mine", "mine"); refresh() }) }
    if action == "delete" { mutate("/wishlists/" + id, "DELETE", {}, |_data| { notice = "心愿单已删除。"; tab = "wishes"; stage = "browse"; get("/wishlists/mine", "mine"); refresh() }) }
}
fn choose_gift(id){ gift_from_contact = false; gift_detail = nil; stage = "gift_detail"; get("/gifts/" + id, "gift_detail"); refresh() }
fn choose_contact(i){ contact_index = i; contact_id = friends[i].id; notice = ""; stage = "contact_detail"; refresh() }
fn contact_section(kind){ contact_section_kind = kind; stage = "contact_section"; refresh() }
fn contact_wish(id, origin){ contact_wish_origin = origin; wish_detail = nil; stage = "contact_wish_detail"; get("/wishlists/" + id, "wish_detail"); refresh() }
fn contact_gift(id, side){ gift_side = side; tab = "box"; choose_gift(id); gift_from_contact = true; refresh() }
fn friend_wish_count(id){ let n = 0; for w in friend_wishes { if w.owner.id == id { n = n + 1 } } return n }
fn friend_gift_count(id, kind){
    let n = 0
    if kind == "sent" { for g in outbox { if g.recipient.id == id { n = n + 1 } } }
    else { for g in inbox { if g.sender != nil && g.sender.id == id { n = n + 1 } } }
    return n
}
fn friend_field(f, field){
    if field == "nickname" { return f.nickname }
    if field == "phone" { return f.phone }
    if field == "email" { return f.email }
    if field == "relationship" { return f.relationship }
    if field == "birthday" { return f.birthday }
    return f.note
}
fn friend_field_name(field){
    if field == "nickname" { return "称呼" }
    if field == "phone" { return "手机号" }
    if field == "email" { return "邮箱" }
    if field == "relationship" { return "关系" }
    if field == "birthday" { return "生日" }
    return "备注"
}
fn edit_friend(field){ friend_edit_field = field; friend_edit_value = friend_field(friends[contact_index], field); stage = "contact_edit"; refresh() }
fn save_friend(){
    if contact_index < 0 { return }
    let f = friends[contact_index]
    let value = friend_edit_value.trim()
    let body = {nickname: f.nickname, phone: f.phone, email: f.email, relationship: f.relationship, birthday: f.birthday, note: f.note}
    if friend_edit_field == "nickname" { body.nickname = value }
    if friend_edit_field == "phone" { body.phone = value }
    if friend_edit_field == "email" { body.email = value }
    if friend_edit_field == "relationship" { body.relationship = value }
    if friend_edit_field == "birthday" { body.birthday = value }
    if friend_edit_field == "note" { body.note = value }
    mutate("/friends/" + f.id + "/details", "PUT", body, |_data| {
        stage = "contact_profile"; notice = ""; get("/friends", "friends"); refresh()
    })
}
fn set_gift_side(side){ gift_side = side; get("/gifts/" + side, side); refresh() }
fn next_category(){ category_index = (category_index + 1) % categories.len(); refresh() }
fn begin(kind, product){
    draft_kind = kind; draft_product = product; draft_wish_item_id = -1; draft_recipient_ids = []
    show_all_products = false
    draft_title = ""; draft_note = ""; draft_date = today(); draft_expiry_hours = "24"
    draft_message = ""; draft_contract = ""; draft_clue = ""; draft_answer = ""; draft_error = ""
    draft_unlock = "free"; draft_occasion = "other"; draft_audience = -1
    draft_item_mode = "exact"; draft_vague_kind = ""; draft_budget_cents = 0; draft_wants = ""; quote = nil
    order_key = "mini-" + time_now() + "-" + random_u32()
    tab = "command"; stage = "draft"; notice = ""; refresh()
}
fn recipient_selected(id){ for selected in draft_recipient_ids { if selected == id { return true } } return false }
fn choose_recipient(i){
    let id = friends[i].id
    if recipient_selected(id) { notice = "这位熟人已在送礼名单中。"; refresh(); return }
    if draft_recipient_ids.len() >= 100 { notice = "一次最多选择 100 位熟人。"; refresh(); return }
    if draft_wish_item_id >= 0 && draft_recipient_ids.len() > 0 {
        draft_wish_item_id = -1
        notice = "多人送礼已取消单人心愿关联。"
    }
    draft_recipient_ids.push(id); quote = nil; stage = "draft"; refresh()
}
fn remove_recipient(id){
    let kept = []
    for selected in draft_recipient_ids { if selected != id { kept.push(selected) } }
    draft_recipient_ids = kept; quote = nil; refresh()
}
fn recipient_name(id){ for friend in friends { if friend.id == id { return friend.display_name } } return "已失效的熟人" }
fn recipients_valid(){
    if draft_recipient_ids.len() == 0 { return false }
    for id in draft_recipient_ids {
        let found = false
        for friend in friends { if friend.id == id { found = true } }
        if !found { return false }
    }
    return true
}
fn gift_checkout_body(){
    let items = []
    for id in draft_recipient_ids {
        let item = {product_id: products[draft_product].id, recipient_id: id}
        if draft_wish_item_id >= 0 && draft_recipient_ids.len() == 1 { item.wish_item_id = draft_wish_item_id }
        items.push(item)
    }
    return {items: items, expires_hours: expiry_hours()}
}
fn gift_form_error(){
    let clue = draft_clue.trim()
    let answer = draft_answer.trim()
    if draft_unlock != "free" {
        if draft_unlock != "guess_who" && clue == "" { return "请填写题目或暗号提示。" }
        if answer == "" { return "请填写答案。" }
        if !regex("[[:alnum:]]", "").test(answer) { return "答案至少包含一个文字或数字。" }
        if clue.split("").len() > 30 { return "题目或提示最多 30 个字。" }
        if answer.split("").len() > 20 { return "答案最多 20 个字。" }
    }
    if draft_message.trim().split("").len() > 40 { return "想说的话最多 40 个字。" }
    if draft_contract.trim().split("").len() > 24 { return "约定最多 24 个字。" }
    return ""
}
fn unlock_name(mode){
    if mode == "guess_who" { return "猜我是谁" }
    if mode == "question" { return "私密问答" }
    if mode == "passphrase" { return "专属暗号" }
    return "直接领取"
}
fn parse_command(){
    let q = draft_command.trim()
    if q == "" { notice = "先输入一句想做的事。"; refresh(); return }
    let kind = ""
    if q.search("心愿") >= 0 || q.search("想要") >= 0 { kind = "wish" }
    if q.search("送") >= 0 || q.search("礼物") >= 0 { kind = "gift" }
    if kind == "" { notice = "目前识别心愿和送礼。"; refresh(); return }
    let found = -1
    for i in products.len() { if q.search(products[i].name) >= 0 || q.search(products[i].kind) >= 0 { found = i } }
    begin(kind, found)
    if kind == "gift" { for friend in friends { if q.search(friend.display_name) >= 0 && !recipient_selected(friend.id) { draft_recipient_ids.push(friend.id) } } }
    if found < 0 { notice = "服务端目录中没有识别到对应商品，请从实际在售商品中选择。" }
    refresh()
}
fn create_wish(){
    if expiry_hours() < 1 { notice = "有效期请输入 1–720 小时（最多 30 天）。"; refresh(); return }
    if draft_title.trim() == "" { notice = "请输入心愿单名称。"; refresh(); return }
    if draft_item_mode == "exact" && draft_product < 0 { notice = "请选择服务端商品。"; refresh(); return }
    if draft_item_mode == "vague" && draft_vague_kind == "" { notice = "请选择一个礼物种类。"; refresh(); return }
    let audience = []
    if draft_audience >= 0 { audience.push(friends[draft_audience].id) }
    let items = []
    if draft_item_mode == "exact" { items.push({product_id: products[draft_product].id, wants: draft_wants.trim()}) }
    else { items.push({kind: draft_vague_kind, max_price_cents: draft_budget_cents, wants: draft_wants.trim()}) }
    let body = {title: draft_title.trim(), note: draft_note.trim(), occasion: draft_occasion, event_on: draft_date.trim(), expires_hours: expiry_hours(), audience_user_ids: audience, items: items}
    mutate("/wishlists", "POST", body, |data| {
        notice = "心愿单已保存至 LIYU 服务（编号 " + data.id + "）。"
        tab = "wishes"; stage = "browse"; get("/wishlists/mine", "mine"); refresh()
    })
}
fn quote_gift(){
    if expiry_hours() < 1 { draft_error = "有效期请输入 1–720 小时（最多 30 天）。"; refresh(); return }
    if draft_product < 0 { notice = "请确认商品。"; refresh(); return }
    if !recipients_valid() { notice = "请从熟人列表选择至少一位收礼人。"; refresh(); return }
    draft_error = gift_form_error()
    if draft_error != "" { notice = ""; refresh(); return }
    let body = gift_checkout_body()
    mutate("/orders/quote", "POST", body, |data| { quote = data; stage = "checkout"; notice = "价格已由 LIYU 服务端核算。"; refresh() })
}
fn create_order(){
    if expiry_hours() < 1 { stage = "draft"; draft_error = "有效期请输入 1–720 小时（最多 30 天）。"; refresh(); return }
    if quote == nil { notice = "请先获取服务端报价。"; refresh(); return }
    if !recipients_valid() { notice = "收礼人已不在熟人列表，请重新选择。"; quote = nil; refresh(); return }
    draft_error = gift_form_error()
    if draft_error != "" { stage = "draft"; quote = nil; notice = ""; refresh(); return }
    let body = gift_checkout_body()
    let generation = auth_generation
    host.request("liyu.request", {method: "POST", path: "/orders", body: body, idempotency_key: order_key}, fn(r){
            if generation != auth_generation { return }
            if !r.is_ok { notice = r.error; refresh(); return }
            if r.data.status == 401 { auth_lost("登录已过期，请重新登录。"); return }
            if r.data.status < 200 || r.data.status >= 300 { notice = "订单创建失败（HTTP " + r.data.status + ")：" + r.data.body.error; refresh(); return }
            let order = r.data.body
            notice = "测试订单 " + order.id + " 已创建，正在执行测试支付…"; refresh()
            mutate("/orders/" + order.id + "/pay-test", "POST", {}, |_paid| {
                get_paid_order(order.id)
            })
    })
}
fn get_paid_order(id){
    let generation = auth_generation
    host.request("liyu.request", {method: "GET", path: "/orders/" + id}, fn(r){
            if generation != auth_generation { return }
            if !r.is_ok { notice = r.error; refresh(); return }
            if r.data.status == 401 { auth_lost("登录已过期，请重新登录。"); return }
            if r.data.status != 200 { notice = "测试支付已发出；请在服务端确认订单 " + id + "。"; refresh(); return }
            let order = r.data.body
            if order.items.len() == 0 { notice = "订单没有礼物，需核查服务端。"; refresh(); return }
            configure_paid_gifts(order.items, 0)
    })
}
fn configure_paid_gifts(items, index){
    if index >= items.len() {
        notice = items.len() + " 份测试礼物已保存到 LIYU 服务。"
        tab = "box"; stage = "browse"; gift_side = "outbox"
        get("/gifts/outbox", "outbox"); get("/gifts/inbox", "inbox"); refresh()
        return
    }
    let gift_id = items[index].gift_id
    if gift_id == nil { notice = "订单中的第 " + (index + 1) + " 份礼物尚未生成，请核查服务端。"; refresh(); return }
    let clue = if draft_unlock == "free" { "" } else { draft_clue.trim() }
    let answer = if draft_unlock == "free" { "" } else { draft_answer.trim() }
    let body = {unlock_kind: draft_unlock, clue: clue, answer: answer, message: draft_message.trim(), contract_text: draft_contract.trim()}
    mutate("/gifts/" + gift_id + "/puzzle", "PUT", body, |_configured| { configure_paid_gifts(items, index + 1) })
}
fn gift_action(action, body){
    if gift_detail == nil { return }
    let id = gift_detail.id
    mutate("/gifts/" + id + "/" + action, "POST", body, |_data| {
        notice = "服务端礼物状态已更新。"
        get("/gifts/" + id, "gift_detail"); get("/gifts/inbox", "inbox"); get("/gifts/outbox", "outbox"); get("/contracts", "contracts")
    })
}
start_timeout(0.05, || check_auth())

