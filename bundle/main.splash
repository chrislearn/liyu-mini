    draw_text +: {color: ink color_hover: ink color_down: ink color_focus: ink color_disabled: faint text_style: theme.font_bold{font_size: 13.0}}}
let Entry = TextInput{width: Fill height: 44
    draw_bg +: {color: #x1f142c color_hover: #x261a36 color_focus: #x261a36 color_down: #x261a36 color_empty: #x1f142c color_disabled: #x1f142c border_color: #x3a294f border_color_hover: #x665184 border_color_focus: blue border_color_down: blue border_color_empty: #x3a294f border_color_disabled: #x3a294f border_size: 1.0 border_radius: 6.0}
