        View{width: 140 height: Fill align: Align{x: 0.0 y: 0.5}
            if stage != "browse" { Link{text: "‹" draw_text.text_style: theme.font_bold{font_size: 28} on_click: || {
                if tab == "discover" { go("discover") }
