                            else { Chip{text: categories[i].name on_click: || {category_index = i; refresh()}} }
                        }
                    }
                    if products.len() == 0 { Label{text: "正在读取礼物目录…" draw_text.color: muted} }
                    View{width: Fill height: Fit flow: Right{wrap: true} wrap_spacing: 12 spacing: 12
                        for i in products.len() { if visible_product(products[i]) {
                            View{width: 181 height: Fit flow: Overlay
                                RoundedView{width: 181 height: Fit flow: Down padding: 8 spacing: 3 draw_bg +: {color: #x271a36 border_color: #x3a294f border_size: 1.0 border_radius: 8.0}
                                    Image{width: 165 height: 165 src: http_resource(product_image(products[i])) fit: ImageFit.CropToFill}
                                    Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: products[i].name draw_text.color: ink draw_text.text_style.font_size: 13.5}
                                    Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: products[i].brand draw_text.color: faint draw_text.text_style.font_size: 11.5}
                                    View{width: Fill height: Fit flow: Right align: Align{x: 0.0 y: 0.5}
                                        Label{width: Fill text: money(products[i].price_cents) draw_text.color: accent draw_text.text_style.font_size: 15}
                                        if products[i].physical { Label{text: "实物" draw_text.color: muted draw_text.text_style.font_size: 11} }
                                        else { Label{text: "电子券" draw_text.color: muted draw_text.text_style.font_size: 11} }
                                    }
                                }
                                RowHit{on_click: || choose_product(i)}
                            }
                        } }
                    }
                    Label{width: Fill text: "点一件看详情。礼卡不出现礼物名和价格，解开谜题才揭晓。" draw_text.color: faint draw_text.text_style.font_size: 12}
                }
                if shop_side == "wish" {
                    Card{padding: 6 spacing: 0
                        View{width: Fill height: 64 flow: Overlay
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 12 right: 12} spacing: 10
                                RoundedView{width: 38 height: 38 align: Align{x: 0.5 y: 0.5} draw_bg +: {color: #x352446 border_radius: 8.0} Label{text: "♡" draw_text.color: accent draw_text.text_style.font_size: 19}}
                                View{width: Fill height: Fit flow: Down spacing: 3
                                    Label{text: "我的心愿单" draw_text.color: ink draw_text.text_style.font_size: 15}
                                    Label{text: my_wishes.len() + " 份心愿单" draw_text.color: faint draw_text.text_style.font_size: 12}
                                }
                                Label{text: "›" draw_text.color: faint draw_text.text_style.font_size: 21}
                            }
                            RowHit{on_click: || go("wishes")}
                        }
                    }
                    Label{text: "熟人的心愿单" draw_text.color: muted draw_text.text_style: theme.font_bold{font_size: 13}}
                    if friend_wishes.len() == 0 { Card{padding: 20 Label{text: "暂无可见的熟人心愿单" draw_text.color: faint}} }
                    for w in friend_wishes {
                        let wd = preview_by_id(w.id)
                        View{width: Fill height: Fit flow: Overlay
                            Card{padding: 14 spacing: 10
                                View{width: Fill height: Fit flow: Right align: Align{x: 0.0 y: 0.5} spacing: 10
                                    RoundedView{width: 36 height: 36 align: Align{x: 0.5 y: 0.5} draw_bg +: {color: #x352446 border_radius: 8.0} Label{text: initial(w.owner.display_name) draw_text.color: accent draw_text.text_style.font_size: 15}}
                                    View{width: Fill height: Fit flow: Down spacing: 2
                                        Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: w.title draw_text.color: ink draw_text.text_style.font_size: 15}
                                        Label{text: w.owner.display_name + " · " + w.event_on draw_text.color: faint draw_text.text_style.font_size: 12}
                                    }
                                    Label{text: occasion_name(w.occasion) draw_text.color: accent draw_text.text_style.font_size: 11}
                                }
                                if wd != nil {
                                    View{width: Fill height: Fit flow: Right spacing: 8
                                        for i in wd.items.len() { if i < 5 {
                                            let p = product_for_item(wd.items[i])
                                            if p != nil { Image{width: 52 height: 52 src: http_resource(product_image(p)) fit: ImageFit.CropToFill} }
                                        } }
                                    }
                                    Label{text: wd.items.len() + " 件 · 还有 " + open_wish_count(wd) + " 件没人送" draw_text.color: muted draw_text.text_style.font_size: 12.5}
                                }
                            }
                            RowHit{on_click: || {tab = "wishes"; choose_wish(w.id)}}
                        }
                    }
                    Label{width: Fill text: "谁送了哪一件，揭晓前心愿单主人都不知道。" draw_text.color: faint draw_text.text_style.font_size: 12}
                }
            }
        }
        if tab == "discover" && stage == "detail" && selected_product >= 0 {
            let p = products[selected_product]
            ScrollYView{width: Fill height: Fill flow: Down padding: Inset{left: 16 right: 16 top: 10 bottom: 16} spacing: 14
                Image{width: Fill height: 360 src: http_resource("https://liyu.localhost:8443" + p.image_detail_url) fit: ImageFit.CropToFill}
                View{width: Fill height: Fit flow: Down spacing: 5
                    Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: p.name draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                    View{width: Fill height: Fit flow: Right align: Align{x: 0.0 y: 0.0} padding: Inset{bottom: 6} spacing: 9
                        Label{text: money(p.price_cents) draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 20}}
                        Label{width: Fill max_lines: 1 text_overflow: Ellipsis margin: Inset{top: 10} text: product_meta(p) draw_text.color: faint draw_text.text_style.font_size: 11.5}
                    }
                }
                View{width: Fill height: Fit flow: Right spacing: 8
                    Primary{width: Fill text: "送给TA" on_click: || begin("gift", selected_product)}
                    Secondary{width: Fill text: "加到心愿单" on_click: || begin("wish", selected_product)}
                }
                Card{padding: 14 spacing: 10
                    Label{text: "礼物详情" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                    Label{width: Fill text: p.description draw_text.color: muted draw_text.text_style.font_size: 14.5}
                    Label{text: "规格  " + p.spec draw_text.color: muted draw_text.text_style.font_size: 13}
                    if p.physical { Label{text: "类型  实物礼物" draw_text.color: muted draw_text.text_style.font_size: 13} }
                    else { Label{text: "类型  电子礼物" draw_text.color: muted draw_text.text_style.font_size: 13} }
                }
                Card{padding: 14 spacing: 7
                    Label{text: "送礼提示" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                    Label{width: Fill text: "送出后礼卡会暂时隐藏礼物，收礼人解开谜题后才能看到。" draw_text.color: muted draw_text.text_style.font_size: 13}
                }
                Label{text: "同类还有" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                View{width: Fill height: Fit flow: Right{wrap: true} wrap_spacing: 12 spacing: 12
                    for i in products.len() { if i != selected_product && products[i].category == p.category {
                        View{width: 181 height: Fit flow: Overlay
                            Card{width: 181 padding: 8 spacing: 4
                                Image{width: 165 height: 165 src: http_resource(product_image(products[i])) fit: ImageFit.CropToFill}
                                Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: products[i].name draw_text.color: ink draw_text.text_style.font_size: 13.5}
                                Label{text: money(products[i].price_cents) draw_text.color: accent draw_text.text_style.font_size: 15}
                            }
                            RowHit{on_click: || choose_product(i)}
                        }
                    } }
                }
            }
        }
        if tab == "box" && stage == "browse" {
            ScrollYView{width: Fill height: Fill flow: Down padding: Inset{left: 16 right: 16 top: 10 bottom: 16} spacing: 14
                RoundedView{width: Fill height: Fit flow: Right padding: 4 spacing: 4 draw_bg +: {color: #x1f142c border_radius: 8.0}
                    if gift_side == "inbox" { SegmentOn{text: "收到的" on_click: || set_gift_side("inbox")} } else { Segment{text: "收到的" on_click: || set_gift_side("inbox")} }
                    if gift_side == "outbox" { SegmentOn{text: "送出的" on_click: || set_gift_side("outbox")} } else { Segment{text: "送出的" on_click: || set_gift_side("outbox")} }
                }
                Card{padding: 6 spacing: 2
                    if gift_side == "inbox" && inbox.len() == 0 { Label{text: "暂无收到的礼物" draw_text.color: faint} }
                    if gift_side == "outbox" && outbox.len() == 0 { Label{text: "暂无送出的礼物" draw_text.color: faint} }
                    if gift_side == "inbox" { for g in inbox {
                        View{width: Fill height: 100 flow: Overlay
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 8 right: 8} spacing: 10
                                if g.state == "sealed" || g.state == "opened" { RoundedView{width: 44 height: 44 align: Align{x: 0.5 y: 0.5} draw_bg +: {color: #x352446 border_radius: 6.0} Label{text: "?" draw_text.color: accent draw_text.text_style.font_size: 23}} }
                                else { let p = product_by_id(g.product_id); if p != nil { Image{width: 44 height: 44 src: http_resource(product_image(p)) fit: ImageFit.CropToFill} } }
                                View{width: Fill height: Fit flow: Down spacing: 3
                                    if g.state == "sealed" || g.state == "opened" { Label{text: "一份神秘礼物" draw_text.color: ink draw_text.text_style.font_size: 15} }
                                    else { let p = product_by_id(g.product_id); if p != nil { Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: p.name draw_text.color: ink draw_text.text_style.font_size: 15} } }
                                    if g.state == "sealed" || g.state == "opened" { Label{text: "拆开前不展示商品和送礼人" draw_text.color: faint draw_text.text_style.font_size: 12} }
                                    else { Label{text: "礼物已打开" draw_text.color: faint draw_text.text_style.font_size: 12} }
                                    Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: "有效期至 " + expiry_time(g.expires_at) draw_text.color: faint draw_text.text_style.font_size: 11}
                                }
                                Label{text: state_name(g.state) draw_text.color: accent draw_text.text_style.font_size: 12}
                            }
                            RowHit{on_click: || choose_gift(g.id)}
                        }
                    } }
                    if gift_side == "outbox" { for g in outbox {
                        View{width: Fill height: 80 flow: Overlay
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 8 right: 8} spacing: 10
                                let p = product_by_id(g.product_id)
                                if p != nil { Image{width: 44 height: 44 src: http_resource(product_image(p)) fit: ImageFit.CropToFill} }
                                View{width: Fill height: Fit flow: Down spacing: 3
                                    if p != nil { Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: p.name draw_text.color: ink draw_text.text_style.font_size: 15} }
                                    Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: "送给 " + g.recipient.display_name + " · " + expiry_short(g.expires_at) + " 到期" draw_text.color: faint draw_text.text_style.font_size: 11.5}
                                }
                                Label{text: state_name(g.state) draw_text.color: accent draw_text.text_style.font_size: 12}
                            }
                            RowHit{on_click: || choose_gift(g.id)}
                        }
                    } }
                }
            }
        }
        if tab == "box" && stage == "gift_detail" {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                if gift_detail == nil { Label{text: "正在读取礼卡…" draw_text.color: faint} }
                if gift_detail != nil {
                    if gift_side == "outbox" {
                        let p = product_by_id(gift_detail.product_id)
                        Card{padding: 16 spacing: 13
                            View{width: Fill height: Fit flow: Right align: Align{x: 0.0 y: 0.5} spacing: 12
                                if p != nil { Image{width: 88 height: 88 src: http_resource(product_image(p)) fit: ImageFit.CropToFill} }
                                View{width: Fill height: Fit flow: Down spacing: 6
                                    if p != nil { Label{width: Fill max_lines: 2 text_overflow: Ellipsis text: p.name draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}} }
                                    Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: "送给 " + gift_detail.recipient.display_name draw_text.color: muted draw_text.text_style.font_size: 13}
                                    Label{text: state_name(gift_detail.state) draw_text.color: accent draw_text.text_style.font_size: 13}
                                }
                            }
                        }
                        Card{padding: 16 spacing: 11
                            Label{text: "礼物信息" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                            Label{text: "收礼人  " + gift_detail.recipient.display_name draw_text.color: muted draw_text.text_style.font_size: 13}
                            Label{text: "礼物金额  " + money(gift_detail.price_cents) draw_text.color: muted draw_text.text_style.font_size: 13}
                            Label{text: "有效期至  " + expiry_time(gift_detail.expires_at) draw_text.color: muted draw_text.text_style.font_size: 13}
                            Label{text: "礼物编号  " + gift_detail.id draw_text.color: faint draw_text.text_style.font_size: 12}
                        }
                        if gift_detail.contract_text != "" {
                            Card{padding: 16 spacing: 10
                                Label{text: "附带的约定" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                                Label{width: Fill text: gift_detail.contract_text draw_text.color: muted draw_text.text_style.font_size: 14}
                                for c in contracts { if c.gift_id == gift_detail.id { Label{text: contract_state(c.status) draw_text.color: accent draw_text.text_style.font_size: 12} } }
                            }
                        }
                        Card{padding: 16 spacing: 10
                            Label{text: "礼物进度" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                            if gift_detail.state == "sealed" { Label{text: "等待 TA 打开礼物" draw_text.color: muted draw_text.text_style.font_size: 13} }
                            if gift_detail.state == "opened" || gift_detail.state == "revealed" { Label{text: "TA 已打开礼物" draw_text.color: muted draw_text.text_style.font_size: 13} }
                            if gift_detail.state == "handled" { Label{text: "TA 已收下礼物" draw_text.color: muted draw_text.text_style.font_size: 13} }
                            if gift_detail.state == "expired" { Label{text: "礼物已过期退回" draw_text.color: muted draw_text.text_style.font_size: 13} }
                            if gift_detail.state == "withdrawn" { Label{text: "礼物已撤回" draw_text.color: muted draw_text.text_style.font_size: 13} }
                            if p != nil && p.physical && gift_detail.state == "handled" {
                                if gift_detail.carrier_delivered { Label{text: "物流  已送达" draw_text.color: muted draw_text.text_style.font_size: 13} }
                                else { Label{text: "物流  待送达" draw_text.color: muted draw_text.text_style.font_size: 13} }
                                if gift_detail.recipient_confirmed { Label{text: "收礼确认  已确认" draw_text.color: muted draw_text.text_style.font_size: 13} }
                                else { Label{text: "收礼确认  待确认" draw_text.color: muted draw_text.text_style.font_size: 13} }
                            }
                        }
                        if gift_detail.state == "sealed" { Secondary{width: Fill text: "撤回未打开的礼物" on_click: || gift_action("withdraw", {})} }
                    }
                    if gift_side == "inbox" {
                        Card{padding: 16 spacing: 12
                            if gift_detail.state == "sealed" || gift_detail.state == "opened" {
                                Label{text: "一份神秘礼物" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                            }
                            else {
                                let p = product_by_id(gift_detail.product_id)
                                if p != nil { Image{width: 88 height: 88 src: http_resource(product_image(p)) fit: ImageFit.CropToFill} }
                                if p != nil { Label{width: Fill text: p.name draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}} }
                            }
                            Label{text: state_name(gift_detail.state) draw_text.color: accent draw_text.text_style.font_size: 14}
                            Label{text: "有效期至  " + expiry_time(gift_detail.expires_at) draw_text.color: muted draw_text.text_style.font_size: 13}
                            if gift_detail.sender != nil { Label{text: "送礼人  " + gift_detail.sender.display_name draw_text.color: muted draw_text.text_style.font_size: 13} }
                            if gift_detail.state == "sealed" || gift_detail.state == "opened" {
                                if gift_detail.clue != "" { Label{width: Fill text: gift_detail.clue draw_text.color: muted draw_text.text_style.font_size: 13} }
                                if gift_detail.state == "sealed" { Primary{width: Fill text: "打开礼物" on_click: || gift_action("open", {})} }
                                if gift_detail.state == "opened" && gift_detail.unlock_kind != "free" {
                                    guess_entry := Entry{empty_text: "输入答案" text: guess on_change: |v| guess = v}
                                    Secondary{width: Fill text: "提交答案" on_click: || gift_action("answer", {answer: guess})}
                                }
                            }
                        }
                        if gift_detail.state == "revealed" || gift_detail.state == "accepted" || gift_detail.state == "exchanged" || gift_detail.state == "cashed_out" {
                            Card{padding: 16 spacing: 10
                                Label{text: "礼物信息" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                                Label{text: "礼物金额  " + money(gift_detail.price_cents) draw_text.color: muted draw_text.text_style.font_size: 13}
                                if gift_detail.message != "" { Label{width: Fill text: gift_detail.message draw_text.color: muted draw_text.text_style.font_size: 13} }
                                if gift_detail.contract_text != "" { Label{width: Fill text: "约定  " + gift_detail.contract_text draw_text.color: accent draw_text.text_style.font_size: 13} }
                                Label{text: "礼物编号  " + gift_detail.id draw_text.color: faint draw_text.text_style.font_size: 12}
                            }
                            if gift_detail.state == "revealed" {
                                Card{padding: 16 spacing: 10
                                    Label{text: "收下礼物" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                                    name_entry := Entry{empty_text: "收货人" text: recipient_name on_change: |v| recipient_name = v}
                                    phone_entry := Entry{empty_text: "电话" text: recipient_phone on_change: |v| recipient_phone = v}
                                    address_entry := Entry{empty_text: "地址" text: recipient_address on_change: |v| recipient_address = v}
                                    Primary{width: Fill text: "确认收下" on_click: || gift_action("accept", {agree: true, recipient_name: recipient_name, recipient_phone: recipient_phone, recipient_address: recipient_address})}
                                }
                            }
                        }
                    }
                }
            }
        }
        if tab == "pact" {
            ScrollYView{width: Fill height: Fill flow: Down padding: Inset{left: 16 right: 16 top: 10 bottom: 16} spacing: 14
                RoundedView{width: Fill height: Fit flow: Right padding: 4 spacing: 4 draw_bg +: {color: #x1f142c border_radius: 8.0}
                    if pact_side == "mine" { SegmentOn{text: "我答应的" on_click: || {pact_side = "mine"; refresh()}} } else { Segment{text: "我答应的" on_click: || {pact_side = "mine"; refresh()}} }
                    if pact_side == "theirs" { SegmentOn{text: "答应我的" on_click: || {pact_side = "theirs"; refresh()}} } else { Segment{text: "答应我的" on_click: || {pact_side = "theirs"; refresh()}} }
                }
                Card{padding: 6 spacing: 2
                    if pact_count(pact_side) == 0 {
                        View{width: Fill height: 106 flow: Down align: Align{x: 0.5 y: 0.5} spacing: 8
                            Image{width: 28 height: 28 src: http_resource(assets + "/assets/ui/nav-pact.png") fit: ImageFit.Stretch}
                            if pact_side == "mine" { Label{text: "还没有答应的约定" draw_text.color: faint draw_text.text_style.font_size: 13} }
                            else { Label{text: "还没有别人答应的约定" draw_text.color: faint draw_text.text_style.font_size: 13} }
                        }
                    }
                    for c in contracts { if (pact_side == "mine" && c.mine) || (pact_side == "theirs" && !c.mine) {
                        View{width: Fill height: 78 flow: Overlay
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: 8 spacing: 10
                                RoundedView{width: 44 height: 44 align: Align{x: 0.5 y: 0.5} draw_bg +: {color: #x352446 border_radius: 6.0} Label{text: "✓" draw_text.color: accent draw_text.text_style.font_size: 20}}
                                View{width: Fill height: Fit flow: Down spacing: 3
                                    Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: c.contract_text draw_text.color: ink draw_text.text_style.font_size: 15}
                                    Label{text: (if c.mine { "答应 " } else { "送给 " }) + c.peer_name + " · " + c.created_on draw_text.color: faint draw_text.text_style.font_size: 12}
                                }
                                Label{text: contract_state(c.status) draw_text.color: accent draw_text.text_style.font_size: 12}
                            }
                            RowHit{on_click: || {gift_side = if c.mine { "inbox" } else { "outbox" }; tab = "box"; choose_gift(c.gift_id)}}
                        }
                    } }
                }
                Label{width: Fill text: "约定是收礼时答应的一件小事。逾期无惩罚，完成了记得标记。" draw_text.color: faint draw_text.text_style.font_size: 12}
            }
        }
        if tab == "contacts" && stage == "browse" {
            ScrollYView{width: Fill height: Fill flow: Down padding: Inset{left: 16 right: 16 top: 10 bottom: 16} spacing: 14
                Card{padding: 16 spacing: 2
                    if friends.len() == 0 { Label{text: "暂无熟人" draw_text.color: faint} }
                    for i in friends.len() {
                        View{width: Fill height: 64 flow: Overlay
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} spacing: 10
                                RoundedView{width: 36 height: 36 align: Align{x: 0.5 y: 0.5} draw_bg +: {color: #x352446 border_radius: 18.0} Label{text: initial(friends[i].display_name) draw_text.color: accent draw_text.text_style.font_size: 17}}
                                View{width: Fill height: Fit flow: Down spacing: 2
                                    Label{text: friends[i].display_name draw_text.color: ink draw_text.text_style.font_size: 15}
                                    Label{text: "熟人" draw_text.color: faint draw_text.text_style.font_size: 12}
                                }
                                Label{text: "›" draw_text.color: faint draw_text.text_style.font_size: 21}
                            }
                            RowHit{on_click: || choose_contact(i)}
                        }
                    }
                }
            }
        }
        if tab == "contacts" && stage == "contact_detail" && contact_index >= 0 {
            let f = friends[contact_index]
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Card{padding: 16 spacing: 10
                    View{width: Fill height: Fit flow: Right align: Align{x: 0.0 y: 0.5} spacing: 12
                        RoundedView{width: 52 height: 52 align: Align{x: 0.5 y: 0.5} draw_bg +: {color: #x352446 border_radius: 26.0}
                            Label{text: initial(f.display_name) draw_text.color: accent draw_text.text_style.font_size: 24}
                        }
                        View{width: Fill height: Fit flow: Down spacing: 3
                            Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: f.display_name draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                            if f.phone != "" { Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: f.phone draw_text.color: muted draw_text.text_style.font_size: 12} }
                            if f.email != "" { Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: f.email draw_text.color: muted draw_text.text_style.font_size: 12} }
                        }
                    }
                    View{width: Fill height: Fit flow: Right spacing: 8
                        Primary{text: "神秘送礼" on_click: || {begin("gift", -1); draft_recipient_ids.push(friends[contact_index].id); refresh()}}
                        Secondary{text: "详细资料" on_click: || {stage = "contact_profile"; refresh()}}
                    }
                }
                if friend_wish_count(f.id) > 0 {
                    Card{padding: 6 spacing: 2
                        let preview_count = 0
                        for w in friend_wishes { if w.owner.id == f.id && preview_count < 3 {
                            let preview = preview_by_id(w.id)
                            View{width: Fill height: 140 flow: Overlay
                                View{width: Fill height: Fill flow: Down padding: 12 spacing: 7
                                    View{width: Fill height: Fit flow: Right align: Align{x: 0.0 y: 0.5} spacing: 8
                                        View{width: Fill height: Fit flow: Down spacing: 3
                                            Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: w.title draw_text.color: ink draw_text.text_style.font_size: 15}
                                            Label{text: w.event_on draw_text.color: faint draw_text.text_style.font_size: 12}
                                        }
                                        Label{text: "›" draw_text.color: faint draw_text.text_style.font_size: 21}
                                    }
                                    if preview != nil {
                                        View{width: Fill height: 44 flow: Right spacing: 6
                                            let thumb_count = 0
                                            for item in preview.items { if thumb_count < 4 {
                                                let p = product_for_item(item)
                                                if p != nil { Image{width: 44 height: 44 src: http_resource(product_image(p)) fit: ImageFit.CropToFill} }
                                                thumb_count = thumb_count + 1
                                            } }
                                        }
                                    }
                                }
                                RowHit{on_click: || contact_wish(w.id, "contact_detail")}
                            }
                            preview_count = preview_count + 1
                        } }
                    }
                }
                Card{padding: 6 spacing: 2
                    for row in [{id: "wishes", name: "心愿单"}, {id: "sent", name: "我送 TA 的礼物"}, {id: "received", name: "TA 送我的礼物"}] {
                        View{width: Fill height: 58 flow: Overlay
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: 12
                                Label{width: Fill text: row.name draw_text.color: ink draw_text.text_style.font_size: 15}
                                Label{text: "›" draw_text.color: faint draw_text.text_style.font_size: 21}
                            }
                            RowHit{on_click: || contact_section(row.id)}
                        }
                    }
                }
            }
        }
        if tab == "contacts" && stage == "contact_profile" && contact_index >= 0 {
            let f = friends[contact_index]
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Card{padding: 6 spacing: 2
                    Label{margin: Inset{left: 12 top: 8 bottom: 5} text: "基本资料" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 13}}
                    View{width: Fill height: 56 flow: Right align: Align{x: 0.0 y: 0.5} padding: 12
                        Label{width: Fill text: "账号姓名" draw_text.color: ink draw_text.text_style.font_size: 14}
                        Label{text: f.account_name draw_text.color: muted draw_text.text_style.font_size: 13}
                    }
                    for field in [{id: "nickname", name: "称呼"}, {id: "relationship", name: "关系"}, {id: "birthday", name: "生日"}] {
                        View{width: Fill height: 56 flow: Overlay
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: 12 spacing: 8
                                Label{width: Fill text: field.name draw_text.color: ink draw_text.text_style.font_size: 14}
                                Label{max_lines: 1 text_overflow: Ellipsis text: if friend_field(f, field.id) == "" {"添加"} else {friend_field(f, field.id)} draw_text.color: muted draw_text.text_style.font_size: 13}
                                Label{text: "›" draw_text.color: faint draw_text.text_style.font_size: 20}
                            }
                            RowHit{on_click: || edit_friend(field.id)}
                        }
                    }
                }
                Card{padding: 6 spacing: 2
                    Label{margin: Inset{left: 12 top: 8 bottom: 5} text: "联系方式" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 13}}
                    for field in [{id: "phone", name: "手机号"}, {id: "email", name: "邮箱"}] {
                        View{width: Fill height: 56 flow: Overlay
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: 12 spacing: 8
                                Label{width: Fill text: field.name draw_text.color: ink draw_text.text_style.font_size: 14}
                                Label{max_lines: 1 text_overflow: Ellipsis text: if friend_field(f, field.id) == "" {"添加"} else {friend_field(f, field.id)} draw_text.color: muted draw_text.text_style.font_size: 13}
                                Label{text: "›" draw_text.color: faint draw_text.text_style.font_size: 20}
                            }
                            RowHit{on_click: || edit_friend(field.id)}
                        }
                    }
                }
                Card{padding: 6 spacing: 2
                    Label{margin: Inset{left: 12 top: 8 bottom: 5} text: "私人备注" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 13}}
                    View{width: Fill height: 72 flow: Overlay
                        View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: 12 spacing: 8
                            Label{width: Fill max_lines: 2 text_overflow: Ellipsis text: if f.note == "" {"添加备注"} else {f.note} draw_text.color: muted draw_text.text_style.font_size: 13}
                            Label{text: "›" draw_text.color: faint draw_text.text_style.font_size: 20}
                        }
                        RowHit{on_click: || edit_friend("note")}
                    }
                }
                Label{width: Fill text: "这里修改的是你保存的熟人资料，不会改动 TA 的账号或已验证联系方式。" draw_text.color: faint draw_text.text_style.font_size: 12}
            }
        }
        if tab == "contacts" && stage == "contact_edit" && contact_index >= 0 {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Card{padding: 16 spacing: 12
                    Label{text: friend_field_name(friend_edit_field) draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}}
                    friend_edit_entry := Entry{text: friend_edit_value on_change: |v| friend_edit_value = v}
                    Label{width: Fill text: "仅保存在你的熟人资料中；清空后不显示。" draw_text.color: faint draw_text.text_style.font_size: 12}
                }
                Primary{width: Fill text: "保存" on_click: || save_friend()}
            }
        }
        if tab == "contacts" && stage == "contact_section" && contact_index >= 0 {
            let f = friends[contact_index]
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 12
                Card{padding: 6 spacing: 2
                    if contact_section_kind == "wishes" && friend_wish_count(f.id) == 0 { Label{margin: 14 text: "TA 还没有可见的心愿单" draw_text.color: faint} }
                    if contact_section_kind == "sent" && friend_gift_count(f.id, "sent") == 0 { Label{margin: 14 text: "还没有送给 TA 的礼物" draw_text.color: faint} }
                    if contact_section_kind == "received" && friend_gift_count(f.id, "received") == 0 { Label{margin: 14 text: "还没有可识别为 TA 送出的礼物" draw_text.color: faint} }
                    if contact_section_kind == "wishes" { for w in friend_wishes { if w.owner.id == f.id {
                        View{width: Fill height: 68 flow: Overlay
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: 12
                                View{width: Fill height: Fit flow: Down spacing: 3
                                    Label{text: w.title draw_text.color: ink draw_text.text_style.font_size: 15}
                                    Label{text: w.event_on + " · " + occasion_name(w.occasion) draw_text.color: faint draw_text.text_style.font_size: 12}
                                }
                                Label{text: "›" draw_text.color: faint draw_text.text_style.font_size: 21}
                            }
                            RowHit{on_click: || contact_wish(w.id, "contact_section")}
                        }
                    } } }
                    if contact_section_kind == "sent" { for g in outbox { if g.recipient.id == f.id {
                        View{width: Fill height: 68 flow: Overlay
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: 12 spacing: 10
                                let p = product_by_id(g.product_id)
                                if p != nil { Image{width: 44 height: 44 src: http_resource(product_image(p)) fit: ImageFit.CropToFill} }
                                View{width: Fill height: Fit flow: Down spacing: 3
                                    if p != nil { Label{text: p.name draw_text.color: ink draw_text.text_style.font_size: 15} }
                                    Label{text: state_name(g.state) draw_text.color: faint draw_text.text_style.font_size: 12}
                                }
                                Label{text: "›" draw_text.color: faint draw_text.text_style.font_size: 21}
                            }
                            RowHit{on_click: || contact_gift(g.id, "outbox")}
                        }
                    } } }
                    if contact_section_kind == "received" { for g in inbox { if g.sender != nil && g.sender.id == f.id {
                        View{width: Fill height: 68 flow: Overlay
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: 12 spacing: 10
                                let p = product_by_id(g.product_id)
                                if p != nil { Image{width: 44 height: 44 src: http_resource(product_image(p)) fit: ImageFit.CropToFill} }
                                View{width: Fill height: Fit flow: Down spacing: 3
                                    if p != nil { Label{text: p.name draw_text.color: ink draw_text.text_style.font_size: 15} }
                                    Label{text: state_name(g.state) draw_text.color: faint draw_text.text_style.font_size: 12}
                                }
                                Label{text: "›" draw_text.color: faint draw_text.text_style.font_size: 21}
                            }
                            RowHit{on_click: || contact_gift(g.id, "inbox")}
                        }
                    } } }
                }
            }
        }
        if tab == "wishes" && stage == "browse" {
            ScrollYView{width: Fill height: Fill flow: Down padding: Inset{left: 16 right: 16 top: 10 bottom: 16} spacing: 12
                if my_wishes.len() == 0 { Card{padding: 20 Label{text: "还没有发布心愿单" draw_text.color: faint}} }
                for w in my_wishes {
                    View{width: Fill height: Fit flow: Overlay
                        Card{padding: 14 spacing: 10
                            View{width: Fill height: Fit flow: Right spacing: 10 align: Align{x: 0.0 y: 0.5}
                                RoundedView{width: 36 height: 36 align: Align{x: 0.5 y: 0.5} draw_bg +: {color: #x352446 border_radius: 8.0} Label{text: initial(w.owner.display_name) draw_text.color: accent draw_text.text_style.font_size: 17}}
                                View{width: Fill height: Fit flow: Down spacing: 2
                                    Label{text: w.title draw_text.color: ink draw_text.text_style.font_size: 15}
                                    Label{text: w.event_on draw_text.color: faint draw_text.text_style.font_size: 12}
                                    Label{text: "有效期至 " + expiry_time(w.expires_at) draw_text.color: faint draw_text.text_style.font_size: 11}
                                }
                                Label{text: occasion_name(w.occasion) draw_text.color: accent draw_text.text_style.font_size: 11}
                            }
                            Label{width: Fill text: w.note draw_text.color: muted draw_text.text_style.font_size: 12.5}
                        }
                        RowHit{on_click: || choose_wish(w.id)}
                    }
                }
            }
        }
        if (tab == "wishes" && stage == "wish_detail") || (tab == "contacts" && stage == "contact_wish_detail") {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                if wish_detail == nil { Label{text: "正在读取心愿单…" draw_text.color: faint} }
                if wish_detail != nil {
                    Card{padding: 14 spacing: 10
                        View{width: Fill height: Fit flow: Right align: Align{x: 0.0 y: 0.5} spacing: 12
                            RoundedView{width: 44 height: 44 align: Align{x: 0.5 y: 0.5} draw_bg +: {color: #x352446 border_radius: 8.0} Label{text: initial(wish_detail.owner.display_name) draw_text.color: accent draw_text.text_style.font_size: 16}}
                            View{width: Fill height: Fit flow: Down spacing: 2
                                Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: wish_detail.title draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                                Label{text: wish_detail.owner.display_name + " · " + wish_detail.event_on draw_text.color: faint draw_text.text_style.font_size: 12}
                            }
                            Label{text: occasion_name(wish_detail.occasion) draw_text.color: accent draw_text.text_style.font_size: 12}
                        }
                        Label{width: Fill text: wish_detail.note draw_text.color: muted draw_text.text_style.font_size: 13}
                        Label{text: "有效期至 " + expiry_time(wish_detail.expires_at) draw_text.color: muted draw_text.text_style.font_size: 12}
                        Label{text: wish_detail.items.len() + " 件心愿 · 还有 " + open_wish_count(wish_detail) + " 件没人送" draw_text.color: muted draw_text.text_style.font_size: 12.5}
                        View{width: Fill height: 6 flow: Right spacing: 2
                            for item in wish_detail.items {
                                if item.status == "open" { RoundedView{width: Fill height: 6 draw_bg +: {color: #x3a2a58 border_radius: 3.0}} }
                                else { RoundedView{width: Fill height: 6 draw_bg +: {color: accent border_radius: 3.0}} }
                            }
                        }
                    }
                    Card{padding: 6 spacing: 2
                        for item in wish_detail.items {
                            let p = product_for_item(item)
                            View{width: Fill height: 72 flow: Right align: Align{x: 0.0 y: 0.5} padding: 8 spacing: 10
                                if p != nil { Image{width: 52 height: 52 src: http_resource(product_image(p)) fit: ImageFit.CropToFill} }
                                View{width: Fill height: Fit flow: Down spacing: 3
                                    if p != nil && item.product_id != nil { Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: p.name draw_text.color: ink draw_text.text_style.font_size: 14} }
                                    if p != nil && item.product_id == nil { Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: p.name + " · 大概" draw_text.color: ink draw_text.text_style.font_size: 14} }
                                    if p == nil { Label{text: item.kind draw_text.color: ink draw_text.text_style.font_size: 14} }
                                    Label{text: wish_state_name(item.status) draw_text.color: faint draw_text.text_style.font_size: 12}
                                }
                                if p != nil && account != nil && wish_detail.owner.id != account.id && item.status == "open" { Secondary{text: "送给TA" on_click: || gift_wish_item(item)} }
                            }
                        }
                    }
                    if account != nil && wish_detail.owner.id == account.id {
                        View{width: Fill height: Fit flow: Right{wrap: true} wrap_spacing: 8 spacing: 8
                            if wish_detail.is_open { Secondary{text: "编辑" on_click: || edit_wish()} }
                            if wish_detail.is_open { Secondary{text: "提前结束" on_click: || {stage = "wish_confirm_close"; refresh()}} }
                            Secondary{text: "删除" on_click: || {stage = "wish_confirm_delete"; refresh()}}
                        }
                    }
                }
            }
        }
        if tab == "wishes" && stage == "wish_edit" {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Label{text: "心愿单名称" draw_text.color: muted draw_text.text_style.font_size: 13}
                wish_edit_title := Entry{text: edit_title on_change: |v| edit_title = v}
                Label{text: "日子" draw_text.color: muted draw_text.text_style.font_size: 13}
                wish_edit_date := Entry{text: edit_date on_change: |v| edit_date = v}
                Label{text: "说明" draw_text.color: muted draw_text.text_style.font_size: 13}
                wish_edit_note := Entry{text: edit_note on_change: |v| edit_note = v}
                Label{text: "有效期至 " + expiry_time(wish_detail.expires_at) draw_text.color: muted draw_text.text_style.font_size: 13}
                wish_edit_expiry := Entry{empty_text: "重新设置有效期（小时，留空则不变）" text: edit_expiry_hours on_change: |v| edit_expiry_hours = v}
                Label{text: "可设置 1–720 小时（最多 30 天）。" draw_text.color: faint draw_text.text_style.font_size: 12}
                Primary{width: Fill text: "保存修改" on_click: || save_wish_edit()}
            }
        }
        if tab == "wishes" && stage == "wish_confirm_close" {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Card{padding: 16 spacing: 10
                    Label{text: "提前结束这份心愿单？" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                    Label{width: Fill text: "结束后熟人不能再认领其中的礼物。" draw_text.color: muted draw_text.text_style.font_size: 13}
                }
                Primary{width: Fill text: "确认提前结束" on_click: || confirm_wish_action("close")}
                Secondary{width: Fill text: "取消" on_click: || {stage = "wish_detail"; refresh()}}
            }
        }
        if tab == "wishes" && stage == "wish_confirm_delete" {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Card{padding: 16 spacing: 10
                    Label{text: "删除这份心愿单？" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                    Label{width: Fill text: "此操作会从测试服务器移除心愿单。" draw_text.color: muted draw_text.text_style.font_size: 13}
                }
                Primary{width: Fill text: "确认删除" on_click: || confirm_wish_action("delete")}
                Secondary{width: Fill text: "取消" on_click: || {stage = "wish_detail"; refresh()}}
            }
        }
        if tab == "me" && stage == "browse" {
            ScrollYView{width: Fill height: Fill flow: Down padding: Inset{left: 16 right: 16 top: 10 bottom: 16} spacing: 14
                Card{padding: 16 spacing: 8
                    if account == nil { Label{text: "正在读取账户…" draw_text.color: faint} }
                    if account != nil { Label{text: account.display_name draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}} }
                    Label{text: "账号与设置" draw_text.color: faint draw_text.text_style.font_size: 13}
                }
                View{width: Fill height: Fit flow: Right spacing: 10
                    Card{width: Fill padding: 12 spacing: 2 Label{text: outbox.len() + "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}} Label{text: "送出" draw_text.color: faint draw_text.text_style.font_size: 12}}
                    Card{width: Fill padding: 12 spacing: 2 Label{text: inbox.len() + "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}} Label{text: "收到" draw_text.color: faint draw_text.text_style.font_size: 12}}
                    Card{width: Fill padding: 12 spacing: 2 Label{text: fulfilled_count() + "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}} Label{text: "兑现的约定" draw_text.color: faint draw_text.text_style.font_size: 12}}
                }
                Card{padding: 6 spacing: 0
                    for i in 5 {
                        View{width: Fill height: 52 flow: Overlay
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: 12
                                if i == 0 { Label{width: Fill text: "个人资料" draw_text.color: ink draw_text.text_style.font_size: 14} }
                                if i == 1 { Label{width: Fill text: "我的心愿单" draw_text.color: ink draw_text.text_style.font_size: 14} }
                                if i == 2 { Label{width: Fill text: "钱包与流水" draw_text.color: ink draw_text.text_style.font_size: 14} }
                                if i == 3 { Label{width: Fill text: "设置" draw_text.color: ink draw_text.text_style.font_size: 14} }
                                if i == 4 { Label{width: Fill text: "关于礼遇" draw_text.color: ink draw_text.text_style.font_size: 14} }
                                Label{text: "›" draw_text.color: faint draw_text.text_style.font_size: 21}
                            }
                            RowHit{on_click: || {if i == 0 {stage = "profile"; refresh()}; if i == 1 {go("wishes")}; if i == 2 {stage = "wallet"; refresh()}; if i == 3 {stage = "settings"; refresh()}; if i == 4 {stage = "about"; refresh()}}}
                        }
                    }
                }
            }
        }
        if tab == "me" && stage == "profile" {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Label{text: "基本资料" draw_text.color: muted draw_text.text_style: theme.font_bold{font_size: 13}}
                Card{padding: 14 spacing: 10
                    Label{text: "显示名" draw_text.color: faint draw_text.text_style.font_size: 13}
                    if profile != nil { Label{text: profile.display_name draw_text.color: ink draw_text.text_style.font_size: 15} }
                    Label{text: "头像" draw_text.color: faint draw_text.text_style.font_size: 13}
                    if profile != nil { Image{width: 64 height: 64 src: http_resource("https://liyu.localhost:8443" + profile.avatar_url) fit: ImageFit.CropToFill} }
                }
                Card{padding: 6 spacing: 2
                    View{width: Fill height: 56 flow: Right align: Align{x: 0.0 y: 0.5} padding: 10
                        Label{width: Fill text: "手机号" draw_text.color: ink draw_text.text_style.font_size: 14}
                        if profile != nil && profile.phone != nil { Label{text: profile.phone draw_text.color: muted draw_text.text_style.font_size: 12} }
                        else { Label{text: "未绑定" draw_text.color: faint draw_text.text_style.font_size: 12} }
                    }
                    View{width: Fill height: 56 flow: Right align: Align{x: 0.0 y: 0.5} padding: 10
                        Label{width: Fill text: "邮箱" draw_text.color: ink draw_text.text_style.font_size: 14}
                        if profile != nil && profile.email != nil { Label{text: profile.email draw_text.color: muted draw_text.text_style.font_size: 12} }
                        else { Label{text: "未绑定" draw_text.color: faint draw_text.text_style.font_size: 12} }
                    }
                }
                Label{text: "收货地址" draw_text.color: muted draw_text.text_style: theme.font_bold{font_size: 13}}
                Card{padding: 14 spacing: 10
                    if addresses.len() == 0 { Label{text: "还没有保存地址" draw_text.color: faint draw_text.text_style.font_size: 13} }
                    for a in addresses { Label{width: Fill text: a.recipient_name + " · " + a.phone + " · " + a.address draw_text.color: muted draw_text.text_style.font_size: 13} }
                }
            }
        }
        if tab == "me" && stage == "wallet" {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Card{padding: 16 spacing: 8
                    Label{text: "礼遇余额" draw_text.color: muted draw_text.text_style.font_size: 13}
                    if wallet != nil { Label{text: money(wallet.balance_cents) draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 26}} }
                    Label{width: Fill text: "只在礼遇内使用 · 折现、换购退差都进这里" draw_text.color: faint draw_text.text_style.font_size: 12}
                }
                Label{text: "流水" draw_text.color: muted draw_text.text_style: theme.font_bold{font_size: 13}}
                Card{padding: 14 spacing: 8
                    if wallet != nil && wallet.ledger.len() == 0 { Label{text: "暂无流水" draw_text.color: faint draw_text.text_style.font_size: 13} }
                }
            }
        }
        if tab == "me" && stage == "settings" {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Label{text: "外观" draw_text.color: muted draw_text.text_style: theme.font_bold{font_size: 13}}
                Card{padding: 14 spacing: 10
                    RoundedView{width: Fill height: Fit flow: Right padding: 4 spacing: 4 draw_bg +: {color: #x1f142c border_radius: 8.0}
                        SegmentOn{text: "深色"}
                        Segment{text: "浅色"}
                    }
                }
                Label{text: "数据" draw_text.color: muted draw_text.text_style: theme.font_bold{font_size: 13}}
                Card{padding: 14 spacing: 8
                    Label{width: Fill text: status draw_text.color: muted draw_text.text_style.font_size: 13}
                    Secondary{text: "刷新服务端数据" on_click: || load_all()}
                    Secondary{text: "退出登录" on_click: || logout()}
                }
            }
        }
        if tab == "me" && stage == "about" {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Card{padding: 16 spacing: 10
                    Label{text: "礼遇 LIYU-MINI" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                    Label{width: Fill text: "使用 OctoScript / Splash 呈现的 LIYU 简化版本。商品、熟人、心愿单与礼物均来自本地 liyu-server。" draw_text.color: muted draw_text.text_style.font_size: 13}
                }
                Secondary{text: "一句话开始" on_click: || go("command")}
            }
        }
        if tab == "command" && stage == "browse" {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Card{padding: 16 spacing: 10
                    Label{text: "用一句话开始" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                    Label{width: Fill text: "从真实商品和熟人生成待确认的礼卡或心愿单。" draw_text.color: muted draw_text.text_style.font_size: 13}
                    command_entry := Entry{empty_text: "例如：送林舟一份咖啡" text: draft_command on_change: |v| draft_command = v}
                    Primary{text: "生成待确认卡片" on_click: || parse_command()}
                }
                Secondary{text: "发布心愿单" on_click: || begin("wish", -1)}
                Secondary{text: "神秘送礼" on_click: || begin("gift", -1)}
            }
        }
        if tab == "command" && stage == "draft" && draft_kind == "wish" {
            View{width: Fill height: Fill flow: Down
            wish_draft_scroll := ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Label{text: "1 · 什么日子" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                View{width: Fill height: Fit flow: Right{wrap: true} wrap_spacing: 8 spacing: 8
                    for o in [{id: "birthday", name: "生日"}, {id: "wedding", name: "结婚"}, {id: "housewarming", name: "乔迁"}, {id: "graduation", name: "毕业"}, {id: "baby", name: "宝宝"}, {id: "other", name: "其他"}] {
                        if draft_occasion == o.id { ChipOn{text: o.name on_click: || {draft_occasion = o.id; refresh()}} }
                        else { Chip{text: o.name on_click: || {draft_occasion = o.id; refresh()}} }
                    }
                }
                date_entry := Entry{empty_text: "YYYY-MM-DD" text: draft_date on_change: |v| draft_date = v}
                Label{text: "心愿单有效期" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                wish_expiry_entry := Entry{empty_text: "有效小时数" text: draft_expiry_hours on_change: |v| draft_expiry_hours = v}
                Label{text: "默认 24 小时；可设置 1–720 小时（最多 30 天）。" draw_text.color: faint draw_text.text_style.font_size: 12}
                Label{text: "2 · 说说这份心愿" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                title_entry := Entry{empty_text: "心愿单名称" text: draft_title on_change: |v| draft_title = v}
                note_entry := Entry{empty_text: "写一点心愿说明" text: draft_note on_change: |v| draft_note = v}
                Label{text: "3 · 想要什么" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                Card{padding: 14 spacing: 10
                    if draft_item_mode == "exact" && draft_product >= 0 {
                        View{width: Fill height: Fit flow: Right spacing: 10
                            Image{width: 52 height: 52 src: http_resource(product_image(products[draft_product])) fit: ImageFit.CropToFill}
                            View{width: Fill height: Fit flow: Down spacing: 3
                                Label{text: products[draft_product].name draw_text.color: ink draw_text.text_style.font_size: 14}
                                Label{text: money(products[draft_product].price_cents) draw_text.color: accent draw_text.text_style.font_size: 13}
                            }
                        }
                        Secondary{text: "换一件" on_click: || {draft_product = -1; show_all_products = false; refresh()}}
                    }
                    if draft_item_mode == "exact" && draft_product < 0 {
                        Label{text: "还没有放进心愿的礼物" draw_text.color: faint draw_text.text_style.font_size: 13}
                        Secondary{text: "挑一件具体的" on_click: || {show_all_products = true; refresh()}}
                    }
                    if draft_item_mode == "vague" {
                        Label{text: "说个大概 · " + draft_vague_kind draw_text.color: muted draw_text.text_style.font_size: 13}
                        Secondary{text: "改挑具体商品" on_click: || {draft_item_mode = "exact"; refresh()}}
                    }
                    if draft_item_mode == "exact" { Secondary{text: "说个大概" on_click: || {draft_item_mode = "vague"; show_all_products = false; refresh()}} }
                }
                if draft_item_mode == "exact" && show_all_products { Card{padding: 10 spacing: 5
                    for i in products.len() { Secondary{width: Fill text: products[i].name + " · " + money(products[i].price_cents) on_click: || {draft_product = i; show_all_products = false; refresh()}} }
                } }
                if draft_item_mode == "vague" {
                    Label{text: "想要哪一类" draw_text.color: muted draw_text.text_style.font_size: 13}
                    View{width: Fill height: Fit flow: Right{wrap: true} wrap_spacing: 8 spacing: 8
                        for kind in ["咖啡", "电影", "甜点", "鲜花", "数码", "家居", "盲盒", "玩具"] {
                            if draft_vague_kind == kind { ChipOn{text: kind on_click: || {draft_vague_kind = kind; refresh()}} }
                            else { Chip{text: kind on_click: || {draft_vague_kind = kind; refresh()}} }
                        }
                    }
                    Label{text: "预算" draw_text.color: muted draw_text.text_style.font_size: 13}
                    View{width: Fill height: Fit flow: Right{wrap: true} wrap_spacing: 8 spacing: 8
                        for budget in [{cents: 0, name: "不限"}, {cents: 10000, name: "¥100 以内"}, {cents: 30000, name: "¥300 以内"}, {cents: 50000, name: "¥500 以内"}, {cents: 100000, name: "¥1000 以内"}] {
                            if draft_budget_cents == budget.cents { ChipOn{text: budget.name on_click: || {draft_budget_cents = budget.cents; refresh()}} }
                            else { Chip{text: budget.name on_click: || {draft_budget_cents = budget.cents; refresh()}} }
                        }
                    }
                }
                wants_entry := Entry{empty_text: "有什么要求（可不写）" text: draft_wants on_change: |v| draft_wants = v}
                Label{text: "4 · 给谁看" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                View{width: Fill height: Fit flow: Right{wrap: true} wrap_spacing: 8 spacing: 8
                    if draft_audience < 0 { ChipOn{text: "所有熟人" on_click: || {draft_audience = -1; refresh()}} } else { Chip{text: "所有熟人" on_click: || {draft_audience = -1; refresh()}} }
                    for i in friends.len() {
                        if draft_audience == i { ChipOn{text: friends[i].display_name on_click: || {draft_audience = i; refresh()}} }
                        else { Chip{text: friends[i].display_name on_click: || {draft_audience = i; refresh()}} }
                    }
                }
            }
            View{width: Fill height: Fit padding: Inset{left: 16 right: 16 top: 8 bottom: 8} draw_bg.color: #x191021
                Primary{width: Fill text: "发布心愿单" on_click: || create_wish()}
            }
            }
        }
        if tab == "command" && stage == "draft" && draft_kind == "gift" {
            View{width: Fill height: Fill flow: Down
            gift_draft_scroll := ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Card{padding: 14 spacing: 10
                    View{width: Fill height: Fit flow: Right
                        Label{width: Fill text: "已选礼物" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                        Secondary{text: "换一件" on_click: || {draft_product = -1; show_all_products = true; quote = nil; refresh()}}
                    }
                    if draft_product >= 0 {
                        View{width: Fill height: Fit flow: Right spacing: 10
                            Image{width: 56 height: 56 src: http_resource(product_image(products[draft_product])) fit: ImageFit.CropToFill}
                            View{width: Fill height: Fit flow: Down spacing: 3
                                Label{text: products[draft_product].name draw_text.color: ink draw_text.text_style.font_size: 14}
                                Label{text: products[draft_product].spec draw_text.color: faint draw_text.text_style.font_size: 12}
                                Label{text: money(products[draft_product].price_cents) draw_text.color: accent draw_text.text_style.font_size: 14}
                            }
                        }
                    }
                    if draft_product < 0 { Secondary{text: "从礼物目录挑选" on_click: || {show_all_products = true; refresh()}} }
                }
                if show_all_products { Card{padding: 10 spacing: 5
                    for i in products.len() { Secondary{width: Fill text: products[i].name + " · " + money(products[i].price_cents) on_click: || {draft_product = i; show_all_products = false; quote = nil; refresh()}} }
                } }
                Label{text: "送给谁（仅自己可见）" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                View{width: Fill height: Fit flow: Right{wrap: true} wrap_spacing: 8 spacing: 8
                    for id in draft_recipient_ids {
                        View{width: 184 height: 56 flow: Overlay
                            RoundedView{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 38 right: 8} spacing: 7 draw_bg +: {color: #x211530 border_color: #x3a294f border_size: 1.0 border_radius: 8.0}
                                RoundedView{width: 32 height: 32 align: Align{x: 0.5 y: 0.5} draw_bg +: {color: #x352446 border_radius: 16.0}
                                    Label{text: initial(recipient_name(id)) draw_text.color: accent draw_text.text_style.font_size: 15}
                                }
                                Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: recipient_name(id) draw_text.color: ink draw_text.text_style.font_size: 14}
                            }
                            View{width: Fill height: Fill flow: Down padding: Inset{left: 5 top: 5}
                                RemoveHit{on_click: || remove_recipient(id)}
                            }
                        }
                    }
                    Secondary{width: 184 height: 56 text: "+ TA" on_click: || {
                        if friends.len() == 0 { notice = "还没有可选的熟人。"; get("/friends", "friends"); refresh() }
                        else { stage = "recipient"; refresh() }
                    }}
                }
                Label{text: "礼物有效期" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                gift_expiry_entry := Entry{empty_text: "有效小时数" text: draft_expiry_hours on_change: |v| {draft_expiry_hours = v; quote = nil}}
                Label{text: "默认 24 小时；可设置 1–720 小时（最多 30 天）。" draw_text.color: faint draw_text.text_style.font_size: 12}
                Label{text: "怎么解开礼卡" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                RoundedView{width: Fill height: Fit flow: Right{wrap: true} wrap_spacing: 4 spacing: 4 padding: 4 draw_bg +: {color: #x1f142c border_radius: 8.0}
                    for mode in [{id: "guess_who", name: "猜我是谁"}, {id: "question", name: "私密问答"}, {id: "passphrase", name: "专属暗号"}, {id: "free", name: "直接领取"}] {
                        if draft_unlock == mode.id { ChipOn{text: mode.name on_click: || {draft_unlock = mode.id; draft_error = ""; refresh()}} }
                        else { Chip{text: mode.name on_click: || {draft_unlock = mode.id; draft_error = ""; refresh()}} }
                    }
                }
                if draft_unlock != "free" {
                    clue_entry := Entry{empty_text: "题目或暗号提示" text: draft_clue on_change: |v| draft_clue = v}
                    answer_entry := Entry{empty_text: "答案" text: draft_answer on_change: |v| draft_answer = v}
                    Label{text: "答案必填，最多 20 字；题目或提示最多 30 字。" draw_text.color: faint draw_text.text_style.font_size: 12}
                }
                Label{text: "附个约定（可不填）" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                if contract_templates.len() > 0 {
                    View{width: Fill height: Fit flow: Right{wrap: true} wrap_spacing: 6 spacing: 6
                        for template in contract_templates {
                            if draft_contract == template.body { ChipOn{text: template.label on_click: || {draft_contract = template.body; refresh()}} }
                            else { Chip{text: template.label on_click: || {draft_contract = template.body; refresh()}} }
                        }
                    }
                }
                contract_entry := Entry{empty_text: "答应我一件小事" text: draft_contract on_change: |v| draft_contract = v}
                Label{text: "想说的话（可不填）" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                message_entry := Entry{empty_text: "写在礼卡上的寄语" text: draft_message on_change: |v| draft_message = v}
            }
            View{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 top: 8 bottom: 8} spacing: 6 draw_bg.color: #x191021
                if draft_error != "" { Label{width: Fill text: draft_error draw_text.color: accent draw_text.text_style.font_size: 12} }
                Primary{width: Fill text: "去结算" on_click: || quote_gift()}
            }
            }
        }
        if tab == "command" && stage == "recipient" {
            View{width: Fill height: Fill flow: Down
            recipient_scroll := ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 12
                Label{text: "选择送给谁" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                Label{text: "已选 " + draft_recipient_ids.len() + " 位，点选熟人后添加到礼卡。" draw_text.color: faint draw_text.text_style.font_size: 12}
                View{width: Fill height: Fit flow: Right{wrap: true} wrap_spacing: 8 spacing: 8
                    for i in friends.len() { if !recipient_selected(friends[i].id) {
                        View{width: 184 height: 56 flow: Overlay
                            RoundedView{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: 10 spacing: 8 draw_bg +: {color: #x211530 border_color: #x3a294f border_size: 1.0 border_radius: 8.0}
                                RoundedView{width: 38 height: 38 align: Align{x: 0.5 y: 0.5} draw_bg +: {color: #x352446 border_radius: 19.0}
                                    Label{text: initial(friends[i].display_name) draw_text.color: accent draw_text.text_style.font_size: 17}
                                }
                                Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: friends[i].display_name draw_text.color: ink draw_text.text_style.font_size: 14}
                            }
                            RowHit{on_click: || choose_recipient(i)}
                        }
                    } }
                }
            }
            }
        }
        if tab == "command" && stage == "checkout" {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Card{padding: 16 spacing: 10
                    Label{text: "确认礼物" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                    if draft_product >= 0 { Label{text: products[draft_product].name draw_text.color: ink} }
                    Label{text: "送给 " + draft_recipient_ids.len() + " 位熟人" draw_text.color: muted}
                    Label{text: "有效期  " + draft_expiry_hours + " 小时（测试支付后开始）" draw_text.color: muted draw_text.text_style.font_size: 13}
                    for id in draft_recipient_ids { Label{text: recipient_name(id) draw_text.color: muted draw_text.text_style.font_size: 13} }
                    Label{text: "解开方式  " + unlock_name(draft_unlock) draw_text.color: muted draw_text.text_style.font_size: 13}
                    if draft_unlock != "free" {
                        if draft_clue.trim() != "" { Label{width: Fill text: "题目或提示  " + draft_clue.trim() draw_text.color: muted draw_text.text_style.font_size: 13} }
                        Label{text: "答案已填写" draw_text.color: muted draw_text.text_style.font_size: 13}
                    }
                    if quote != nil { Label{text: "应付  " + money(quote.total_cents) draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 24}} }
                    Label{width: Fill text: "本地测试结算会在 liyu-server 生成真实测试订单。" draw_text.color: faint draw_text.text_style.font_size: 12}
                }
                Primary{width: Fill text: "确认并测试支付" on_click: || create_order()}
                Secondary{width: Fill text: "返回修改礼卡" on_click: || {stage = "draft"; refresh()}}
            }
        }
    }
    if !desktop_mode { View{width: Fill height: 66 flow: Right padding: Inset{left: 5 right: 5 top: 5 bottom: 5} spacing: 2 draw_bg.color: #x1c1228
        for nav in [{id: "discover", name: "挑礼", icon: "gift"}, {id: "box", name: "礼盒", icon: "box"}, {id: "pact", name: "约定", icon: "pact"}, {id: "contacts", name: "熟人", icon: "contacts"}, {id: "me", name: "我", icon: "me"}] {
            View{width: Fill height: Fill flow: Overlay
                View{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 0.5} spacing: 2
                    if tab == nav.id { Image{width: 21 height: 21 src: http_resource(assets + "/assets/ui/nav-" + nav.icon + "-on.png") fit: ImageFit.Stretch} }
                    else { Image{width: 21 height: 21 src: http_resource(assets + "/assets/ui/nav-" + nav.icon + ".png") fit: ImageFit.Stretch} }
                    if tab == nav.id { Label{text: nav.name draw_text.color: accent draw_text.text_style.font_size: 11.5} }
                    else { Label{text: nav.name draw_text.color: muted draw_text.text_style.font_size: 11.5} }
                }
                NavHit{on_click: || go(nav.id)}
            }
        }
    } }
    }
    if desktop_mode && tab != "me" {
        ScrollYView{width: 300 height: Fill flow: Down padding: Inset{left: 0 right: 20 top: 20 bottom: 20} spacing: 14
            if tab == "discover" || tab == "command" {
                Card{padding: 16 spacing: 8
                    Label{text: "怎么玩" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}}
                    Label{width: Fill text: "1 挑一件小礼物\n2 出一道只有 TA 答得上的题，可附一个约定\n3 把礼卡发给 TA，等 TA 来拆" draw_text.color: muted draw_text.text_style.font_size: 13}
                }
                Card{padding: 16 spacing: 8
                    Label{text: "心愿单" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}}
                    Label{width: Fill text: "生日、乔迁、毕业……列出想要的礼物，让熟人知道送什么。" draw_text.color: muted draw_text.text_style.font_size: 13}
                    Secondary{text: "我的心愿单" on_click: || go("wishes")}
                }
            }
            if tab == "box" { Card{padding: 16 spacing: 8
                Label{text: "礼盒一览" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}}
                Label{text: "收到 " + inbox.len() + " 份 · 送出 " + outbox.len() + " 份" draw_text.color: muted draw_text.text_style.font_size: 13}
            } }
            if tab == "pact" { Card{padding: 16 spacing: 8
                Label{text: "关于约定" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}}
                Label{width: Fill text: "只写轻约定，不涉及钱；兑现了记得标记。" draw_text.color: muted draw_text.text_style.font_size: 13}
            } }
            if tab == "contacts" { Card{padding: 16 spacing: 8
                Label{text: "熟人" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}}
                Label{text: friends.len() + " 位熟人" draw_text.color: muted draw_text.text_style.font_size: 13}
            } }
        }
    }
    }}}
}
