            if tab == "command" && stage == "draft" && draft_kind == "gift" { Label{text: "神秘送礼" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "command" && stage == "recipient" { Label{text: "选择熟人" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "command" && stage == "checkout" { Label{text: "确认订单" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
