fn refresh(){ ui.content.render() }
fn pad2(n){ if n < 10 { return "0" + n } return "" + n }
fn today(){ let t = local_time(time_now() + 8 * 3600); return "" + t.year + "-" + pad2(t.month) + "-" + pad2(t.day) }
fn expiry_time(epoch){ let t = local_time(epoch + 8 * 3600); return "" + t.year + "-" + pad2(t.month) + "-" + pad2(t.day) + " " + pad2(t.hour) + ":" + pad2(t.minute) }
fn expiry_short(epoch){ let t = local_time(epoch + 8 * 3600); return "" + t.month + "/" + t.day + " " + pad2(t.hour) + ":" + pad2(t.minute) }
fn expiry_hours(){ let s = draft_expiry_hours.trim(); if !regex("^[0-9]+$", "").test(s) { return -1 }; let n = s.to_f64(); if n < 1 || n > 720 { return -1 }; return floor(n) }
fn money(cents){ if cents % 100 == 0 { return "¥" + floor(cents / 100) } return "¥" + floor(cents / 100) + "." + pad2(cents % 100) }
fn wallet_kind_name(entry){
    if entry.kind == "cash_out" { return "礼物卖出" }
    if entry.kind == "exchange" { if entry.amount_cents < 0 { return "换购补差" }; return "换购退差" }
    if entry.kind == "withdraw" { return "礼盒撤回退款" }
    if entry.kind == "expired" { return "礼盒到期退款" }
    return "钱包变动"
}
fn wallet_amount(cents){ if cents < 0 { return "−" + money(0 - cents) }; return "+" + money(cents) }
fn product_by_id(id){ for p in products { if p.id == id { return p } } return nil }
fn gift_product(g){ if g.product != nil { return g.product }; return product_by_id(g.product_id) }
fn product_for_item(item){
    if item.product_id != nil { return product_by_id(item.product_id) }
    for p in products { if p.kind == item.kind && (item.max_price_cents == 0 || p.price_cents <= item.max_price_cents) { return p } }
    for p in products { if p.name.search(item.kind) >= 0 && (item.max_price_cents == 0 || p.price_cents <= item.max_price_cents) { return p } }
    return nil
}
fn open_wish_count(w){ let n = 0; for item in w.items { if item.status == "open" { n = n + 1 } } return n }
fn wish_state_name(state){ if state == "open" { return "还没人送" }; if state == "by_me" { return "由我送出" }; return "已有人送" }
fn product_image(p){ if demo_mode { return assets + p.demo_image }; return service_origin + p.image_detail_url }
fn profile_image(){ if demo_mode { return assets + demo_data.user.avatar_url }; return service_origin + profile.avatar_url }
fn category_name(id){ for c in categories { if c.id == id { return c.name } } return id }
fn product_meta(p){
    let result = category_name(p.category) + " · " + p.brand
    for tag in p.tags { result = result + " · " + tag }
    return result
}
fn initial(name){ let parts = name.split(""); if parts.len() > 1 { return parts[1] } return "?" }
fn preview_by_id(id){ for w in wish_previews { if w.id == id { return w } } return nil }
fn occasion_name(kind){
    if kind == "birthday" { return "生日" }
    if kind == "wedding" { return "结婚" }
    if kind == "housewarming" { return "乔迁" }
    if kind == "graduation" { return "毕业" }
    if kind == "baby" { return "宝宝" }
    return "其他"
}
fn visible_product(p){
    if category_index > 0 && p.category != categories[category_index].id { return false }
    let q = product_search.trim()
    return q == "" || p.name.search(q) >= 0 || p.kind.search(q) >= 0 || p.description.search(q) >= 0
}
fn gift_is_unwrapped(g){
    if g == nil { return false }
    return g.state == "revealed" || g.state == "accepted" || g.state == "exchanged" || g.state == "cashed_out" || g.state == "transferred" || g.state == "forwarded"
}
fn state_name(s){
    if s == "sealed" { return "待打开" }
    if s == "revealed" { return "待选择" }
    if s == "transferred" { return "转赠中" }
    if s == "forwarded" { return "已转赠" }
    if s == "cashed_out" { return "已回收" }
    if s == "exchanged" { return "已兑换" }
    if s == "accepted" || s == "handled" { return "已收下" }
    if s == "opened" { return "解谜中" }
    if s == "withdrawn" { return "已撤回" }
    if s == "expired" { return "过期退回" }
    return s
}
fn pact_count(side){ let n = 0; for c in contracts { if (side == "mine" && c.mine) || (side == "theirs" && !c.mine) { n = n + 1 } } return n }
fn contract_state(status){ if status == "fulfilled" { return "已兑现" }; return "待兑现" }
fn open_contract_status(id, text, status, side){
    contract_edit_id = id; contract_edit_text = text; contract_edit_status = status; contract_edit_side = side
    contract_origin_tab = tab; contract_origin_stage = stage
    stage = "contract_status"; notice = ""; refresh()
}
fn toggle_contract(id, status){
    if contract_busy_id >= 0 || auth_state != "signed_in" { return }
    let next = if status == "fulfilled" {"pending"} else {"fulfilled"}
    contract_busy_id = id; notice = ""; refresh()
    let generation = auth_generation
    api_request({method: "PUT", path: "/contracts/" + id + "/status", body: {status: next}}, fn(r){
        if generation != auth_generation { return }
        contract_busy_id = -1
        if !r.is_ok { notice = r.error; refresh(); return }
        if r.data.status == 401 { auth_lost("登录已过期，请重新登录。"); return }
        if r.data.status < 200 || r.data.status >= 300 { notice = "约定状态保存失败，请稍后重试。"; refresh(); return }
        let data = r.data.body
        for c in contracts { if c.gift_id == id { c.status = data.status } }
        if gift_detail != nil && gift_detail.id == id { gift_detail.contract_status = data.status }
        if contract_edit_id == id { contract_edit_status = data.status }
        notice = "状态已改为“" + contract_state(data.status) + "”。"; get("/contracts", "contracts"); refresh()
    })
}
fn clear_account_data(){
    auth_generation = auth_generation + 1
    products = []; categories = [{id: "", name: "全部"}]; friends = []; friend_tags = []
    my_wishes = []; friend_wishes = []; inbox = []; outbox = []; contracts = []; contract_templates = []; reminders = []
    draft_recipient_ids = []; gift_replacing_product = false; contract_busy_id = -1
    wish_detail_id = -1; wish_busy = false; wish_lists_loading = true; wish_picker_product = -1
    wish_picker_origin_tab = ""; wish_picker_origin_stage = ""; wish_new_from_picker = false
    wish_new_origin_tab = ""; wish_new_origin_stage = ""; wish_detail_origin_tab = ""; wish_detail_origin_stage = ""
    wish_new_title = ""; wish_new_note = ""; wish_shop_id = -1; wish_shop_title = ""; wish_publish_mode = false
    contract_edit_id = -1; contract_edit_text = ""; contract_edit_status = nil; contract_origin_tab = ""; contract_origin_stage = ""
    account = nil; profile = nil; wallet = nil; addresses = []; wish_previews = []
    profile_edit_value = ""; profile_busy = false; address_edit_id = -1
    address_edit_name = ""; address_edit_phone = ""; address_edit_text = ""; address_edit_default = false
    wish_detail = nil; gift_detail = nil; gift_detail_id = -1; gift_detail_error = ""; quote = nil; ai_text = ""; ai_busy = false; ai_context = ai_context + 1
    tab = "discover"; stage = "browse"; notice = ""; contact_index = -1; contact_id = -1; gift_from_contact = false; gift_from_pact = false
    box_origin_tab = ""; wishes_origin_tab = ""; wish_detail_from_discover = false; command_origin_tab = ""; command_browse_origin_tab = ""; shop_origin_contact_id = -1
    contact_search = ""; tag_search = ""; tag_people_search = ""; tag_selected_id = -1; contact_detail_origin_stage = "browse"
}
fn auth_lost(message){ session_token = ""; fs.write("session.json", {token: ""}.to_json()); clear_account_data(); auth_state = "signed_out"; auth_message = message; refresh() }
fn auth_ready(){ clear_account_data(); auth_state = "signed_in"; auth_message = ""; refresh(); load_all() }
fn enter_demo(){
    if account_busy { return }
    auth_flow_generation = auth_flow_generation + 1
    clear_account_data(); demo_mode = true; demo_data = demo_seed()
    for g in demo_data.gifts { g.expires_at = time_now() + 7 * 86400 }
    for w in demo_data.wishes { w.expires_at = time_now() + 7 * 86400 }
    for entry in demo_data.wallet.ledger { entry.created_at_epoch = time_now() - 86400 }
    auth_state = "signed_in"; auth_message = ""; account_busy = false
    category_index = 0; product_search = ""; shop_side = "shop"; gift_side = "inbox"
    status = "本地演示 · 8 件商品"; refresh(); load_all()
}
fn leave_demo(){
    demo_mode = false; demo_data = nil; clear_account_data()
    auth_state = "signed_out"; auth_message = "请登录真实账号，或重新进入本地演示。"; account_busy = false; refresh()
}
fn check_auth(){
    flush_revocations()
    let generation = auth_generation
    if session_token == "" { auth_lost("请登录或注册礼遇账号。"); return }
    api_request({method: "GET", path: "/me"}, fn(r){
        if generation != auth_generation { return }
        if !r.is_ok { auth_state = "error"; auth_message = r.error; refresh(); return }
        if r.data.status == 401 { auth_lost("登录已过期，请重新登录。"); return }
        if r.data.status != 200 { auth_state = "error"; auth_message = "无法检查账号，请重试。"; refresh(); return }
        auth_ready()
    })
}
fn close_authorization(){
    ui.auth_reader.close(); authorization = nil; account_busy = false; auth_flow_generation = auth_flow_generation + 1
}
fn cancel_authorization(){
    if authorization == nil { return }
    let flow = authorization
    close_authorization()
    api_request({method: "POST", path: "/browser-authorizations/" + flow.id + "/poll?cancel=true", body: {poll_key: flow.poll_key}}, |_r| {})
    auth_message = "已取消授权。"; refresh()
}
fn poll_authorization(generation){
    if generation != auth_flow_generation || authorization == nil { return }
    let flow = authorization
    api_request({method: "POST", path: "/browser-authorizations/" + flow.id + "/poll", body: {poll_key: flow.poll_key}}, fn(r){
        if generation != auth_flow_generation || authorization == nil { return }
        if !r.is_ok {
            auth_message = r.error + "，正在重试。"; refresh()
            start_timeout(3.0, || poll_authorization(generation)); return
        }
        if r.data.status != 200 { close_authorization(); auth_message = "授权请求失败，请重新开始。"; notice = auth_message; refresh(); return }
        let data = r.data.body
        if data.state == "pending" { start_timeout(3.0, || poll_authorization(generation)); return }
        if data.state != "complete" { close_authorization(); auth_message = "授权已过期或已取消，请重新开始。"; notice = auth_message; refresh(); return }
        let purpose = flow.purpose
        close_authorization()
        if purpose == "login" {
            if data.token == nil || data.token == "" { auth_message = "授权结果无效，请重新登录。"; refresh(); return }
            let previous = session_token
            session_token = data.token; fs.write("session.json", {token: session_token}.to_json())
            revoke_later(previous)
            auth_ready()
        } else { notice = if purpose == "email" {"邮箱已更新。"} else {"手机号已更新。"}; get("/me/profile", "profile"); get("/me", "me"); get("/gifts/inbox", "inbox"); refresh() }
    })
}
fn open_authorization_page(){
    if authorization == nil { return }
    if !ui.auth_reader.open(service_origin + authorization.browser_path) { auth_message = "授权网页打开失败，请重试。"; refresh() }
}
fn begin_authorization(purpose){
    if account_busy { return }; account_busy = true
    auth_message = "正在打开礼遇授权网页…"; notice = ""; refresh()
    auth_flow_generation = auth_flow_generation + 1
    let generation = auth_flow_generation
    api_request({method: "POST", path: "/browser-authorizations", body: {purpose: purpose}}, fn(r){
        if generation != auth_flow_generation { return }
        if !r.is_ok || r.data.status != 200 {
            account_busy = false; auth_message = if !r.is_ok {r.error} else {"暂时无法创建授权，请重试。"}; notice = auth_message; refresh(); return
        }
        let data = r.data.body
        if data.id == nil || data.poll_key == nil || data.browser_path == nil { account_busy = false; auth_message = "授权响应无效。"; refresh(); return }
        authorization = {id: data.id, poll_key: data.poll_key, browser_path: data.browser_path, purpose: purpose}
        auth_message = "请在网页完成验证，结果将自动同步。"; refresh()
        start_timeout(0.1, || open_authorization_page())
        start_timeout(3.0, || poll_authorization(generation))
        start_timeout(305.0, || { if generation == auth_flow_generation && authorization != nil { cancel_authorization(); auth_message = "授权已过期，请重新开始。"; notice = auth_message; refresh() } })
    })
}
fn sign_in(){ begin_authorization("login") }
fn switch_account(){ if demo_mode { leave_demo(); return }; begin_authorization("login") }
fn logout(){
    if demo_mode { leave_demo(); return }
    if account_busy { return }
    let previous = session_token
    auth_lost("已退出礼遇账号。")
    revoke_later(previous)
}
fn get(path, kind){
    if auth_state != "signed_in" { return }
    if kind == "mine" { wish_lists_loading = true }
    let generation = auth_generation
    api_request({method: "GET", path: path}, fn(r){
            if generation != auth_generation { return }
            if kind == "mine" { wish_lists_loading = false }
            if kind == "wish_detail" && path != "/wishlists/" + wish_detail_id { return }
            if kind == "gift_detail" && path != "/gifts/" + gift_detail_id { return }
            if !r.is_ok { status = r.error + "（" + kind + "）"; if kind == "gift_detail" { gift_detail_error = "礼盒加载失败：" + r.error }; refresh(); return }
            if r.data.status == 401 { auth_lost("登录已过期，请重新登录。"); return }
            if r.data.status < 200 || r.data.status >= 300 {
                status = "LIYU 服务返回 " + r.data.status + "（" + kind + "）"
                if kind == "gift_detail" { gift_detail_error = "礼盒加载失败：服务返回 " + r.data.status }
                refresh(); return
            }
            let data = r.data.body
            if data == nil { status = "LIYU 服务响应无法解析（" + kind + "）"; if kind == "gift_detail" { gift_detail_error = "礼盒加载失败：服务响应无法解析" }; refresh(); return }
            if kind == "catalog" { products = data.items; status = (if demo_mode {"本地演示 · "} else {"已连接 LIYU 服务 · "}) + products.len() + " 件商品" }
            if kind == "categories" { categories = [{id: "", name: "全部"}]; for c in data { categories.push(c) } }
            if kind == "friends" {
                friends = data
                if contact_id >= 0 {
                    contact_index = -1
                    for i in friends.len() { if friends[i].id == contact_id { contact_index = i } }
                }
                let valid = []
                for id in draft_recipient_ids { for friend in friends { if friend.id == id { valid.push(id) } } }
                if valid.len() != draft_recipient_ids.len() { quote = nil }
                draft_recipient_ids = valid
            }
            if kind == "friend_tags" { friend_tags = data }
            if kind == "reminders" { reminders = data }
            if kind == "mine" { my_wishes = data }
            if kind == "friend_wishes" { friend_wishes = data; wish_previews = []; for w in data { get("/wishlists/" + w.id, "preview") } }
            if kind == "preview" { wish_previews.push(data) }
            if kind == "inbox" { inbox = data }
            if kind == "outbox" { outbox = data }
            if kind == "contracts" { contracts = data }
            if kind == "contract_templates" { contract_templates = data }
            if kind == "me" { account = data }
            if kind == "profile" { profile = data }
            if kind == "wallet" { wallet = data }
            if kind == "addresses" { addresses = data }
            if kind == "wish_detail" { wish_detail = data }
            if kind == "gift_detail" { gift_detail = data; gift_detail_error = "" }
            if kind == "gift_detail" && gift_side == "inbox" && data.state == "revealed" { get("/gifts/" + data.id + "/recovery-quote", "recovery_quote") }
            if kind == "gift_detail" && gift_side == "inbox" && (data.state == "accepted" || data.state == "exchanged") && data.physical { get("/shipments/" + data.id, "shipment") }
            if kind == "recovery_quote" { recovery_quote = data }
            if kind == "shipment" { shipment = data }
            refresh()
    })
}
fn mutate(path, method, payload, done){
    if auth_state != "signed_in" { return }
    let generation = auth_generation
    api_request({method: method, path: path, body: payload}, fn(r){
        if generation != auth_generation { return }
        if !r.is_ok { notice = r.error; refresh(); return }
        if r.data.status == 401 { auth_lost("登录已过期，请重新登录。"); return }
        if r.data.status < 200 || r.data.status >= 300 {
            notice = "服务端拒绝操作（HTTP " + r.data.status + "）：" + r.data.body.error; refresh(); return
        }
        done(r.data.body)
    })
}
fn load_all(){
    get("/catalog/categories", "categories")
    get("/catalog?limit=50", "catalog")
    get("/me", "me")
    get("/me/profile", "profile")
    get("/wallet", "wallet")
    get("/me/addresses", "addresses")
    get("/friends", "friends")
    get("/notifications", "reminders")
    get("/friend-tags", "friend_tags")
    get("/wishlists/mine", "mine")
    get("/wishlists/friends", "friend_wishes")
    get("/gifts/inbox", "inbox")
    get("/gifts/outbox", "outbox")
    get("/contracts", "contracts")
    get("/contract-templates", "contract_templates")
}
fn go(next){
    if profile_busy { return }
    wish_shop_id = -1; wish_shop_title = ""; gift_replacing_product = false
    tab = next; stage = "browse"; notice = ""; gift_from_contact = false; gift_from_pact = false
    if next == "box" { box_origin_tab = "" }
    if next == "wishes" { wishes_origin_tab = ""; wish_detail_from_discover = false }
    if next == "discover" { shop_origin_contact_id = -1 }
    if next == "pact" { get("/contracts", "contracts") }
    refresh()
}
fn shop_for_contact(){
    let recipient = friends[contact_index].id
    shop_side = "shop"; category_index = 0; product_search = ""
    go("discover"); shop_origin_contact_id = recipient; refresh()
}
fn shop_for_gift_replacement(){
    shop_side = "shop"; go("discover"); gift_replacing_product = true; refresh()
}
fn gift_selected_product(){
    if gift_replacing_product {
        draft_product = selected_product; draft_wish_item_id = -1; quote = nil; gift_replacing_product = false
        tab = "command"; stage = "draft"; notice = ""; refresh(); return
    }
    let recipient = shop_origin_contact_id
    begin("gift", selected_product)
    if recipient >= 0 { for friend in friends { if friend.id == recipient { draft_recipient_ids.push(recipient) } } }
    refresh()
}
fn open_wishes(){ let source = tab; go("wishes"); wishes_origin_tab = source; refresh() }
fn open_box(side){ let source = tab; gift_side = side; go("box"); box_origin_tab = source; get("/gifts/" + side, side); refresh() }
fn open_command(){ command_browse_origin_tab = tab; command_browse_origin_stage = stage; go("command"); refresh() }
fn back(){
    if wish_busy { return }
    if stage == "wish_pick" { tab = wish_picker_origin_tab; stage = wish_picker_origin_stage; notice = ""; refresh(); return }
    if stage == "wish_new" {
        if wish_new_from_picker { stage = "wish_pick" } else { tab = wish_new_origin_tab; stage = wish_new_origin_stage }
        notice = ""; refresh(); return
    }
    if stage == "wish_add_vague" { stage = "wish_detail"; notice = ""; refresh(); return }
    if stage == "contract_status" { tab = contract_origin_tab; stage = contract_origin_stage; notice = ""; refresh(); return }
    if tab == "discover" {
        if stage == "detail" { stage = "browse"; refresh(); return }
        if gift_replacing_product { gift_replacing_product = false; tab = "command"; stage = "draft"; notice = ""; refresh(); return }
        if wish_shop_id >= 0 { let id = wish_shop_id; wish_shop_id = -1; tab = "wishes"; choose_wish(id); return }
        if shop_origin_contact_id >= 0 {
            let recipient = shop_origin_contact_id; shop_origin_contact_id = -1
            tab = "contacts"; stage = "contact_detail"; contact_index = -1
            for i in friends.len() { if friends[i].id == recipient { contact_index = i } }
            if contact_index < 0 { stage = "browse" }
            refresh(); return
        }
        go("discover"); return
    }
    if tab == "box" {
        if stage == "gift_product_detail" { stage = "gift_detail"; refresh(); return }
        if stage == "gift_detail" {
            if gift_mode != "" { gift_mode = ""; refresh(); return }
            if gift_from_contact { tab = "contacts"; stage = "contact_section"; gift_from_contact = false; refresh(); return }
            if gift_from_pact { tab = "pact"; stage = "browse"; gift_from_pact = false; refresh(); return }
            stage = "browse"; refresh(); return
        }
        if box_origin_tab != "" { let source = box_origin_tab; box_origin_tab = ""; go(source); return }
        go("box"); return
    }
    if tab == "contacts" {
        if stage == "contact_edit" { stage = "contact_profile"; refresh(); return }
        if stage == "contact_profile" || stage == "contact_section" || stage == "contact_tags" { stage = "contact_detail"; refresh(); return }
        if stage == "contact_wish_detail" { stage = contact_wish_origin; refresh(); return }
        if stage == "contact_detail" { stage = contact_detail_origin_stage; refresh(); return }
        if stage == "tag_new" { stage = tag_form_origin; refresh(); return }
        if stage == "tag_edit" { stage = "tag_manage"; refresh(); return }
        if stage == "tag_members_edit" || stage == "tag_batch_select" { stage = "tag_people"; refresh(); return }
        if stage == "tag_batch_choose" { stage = "tag_batch_select"; refresh(); return }
        if stage == "tag_people" || stage == "tag_manage" { stage = "tags"; refresh(); return }
        go("contacts"); return
    }
    if tab == "wishes" {
        if stage == "wish_audience" { stage = "wish_edit"; refresh(); return }
        if stage == "wish_edit" || stage == "wish_confirm_close" || stage == "wish_confirm_delete" { stage = "wish_detail"; refresh(); return }
        if stage == "wish_detail" {
            if wish_detail_origin_tab != "" { tab = wish_detail_origin_tab; stage = wish_detail_origin_stage; wish_detail_origin_tab = ""; notice = ""; refresh(); return }
            if wish_detail_from_discover { wish_detail_from_discover = false; shop_side = "wish"; go("discover"); return }
            stage = "browse"; refresh(); return
        }
        if wishes_origin_tab != "" { let source = wishes_origin_tab; wishes_origin_tab = ""; go(source); return }
        shop_side = "wish"; go("discover"); return
    }
    if tab == "command" {
        if stage == "checkout" || stage == "recipient" || stage == "audience" { stage = "draft"; refresh(); return }
        if stage == "draft" && command_origin_tab != "" { tab = command_origin_tab; stage = command_origin_stage; refresh(); return }
        if command_browse_origin_tab != "" { tab = command_browse_origin_tab; stage = command_browse_origin_stage; command_browse_origin_tab = ""; refresh(); return }
        go("command"); return
    }
    if tab == "me" {
        if profile_busy { return }
        if stage == "address_delete" { stage = "address_edit"; notice = ""; refresh(); return }
        if stage == "profile_edit" || stage == "address_edit" { stage = "profile"; notice = ""; refresh(); return }
        go("me")
    }
}
fn account_write(path, method, body, done){
    if profile_busy || auth_state != "signed_in" { return }
    profile_busy = true; notice = ""; refresh()
    let generation = auth_generation
    api_request({method: method, path: path, body: body}, fn(r){
        if generation != auth_generation { return }
        profile_busy = false
        if !r.is_ok { notice = r.error; refresh(); return }
        if r.data.status == 401 { auth_lost("登录已过期，请重新登录。"); return }
        if r.data.status < 200 || r.data.status >= 300 { notice = "保存失败，请检查输入后重试（HTTP " + r.data.status + "）。"; refresh(); return }
        done(r.data.body)
    })
}
fn edit_display_name(){
    if profile == nil || profile_busy { return }
    profile_edit_value = profile.display_name; notice = ""; stage = "profile_edit"; refresh()
}
fn save_display_name(){
    let value = profile_edit_value.trim()
    if value == "" || value.len() > 50 { notice = "显示名请填写 1–50 个字。"; refresh(); return }
    account_write("/me/profile", "PATCH", {display_name: value}, |data| {
        profile = data; stage = "profile"; notice = "显示名已更新。"; get("/me", "me"); refresh()
    })
}
fn edit_my_contact(kind){
    if demo_mode { notice = "演示联系方式为虚构数据；请登录真实账号后验证修改。"; refresh(); return }
    if profile == nil || profile_busy { return }
    begin_authorization(kind)
}
fn edit_address(id){
    if profile_busy { return }
    address_edit_id = id; address_edit_name = ""; address_edit_phone = ""; address_edit_text = ""; address_edit_default = addresses.len() == 0
    if id >= 0 { for a in addresses { if a.id == id {
        address_edit_name = a.recipient_name; address_edit_phone = a.phone; address_edit_text = a.address; address_edit_default = a.is_default
    } } }
    notice = ""; stage = "address_edit"; refresh()
}
fn save_address(){
    let name = address_edit_name.trim(); let phone = address_edit_phone.trim(); let address = address_edit_text.trim()
    if name == "" || name.len() > 50 { notice = "收货人请填写 1–50 个字。"; refresh(); return }
    if !regex("^[0-9]{11}$", "").test(phone) { notice = "请输入 11 位收货手机号。"; refresh(); return }
    if address == "" || address.len() > 500 { notice = "请填写完整地址（最多 500 个字）。"; refresh(); return }
    let path = if address_edit_id < 0 {"/me/addresses"} else {"/me/addresses/" + address_edit_id}
    let method = if address_edit_id < 0 {"POST"} else {"PUT"}
    account_write(path, method, {recipient_name: name, phone: phone, address: address, is_default: address_edit_default}, |_data| {
        stage = "profile"; notice = "收货地址已保存。"; get("/me/addresses", "addresses"); refresh()
    })
}
fn delete_address(){
    if address_edit_id < 0 { return }
    account_write("/me/addresses/" + address_edit_id, "DELETE", {}, |_data| {
        stage = "profile"; notice = "收货地址已删除。"; get("/me/addresses", "addresses"); refresh()
    })
}
fn choose_product(i){ selected_product = i; stage = "detail"; refresh() }
fn gift_product_id(id){ for i in products.len() { if products[i].id == id { begin("gift", i); return } } notice = "这件商品已不在服务端目录中。"; refresh() }
fn gift_wish_item(item){
    let p = product_for_item(item)
    if p == nil { notice = "服务端目录没有符合这份心愿的商品。"; refresh(); return }
    gift_product_id(p.id)
    draft_wish_item_id = item.id
    if wish_detail != nil { for friend in friends { if friend.id == wish_detail.owner.id { draft_recipient_ids.push(friend.id) } } }
    refresh()
}
fn draft_wish_count(){ let count = 0; for w in my_wishes { if w.status == "draft" { count = count + 1 } }; return count }
fn wishlist_state(state){ if state == "draft" { return "未发布" }; if state == "published" { return "已发布" }; if state == "closed" { return "已结束" }; return "已过期" }
fn wish_write(path, method, body, done){
    if wish_busy || auth_state != "signed_in" { return }
    wish_busy = true; notice = ""; refresh()
    let generation = auth_generation
    api_request({method: method, path: path, body: body}, fn(r){
        if generation != auth_generation { return }
        wish_busy = false
        if !r.is_ok { notice = r.error; refresh(); return }
        if r.data.status == 401 { auth_lost("登录已过期，请重新登录。"); return }
        if r.data.status < 200 || r.data.status >= 300 { notice = "未能保存心愿单：" + r.data.body.error; refresh(); return }
        done(r.data.body)
    })
}
fn choose_wish(id){ wish_detail_origin_tab = ""; wish_detail_origin_stage = ""; wish_detail_id = id; wish_detail_from_discover = false; wish_detail = nil; stage = "wish_detail"; get("/wishlists/" + id, "wish_detail"); refresh() }
fn edit_wish(){
    if wish_detail == nil { return }
    wish_publish_mode = false; edit_occasion = wish_detail.occasion
    edit_title = wish_detail.title; edit_note = wish_detail.note; edit_date = wish_detail.event_on; edit_expiry_hours = if wish_detail.status == "draft" {"24"} else {""}
    draft_audience_ids = wish_detail.audience_user_ids; draft_audience_tag_ids = []; draft_audience_all = draft_audience_ids.len() == 0
    notice = ""; stage = "wish_edit"; refresh()
}
fn save_wish_edit(){
    if wish_detail == nil { return }
    if edit_expiry_hours.trim() != "" && (!regex("^[0-9]+$", "").test(edit_expiry_hours.trim()) || edit_expiry_hours.trim().to_f64() < 1 || edit_expiry_hours.trim().to_f64() > 720) { notice = "有效期请输入 1–720 小时。"; refresh(); return }
    let id = wish_detail.id
    let audience = audience_ids()
    if !draft_audience_all && audience.len() == 0 { notice = "请选择至少一位可见的熟人，或选择所有熟人。"; refresh(); return }
    let body = {title: edit_title.trim(), note: edit_note.trim(), occasion: edit_occasion, event_on: edit_date.trim()}
    if draft_audience_all { body.audience_user_ids = [] } else { body.audience_user_ids = audience }
    if edit_expiry_hours.trim() != "" { body.expires_hours = floor(edit_expiry_hours.trim().to_f64()) }
    let path = "/wishlists/" + id + (if wish_publish_mode {"/publish"} else {""})
    let publishing = wish_publish_mode
    wish_write(path, if publishing {"POST"} else {"PUT"}, body, |_data| {
        notice = if publishing {"心愿单已发布。"} else {"心愿单已保存。"}; stage = "wish_detail"; get("/wishlists/" + id, "wish_detail"); get("/wishlists/mine", "mine"); refresh()
    })
}
fn confirm_wish_action(action){
    if wish_detail == nil { return }
    let id = wish_detail.id
    if action == "close" { mutate("/wishlists/" + id + "/close", "POST", {}, |_data| { notice = "心愿单已提前结束。"; stage = "wish_detail"; get("/wishlists/" + id, "wish_detail"); get("/wishlists/mine", "mine"); refresh() }) }
    if action == "delete" { mutate("/wishlists/" + id, "DELETE", {}, |_data| { notice = "心愿单已删除。"; tab = "wishes"; stage = "browse"; get("/wishlists/mine", "mine"); refresh() }) }
}
fn choose_gift(id){ gift_from_contact = false; gift_from_pact = false; gift_detail = nil; gift_detail_id = id; gift_detail_error = ""; gift_mode = ""; recovery_quote = nil; shipment = nil; exchange_product_id = -1; transfer_recipient_id = -1; ai_context = ai_context + 1; ai_text = ""; ai_busy = false; guess = ""; notice = ""; stage = "gift_detail"; get("/gifts/" + id, "gift_detail"); refresh() }
fn choose_contact(i){ contact_detail_origin_stage = stage; contact_index = i; contact_id = friends[i].id; notice = ""; ai_context = ai_context + 1; ai_text = ""; ai_busy = false; stage = "contact_detail"; refresh() }

fn ask_ai(task, input){
    if demo_mode {
        ai_text = if task.search("送礼人") >= 0 {"演示建议（非实时 AI）：先结合提示回想共同经历，再从熟人中判断；例如一起运动、看电影或喝咖啡的人。最终答案仍需自己确认。"} else {"演示建议（非实时 AI）：咖啡适合日常分享，电影票适合一起度过周末，氛围灯适合喜欢布置新家的熟人。结合对方爱好与预算再挑选。"}
        ai_busy = false; refresh(); return
    }
    if ai_busy { return }
    ai_busy = true; ai_text = "正在分析…"; refresh()
    let generation = auth_generation
    let context = ai_context
    host.request("model.complete", {
        task: task,
        input: input,
        schema: {type: "object", required: ["advice"], additionalProperties: false, properties: {advice: {type: "string", maxLength: 300}}},
        class: "fast"
    }, fn(r){
        if generation != auth_generation || context != ai_context { return }
        ai_busy = false
        if r.is_ok { ai_text = r.data.output.advice }
        else if r.error.search("no service answers") >= 0 { ai_text = "当前宿主还没有提供 AI 服务。" }
        else { ai_text = "AI 暂不可用：" + r.error }
        refresh()
    })
}
fn ask_gift_ideas(){
    if contact_index < 0 { return }
    let f = friends[contact_index]
    let catalog = []
    for p in products { if catalog.len() < 20 { catalog.push({name: p.name, kind: p.kind, price_cents: p.price_cents}) } }
    ask_ai("根据熟人资料与在售目录，推荐至多三件适合送人的商品并简述理由。只从目录选择，不替用户下单。用中文回答。", {relationship: f.relationship, birthday: f.birthday, wedding_date: f.wedding_date, note: f.note, products: catalog})
}
fn ask_sender_clue(){
    if gift_detail == nil || gift_detail.state != "opened" { return }
    let people = []
    for f in friends { if people.len() < 30 { people.push({name: f.display_name, nickname: f.nickname, relationship: f.relationship}) } }
    ask_ai("根据匿名礼盒提示与熟人名单，给出最多三位可能的送礼人和推测理由。你不知道真正答案，不要断言，也不要声称已拆盒。用中文回答。", {clue: gift_detail.clue, people: people})
}
fn contact_section(kind){ contact_section_kind = kind; stage = "contact_section"; refresh() }
fn contact_wish(id, origin){ wish_detail_id = id; contact_wish_origin = origin; wish_detail = nil; stage = "contact_wish_detail"; get("/wishlists/" + id, "wish_detail"); refresh() }
fn contact_gift(id, side){ gift_side = side; tab = "box"; choose_gift(id); gift_from_contact = true; refresh() }
fn friend_wish_count(id){ let n = 0; for w in friend_wishes { if w.owner.id == id { n = n + 1 } } return n }
fn friend_gift_count(id, kind){
    let n = 0
    if kind == "sent" { for g in outbox { if g.recipient.id == id { n = n + 1 } } }
    else { for g in inbox { if g.sender != nil && g.sender.id == id { n = n + 1 } } }
    return n
}
fn friend_field(f, field){
    if field == "nickname" { return f.nickname }
    if field == "phone" { return f.phone }
    if field == "email" { return f.email }
    if field == "relationship" { return f.relationship }
    if field == "birthday" { return f.birthday }
    if field == "wedding_date" { return f.wedding_date }
    return f.note
}
fn friend_field_name(field){
    if field == "nickname" { return "称呼" }
    if field == "phone" { return "手机号" }
    if field == "email" { return "邮箱" }
    if field == "relationship" { return "关系" }
    if field == "birthday" { return "生日" }
    if field == "wedding_date" { return "结婚日期" }
    return "备注"
}
fn has_id(ids, id){ for value in ids { if value == id { return true } } return false }
fn toggle_id(ids, id){
    let next = []; let found = false
    for value in ids { if value == id { found = true } else { next.push(value) } }
    if !found { next.push(id) }
    return next
}
fn friend_matches(f, q){
    let text = q.trim()
    return text == "" || f.display_name.search(text) >= 0 || f.account_name.search(text) >= 0 || f.phone.search(text) >= 0 || f.email.search(text) >= 0
}
fn tag_by_id(id){ for tag in friend_tags { if tag.id == id { return tag } } return nil }
fn tags_for_friend(friend_id){ let ids = []; for tag in friend_tags { if has_id(tag.member_ids, friend_id) { ids.push(tag.id) } }; return ids }
fn tag_names_for_friend(friend_id){ let names = ""; for tag in friend_tags { if has_id(tag.member_ids, friend_id) { if names != "" { names = names + " · " }; names = names + tag.name } }; return names }
fn tag_preview(tag){ let names = ""; for i in tag.member_names.len() { if i > 0 { names = names + "、" }; names = names + tag.member_names[i] }; return names }
fn untagged_count(){ let count = 0; for friend in friends { if tags_for_friend(friend.id).len() == 0 { count = count + 1 } }; return count }
fn friend_in_tag(friend_id){ if tag_selected_id < 0 { return tags_for_friend(friend_id).len() == 0 }; let tag = tag_by_id(tag_selected_id); return tag != nil && has_id(tag.member_ids, friend_id) }
fn tag_visible(tag){ let q = tag_search.trim(); return q == "" || tag.name.search(q) >= 0 || tag_preview(tag).search(q) >= 0 }
fn selected_tag_names(){ let text = ""; for tag in friend_tags { if has_id(draft_audience_tag_ids, tag.id) { if text != "" { text = text + "、" }; text = text + tag.name } }; return text }
fn audience_ids(){
    let ids = []
    for id in draft_audience_ids { if !has_id(ids, id) { ids.push(id) } }
    for tag in friend_tags { if has_id(draft_audience_tag_ids, tag.id) { for id in tag.member_ids { if !has_id(ids, id) { ids.push(id) } } } }
    return ids
}
fn audience_summary(){
    if draft_audience_all { return "所有熟人" }
    let count = audience_ids().len()
    if count == 0 { return "请选择熟人或标签" }
    return count + " 位熟人"
}
fn open_tags(){ stage = "tags"; tag_search = ""; get("/friend-tags", "friend_tags"); refresh() }
fn open_tag_people(id){ tag_selected_id = id; tag_people_search = ""; stage = "tag_people"; refresh() }
fn open_tag_form(origin){ tag_form_origin = origin; tag_name_value = ""; stage = "tag_new"; refresh() }
fn create_tag(){
    let name = tag_name_value.trim()
    if name == "" { notice = "请输入标签名称。"; refresh(); return }
    mutate("/friend-tags", "POST", {name: name}, |data| {
        if tag_form_origin == "contact_tags" { contact_tag_ids_draft.push(data.id); stage = "contact_tags" }
        else { stage = tag_form_origin }
        tag_name_value = ""; notice = ""; get("/friend-tags", "friend_tags"); refresh()
    })
}
fn rename_tag(){
    let name = tag_name_value.trim()
    if name == "" { notice = "请输入标签名称。"; refresh(); return }
    mutate("/friend-tags/" + tag_selected_id, "PUT", {name: name}, |_data| { stage = "tag_manage"; notice = ""; get("/friend-tags", "friend_tags"); refresh() })
}
fn delete_tag(){ mutate("/friend-tags/" + tag_selected_id, "DELETE", {}, |_data| { stage = "tag_manage"; notice = ""; get("/friend-tags", "friend_tags"); refresh() }) }
fn save_contact_tags(){
    if contact_index < 0 { return }
    mutate("/friends/" + friends[contact_index].id + "/tags", "PUT", {tag_ids: contact_tag_ids_draft}, |_data| { stage = "contact_detail"; notice = ""; get("/friend-tags", "friend_tags"); refresh() })
}
fn save_tag_members(){
    mutate("/friend-tags/" + tag_selected_id + "/members", "PUT", {friend_ids: tag_selected_friend_ids}, |_data| { stage = "tag_people"; notice = ""; get("/friend-tags", "friend_tags"); refresh() })
}
fn batch_tag_friend(index){
    if index >= tag_selected_friend_ids.len() { stage = "tags"; notice = ""; get("/friend-tags", "friend_tags"); refresh(); return }
    let friend_id = tag_selected_friend_ids[index]
    let ids = tags_for_friend(friend_id)
    for id in batch_tag_ids { if !has_id(ids, id) { ids.push(id) } }
    mutate("/friends/" + friend_id + "/tags", "PUT", {tag_ids: ids}, |_data| batch_tag_friend(index + 1))
}
fn edit_friend(field){ friend_edit_field = field; friend_edit_value = friend_field(friends[contact_index], field); stage = "contact_edit"; refresh() }
fn save_friend(){
    if contact_index < 0 { return }
    let f = friends[contact_index]
    let value = friend_edit_value.trim()
    let body = {nickname: f.nickname, phone: f.phone, email: f.email, relationship: f.relationship, birthday: f.birthday, wedding_date: f.wedding_date, note: f.note}
    if friend_edit_field == "nickname" { body.nickname = value }
    if friend_edit_field == "phone" { body.phone = value }
    if friend_edit_field == "email" { body.email = value }
    if friend_edit_field == "relationship" { body.relationship = value }
    if friend_edit_field == "birthday" { body.birthday = value }
    if friend_edit_field == "wedding_date" { body.wedding_date = value }
    if friend_edit_field == "note" { body.note = value }
    mutate("/friends/" + f.id + "/details", "PUT", body, |_data| {
        stage = "contact_profile"; notice = ""; get("/friends", "friends"); refresh()
    })
}
fn set_gift_side(side){ gift_side = side; get("/gifts/" + side, side); refresh() }
fn next_category(){ category_index = (category_index + 1) % categories.len(); refresh() }
fn open_wish_picker(product){
    wish_picker_product = product; wish_picker_origin_tab = tab; wish_picker_origin_stage = stage
    stage = "wish_pick"; notice = ""; get("/wishlists/mine", "mine"); refresh()
}
fn start_wish_draft(from_picker){
    wish_new_from_picker = from_picker; wish_new_origin_tab = tab; wish_new_origin_stage = stage
    wish_new_title = ""; wish_new_note = ""; stage = "wish_new"; notice = ""; refresh()
}
fn show_wish_after_add(id){
    let source_tab = wish_picker_origin_tab; let source_stage = wish_picker_origin_stage
    tab = "wishes"; choose_wish(id)
    if wish_shop_id < 0 { wish_detail_origin_tab = source_tab; wish_detail_origin_stage = source_stage }
    get("/wishlists/mine", "mine"); refresh()
}
fn add_product_to_wish(id){
    if wish_picker_product < 0 { return }
    for w in my_wishes { if w.id == id && w.item_count >= 8 { notice = "这张心愿单已满（最多 8 项），请先移除商品或新建一张。"; refresh(); return } }
    wish_write("/wishlists/" + id + "/items", "POST", {product_id: products[wish_picker_product].id}, |data| {
        show_wish_after_add(id); notice = if data.already_present {"这件商品已在心愿单中。"} else {"商品已加入心愿单。"}; refresh()
    })
}
fn create_wish_draft(){
    if wish_new_title.trim() == "" { notice = "请输入心愿单名称。"; refresh(); return }
    let body = {title: wish_new_title.trim(), note: wish_new_note.trim(), items: []}
    let with_product = wish_new_from_picker && wish_picker_product >= 0
    if with_product { body.items.push({product_id: products[wish_picker_product].id}) }
    wish_write("/wishlists/drafts", "POST", body, |data| {
        if with_product { show_wish_after_add(data.id) } else { tab = "wishes"; choose_wish(data.id); get("/wishlists/mine", "mine") }
        notice = if with_product {"心愿单已创建，商品已加入。"} else {"心愿单已创建，可以开始挑选商品。"}; refresh()
    })
}
fn shop_for_wish(){
    if wish_detail == nil || wish_detail.status != "draft" { return }
    let id = wish_detail.id; let title = wish_detail.title
    shop_side = "shop"; category_index = 0; product_search = ""; shop_origin_contact_id = -1
    go("discover"); wish_shop_id = id; wish_shop_title = title; refresh()
}
fn publish_wish(){
    if wish_detail == nil || wish_detail.items.len() == 0 { notice = "请先加入至少一件商品或填写商品需求。"; refresh(); return }
    edit_wish(); wish_publish_mode = true; refresh()
}
fn remove_wish_item(id){
    let wid = wish_detail.id
    wish_write("/wishlists/" + wid + "/items/" + id, "DELETE", {}, |_data| {
        notice = "已从心愿单移除。"; get("/wishlists/" + wid, "wish_detail"); get("/wishlists/mine", "mine"); refresh()
    })
}
fn start_vague_wish(){ draft_vague_kind = ""; draft_budget_cents = 0; draft_wants = ""; stage = "wish_add_vague"; refresh() }
fn add_vague_wish(){
    if draft_vague_kind == "" { notice = "请选择想要的种类。"; refresh(); return }
    let wid = wish_detail.id
    wish_write("/wishlists/" + wid + "/items", "POST", {kind: draft_vague_kind, max_price_cents: draft_budget_cents, wants: draft_wants.trim()}, |_data| {
        notice = "商品需求已加入心愿单。"; stage = "wish_detail"; get("/wishlists/" + wid, "wish_detail"); get("/wishlists/mine", "mine"); refresh()
    })
}
fn begin(kind, product){
    if kind == "wish" {
        if product >= 0 { open_wish_picker(product) } else { start_wish_draft(false) }
        return
    }
    if product < 0 { shop_side = "shop"; go("discover"); return }
    command_origin_tab = tab; command_origin_stage = stage
    draft_kind = kind; draft_product = product; draft_wish_item_id = -1; draft_recipient_ids = []
    draft_title = ""; draft_note = ""; draft_date = today(); draft_expiry_hours = "24"
    draft_message = ""; draft_contract = ""; draft_clue = ""; draft_answer = ""; draft_error = ""
    draft_unlock = "guess_who"; draft_occasion = "other"; draft_audience_all = true; draft_audience_ids = []; draft_audience_tag_ids = []; audience_search = ""
    draft_item_mode = "exact"; draft_vague_kind = ""; draft_budget_cents = 0; draft_wants = ""; quote = nil
    order_key = "mini-" + time_now() + "-" + random_u32()
    tab = "command"; stage = "draft"; notice = ""; refresh()
}
fn recipient_selected(id){ for selected in draft_recipient_ids { if selected == id { return true } } return false }
fn choose_recipient(i){
    let id = friends[i].id
    if recipient_selected(id) { notice = "这位熟人已在送礼名单中。"; refresh(); return }
    if draft_recipient_ids.len() >= 100 { notice = "一次最多选择 100 位熟人。"; refresh(); return }
    if draft_wish_item_id >= 0 && draft_recipient_ids.len() > 0 {
        draft_wish_item_id = -1
        notice = "多人送礼已取消单人心愿关联。"
    }
    draft_recipient_ids.push(id); quote = nil; stage = "draft"; refresh()
}
fn remove_recipient(id){
    let kept = []
    for selected in draft_recipient_ids { if selected != id { kept.push(selected) } }
    draft_recipient_ids = kept; quote = nil; refresh()
}
fn recipient_name(id){ for friend in friends { if friend.id == id { return friend.display_name } } return "已失效的熟人" }
fn recipients_valid(){
    if draft_recipient_ids.len() == 0 { return false }
    for id in draft_recipient_ids {
        let found = false
        for friend in friends { if friend.id == id { found = true } }
        if !found { return false }
    }
    return true
}
fn gift_checkout_body(){
    let items = []
    for id in draft_recipient_ids {
        let item = {product_id: products[draft_product].id, recipient_id: id}
        if draft_wish_item_id >= 0 && draft_recipient_ids.len() == 1 { item.wish_item_id = draft_wish_item_id }
        items.push(item)
    }
    return {items: items, expires_hours: expiry_hours()}
}
fn gift_form_error(){
    let clue = draft_clue.trim()
    if clue.split("").len() > 30 { return "提示最多 30 个字。" }
    if draft_unlock == "question" && clue == "" { return "请填写题目。" }
    if draft_unlock == "question" && draft_answer.trim() == "" { return "请填写答案。" }
    if draft_unlock == "question" && draft_answer.trim().split("").len() > 20 { return "答案最多 20 个字。" }
    if draft_message.trim().split("").len() > 40 { return "想说的话最多 40 个字。" }
    if draft_contract.trim().split("").len() > 24 { return "约定最多 24 个字。" }
    return ""
}
fn unlock_name(mode){
    if mode == "guess_who" { return "猜我是谁" }
    if mode == "question" { return "回答问题" }
    return "直接打开"
}
fn parse_command(){
    let q = draft_command.trim()
    if q == "" { notice = "先输入一句想做的事。"; refresh(); return }
    let kind = ""
    if q.search("心愿") >= 0 || q.search("想要") >= 0 { kind = "wish" }
    if q.search("送") >= 0 || q.search("礼物") >= 0 { kind = "gift" }
    if kind == "" { notice = "目前识别心愿和送礼。"; refresh(); return }
    let found = -1
    for i in products.len() { if q.search(products[i].name) >= 0 || q.search(products[i].kind) >= 0 { found = i } }
    begin(kind, found)
    if kind == "gift" && found >= 0 { for friend in friends { if q.search(friend.display_name) >= 0 && !recipient_selected(friend.id) { draft_recipient_ids.push(friend.id) } } }
    if found < 0 { notice = "服务端目录中没有识别到对应商品，请从实际在售商品中选择。" }
    refresh()
}
fn quote_gift(){
    if expiry_hours() < 1 { draft_error = "有效期请输入 1–720 小时（最多 30 天）。"; refresh(); return }
    if draft_product < 0 { notice = "请确认商品。"; refresh(); return }
    if !recipients_valid() { notice = "请从熟人列表选择至少一位收礼人。"; refresh(); return }
    draft_error = gift_form_error()
    if draft_error != "" { notice = ""; refresh(); return }
    let body = gift_checkout_body()
    mutate("/orders/quote", "POST", body, |data| { quote = data; stage = "checkout"; notice = if demo_mode {"演示报价，不产生真实订单或扣款。"} else {"价格已由 LIYU 服务端核算。"}; refresh() })
}
fn create_order(){
    if expiry_hours() < 1 { stage = "draft"; draft_error = "有效期请输入 1–720 小时（最多 30 天）。"; refresh(); return }
    if quote == nil { notice = "请先获取服务端报价。"; refresh(); return }
    if !recipients_valid() { notice = "收礼人已不在熟人列表，请重新选择。"; quote = nil; refresh(); return }
    draft_error = gift_form_error()
    if draft_error != "" { stage = "draft"; quote = nil; notice = ""; refresh(); return }
    let body = gift_checkout_body()
    let generation = auth_generation
    api_request({method: "POST", path: "/orders", body: body, idempotency_key: order_key}, fn(r){
            if generation != auth_generation { return }
            if !r.is_ok { notice = r.error; refresh(); return }
            if r.data.status == 401 { auth_lost("登录已过期，请重新登录。"); return }
            if r.data.status < 200 || r.data.status >= 300 { notice = "订单创建失败（HTTP " + r.data.status + ")：" + r.data.body.error; refresh(); return }
            let order = r.data.body
            notice = "测试订单 " + order.id + " 已创建，正在执行测试支付…"; refresh()
            mutate("/orders/" + order.id + "/pay-test", "POST", {}, |_paid| {
                get_paid_order(order.id)
            })
    })
}
fn get_paid_order(id){
    let generation = auth_generation
    api_request({method: "GET", path: "/orders/" + id}, fn(r){
            if generation != auth_generation { return }
            if !r.is_ok { notice = r.error; refresh(); return }
            if r.data.status == 401 { auth_lost("登录已过期，请重新登录。"); return }
            if r.data.status != 200 { notice = "测试支付已发出；请在服务端确认订单 " + id + "。"; refresh(); return }
            let order = r.data.body
            if order.items.len() == 0 { notice = "订单没有商品，需核查服务端。"; refresh(); return }
            configure_paid_gifts(order.items, 0)
    })
}
fn configure_paid_gifts(items, index){
    if index >= items.len() {
        notice = items.len() + if demo_mode {" 个礼盒已保存在本次演示中。"} else {" 个测试礼盒已保存到 LIYU 服务。"}
        tab = "box"; stage = "browse"; gift_side = "outbox"
        get("/gifts/outbox", "outbox"); get("/gifts/inbox", "inbox"); refresh()
        return
    }
    let gift_id = items[index].gift_id
    if gift_id == nil { notice = "订单中的第 " + (index + 1) + " 个礼盒尚未生成，请核查服务端。"; refresh(); return }
    let body = {unlock_kind: draft_unlock, clue: draft_clue.trim(), answer: draft_answer.trim(), message: draft_message.trim(), contract_text: draft_contract.trim()}
    mutate("/gifts/" + gift_id + "/puzzle", "PUT", body, |_configured| { configure_paid_gifts(items, index + 1) })
}
fn configure_outbox_gift(){
    if gift_detail == nil { return }
    draft_error = gift_form_error()
    if draft_error != "" { refresh(); return }
    let id = gift_detail.id
    mutate("/gifts/" + id + "/puzzle", "PUT", {unlock_kind: draft_unlock, clue: draft_clue.trim(), answer: draft_answer.trim(), message: draft_message.trim(), contract_text: draft_contract.trim()}, |_data| {
        get("/gifts/" + id, "gift_detail"); get("/gifts/outbox", "outbox")
    })
}
fn gift_action(action, body){
    if gift_detail == nil { return }
    let id = gift_detail.id
    mutate("/gifts/" + id + "/" + action, "POST", body, |data| {
        notice = if action == "answer" && !data.correct {"还没答对，可以继续试。"} else {""}; gift_mode = ""; recovery_quote = nil; shipment = nil
        get("/gifts/" + id, "gift_detail"); get("/gifts/inbox", "inbox"); get("/gifts/outbox", "outbox"); get("/contracts", "contracts")
        if action == "cash-out" || action == "exchange" { get("/wallet", "wallet") }
    })
}
fn gift_ship(){
    if recipient_name.trim() == "" || recipient_address.trim() == "" || !regex("^[0-9]{11}$", "").test(recipient_phone.trim()) { notice = "请填写收货人、11 位手机号和完整地址。"; refresh(); return }
    gift_action("accept", {agree: true, recipient_name: recipient_name.trim(), recipient_phone: recipient_phone.trim(), recipient_address: recipient_address.trim()})
}
fn gift_exchange(){
    if exchange_product_id < 0 || recovery_quote == nil { notice = "请选择要兑换的商品。"; refresh(); return }
    let p = product_by_id(exchange_product_id)
    if p == nil { return }
    if wallet != nil && wallet.balance_cents + recovery_quote.recovery_cents - p.price_cents < 0 { notice = "钱包余额不足以补差价。"; refresh(); return }
    gift_action("exchange", {product_id: exchange_product_id})
}
fn gift_transfer(){
    if transfer_recipient_id < 0 { notice = "请选择一位熟人。"; refresh(); return }
    let h = transfer_expiry_hours.trim()
    if !regex("^[0-9]+$", "").test(h) || h.to_f64() < 1 || h.to_f64() > 720 { notice = "有效期请输入 1–720 小时。"; refresh(); return }
    if transfer_unlock == "question" && (transfer_clue.trim() == "" || transfer_answer.trim() == "") { notice = "请填写题目和答案。"; refresh(); return }
    gift_action("transfer", {recipient_id: transfer_recipient_id, expires_hours: floor(h.to_f64()), unlock_kind: transfer_unlock, clue: transfer_clue.trim(), answer: transfer_answer.trim(), agree: true})
}
start_timeout(0.05, || check_auth())

View{width: Fill height: Fill flow: Down
    content := View{width: Fill height: Fill flow: Down on_render: || {
    // ---- LIYU-MINI 主题 v2 (2026-10) ----
    // 浅色：暖白底 + 暖紫金；暗色：深紫黑底 + 提亮描边 + 品牌紫
    // 文字 4 级：ink > strong > muted > faint > disabled
    // 状态语义：success / warn / danger / info
    let ink       = if appearance == "light" {#x1f1530} else {#xf6f1fb}
    let strong    = if appearance == "light" {#x2b2037} else {#xe7dcf3}
    let muted     = if appearance == "light" {#x5a4b6e} else {#xb3a5c8}
    let faint     = if appearance == "light" {#x857594} else {#x8d7ea3}
    let disabled  = if appearance == "light" {#xa89cb8} else {#x6b5e7d}
    let accent    = if appearance == "light" {#xb6781c} else {#xf3c982}
    let accent_bg = if appearance == "light" {#xfbeed1} else {#x3a2a16}
    // 主色从冷紫偏暖：更接近"礼物"的紫罗兰
    let blue      = if appearance == "light" {#xa78bd9} else {#xb8a4f0}
    let canvas    = if appearance == "light" {#xfaf6f2} else {#x14101c}
    let bar       = if appearance == "light" {#xf2ebf5} else {#x1b1426}
    let well      = if appearance == "light" {#xede5f3} else {#x20182e}
    let button_surface = if appearance == "light" {#xf7f1fb} else {#x231934}
    let well_hover = if appearance == "light" {#xe5dcef} else {#x2a1f3c}
    let surface   = if appearance == "light" {#xfffffe} else {#x251a36}
    // 暗色描边改为表面之上的 8% 白光，浅色保持极浅紫
    let border    = if appearance == "light" {#xe6dfee} else {#x3d3252}
    let border_strong = if appearance == "light" {#xcfc4dc} else {#x4d406a}
    let soft      = if appearance == "light" {#xe9dff5} else {#x33234a}
    let selected  = if appearance == "light" {#xdccef2} else {#x3e2c5e}
    let pressed   = if appearance == "light" {#xc9b6ea} else {#x4a3a72}
    let border_hover = if appearance == "light" {#xa596bd} else {#x665184}
    let primary_hover = if appearance == "light" {#x9882cc} else {#xcab8f5}
    let primary_down  = if appearance == "light" {#x7c66b8} else {#xa18fd8}
    let primary_disabled = if appearance == "light" {#xc4b8d6} else {#x594e74}
    let on_primary = if appearance == "light" {#xfffffe} else {#x140e1f}
    let remove_hover = if appearance == "light" {#xe2c7e8} else {#x5a3a6a}
    let remove_down  = if appearance == "light" {#xd0b3d8} else {#x6a3a6a}
    // 语义状态色
    let success   = if appearance == "light" {#x3f8a5b} else {#x7fc99b}
    let warn      = if appearance == "light" {#xb6781c} else {#xf3c982}
    let danger    = if appearance == "light" {#xc24a55} else {#xf09aa1}
    let info      = if appearance == "light" {#x6a7fc2} else {#xa3b3f1}
    // 卡片内描边：浅色几乎不可见；暗色叠加白光，模拟"浮起"
    let card_inner_stroke = if appearance == "light" {#xffffff00} else {#xffffff14}
    let shadow_soft = if appearance == "light" {#x14101c14} else {#x00000066}
    let Card = RoundedView{width: Fill height: Fit flow: Down draw_bg +: {color: surface border_color: border border_size: 1.0 border_radius: 12.0}}
    let Primary = ButtonFlat{height: 44 padding: Inset{left: 16 right: 16}
        draw_bg +: {color: blue color_hover: primary_hover color_down: primary_down color_focus: blue color_disabled: primary_disabled border_radius: 6.0 border_size: 0.0}
        draw_text +: {color: on_primary color_hover: on_primary color_down: on_primary color_focus: on_primary color_disabled: muted text_style: theme.font_bold{font_size: 14.5}}}
    let Secondary = ButtonFlat{height: 44 padding: Inset{left: 16 right: 16}
        draw_bg +: {color: button_surface color_hover: selected color_down: pressed color_focus: soft color_disabled: button_surface border_color: border border_color_hover: border_hover border_color_down: blue border_color_focus: blue border_color_disabled: border border_size: 1.0 border_radius: 6.0}
        draw_text +: {color: ink color_hover: ink color_down: ink color_focus: ink color_disabled: faint text_style: theme.font_bold{font_size: 14.5}}}
    let Chip = ButtonFlat{width: Fit height: 32 padding: Inset{left: 14 right: 14}
        draw_bg +: {color: button_surface color_hover: soft color_down: selected color_focus: soft color_disabled: button_surface border_color: border border_color_hover: border_hover border_color_down: blue border_color_focus: blue border_color_disabled: border border_size: 1.0 border_radius: 16.0}
        draw_text +: {color: muted color_hover: ink color_down: ink color_focus: ink color_disabled: faint text_style: theme.font_regular{font_size: 12.5}}}
    let ChipOn = ButtonFlat{width: Fit height: 32 padding: Inset{left: 14 right: 14}
        draw_bg +: {color: selected color_hover: pressed color_down: soft color_focus: selected color_disabled: button_surface border_color: blue border_color_hover: blue border_color_down: blue border_color_focus: blue border_color_disabled: border border_size: 1.0 border_radius: 16.0}
        draw_text +: {color: ink color_hover: ink color_down: ink color_focus: ink color_disabled: faint text_style: theme.font_bold{font_size: 12.5}}}
    let Segment = ButtonFlat{width: Fill height: 36 padding: 4
        draw_bg +: {color: well color_hover: soft color_down: soft color_focus: soft color_disabled: well border_radius: 6.0 border_size: 0.0}
        draw_text +: {color: muted color_hover: ink color_down: ink color_focus: ink color_disabled: faint text_style: theme.font_bold{font_size: 13.0}}}
    let SegmentOn = ButtonFlat{width: Fill height: 36 padding: 4
        draw_bg +: {color: selected color_hover: pressed color_down: selected color_focus: selected color_disabled: well border_radius: 6.0 border_size: 0.0}
        draw_text +: {color: ink color_hover: ink color_down: ink color_focus: ink color_disabled: faint text_style: theme.font_bold{font_size: 13.0}}}
    let Entry = TextInput{width: Fill height: 44
        draw_bg +: {color: well color_hover: well_hover color_focus: well_hover color_down: well_hover color_empty: well color_disabled: well border_color: border border_color_hover: border_hover border_color_focus: blue border_color_down: blue border_color_empty: border border_color_disabled: border border_size: 1.0 border_radius: 6.0}
        draw_text +: {color: ink color_hover: ink color_focus: ink color_down: ink color_disabled: faint color_empty: faint color_empty_hover: muted color_empty_focus: muted}}
    let SearchEntry = TextInput{width: Fill height: Fill
        draw_bg +: {color: #x00000000 color_hover: #x00000000 color_focus: #x00000000 color_down: #x00000000 color_empty: #x00000000 border_size: 0.0}
        draw_text +: {color: ink color_hover: ink color_focus: ink color_down: ink color_disabled: faint color_empty: faint color_empty_hover: muted color_empty_focus: muted}}
    let SearchBox = RoundedView{width: Fill height: 44 flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 12 right: 8} spacing: 8
        draw_bg +: {color: well border_color: border border_size: 1.0 border_radius: 6.0}
        Image{width: 20 height: 20 src: http_resource(assets + "/assets/ui/search.png") fit: ImageFit.Stretch}
    }
    let RowHit = ButtonFlat{width: Fill height: Fill text: "" padding: 0 margin: 0
        draw_bg +: {color: #x00000000 color_hover: #x9d90f214 color_down: #x9d90f229 color_focus: #x00000000 color_disabled: #x00000000 border_size: 0.0 border_radius: 8.0}}
    let RemoveHit = ButtonFlat{width: 26 height: 26 text: "×" padding: 0
        draw_bg +: {color: selected color_hover: remove_hover color_down: remove_down color_focus: selected border_size: 0.0 border_radius: 13.0}
        draw_text +: {color: ink color_hover: ink color_down: ink color_focus: ink text_style: theme.font_bold{font_size: 17}}}
    let NavHit = ButtonFlat{width: Fill height: Fill text: "" padding: 0 margin: 0
        draw_bg +: {color: #x00000000 color_hover: #x9d90f214 color_down: #x9d90f229 color_focus: #x00000000 color_disabled: #x00000000 border_size: 0.0 border_radius: 8.0}}
    let Link = ButtonFlat{width: Fit height: 36
        draw_bg +: {color: #x00000000 color_hover: #x9d90f214 color_down: #x9d90f229 color_focus: #x00000000 color_disabled: #x00000000 border_size: 0.0 border_radius: 6.0}
        draw_text +: {color: accent color_hover: accent color_down: accent color_focus: accent color_disabled: faint}}
    let BackButton = ButtonFlat{width: 40 height: 40 text: "" padding: 0 margin: 0
        draw_bg +: {border_color: accent color: #x00000000 color_hover: #x9d90f214 color_down: #x9d90f229 color_focus: #x9d90f214 color_disabled: #x00000000
            pixel: fn(){
                let sdf = Sdf2d.viewport(self.pos * self.rect_size)
                sdf.box(0.0, 0.0, self.rect_size.x, self.rect_size.y, 8.0)
                sdf.fill(self.color.mix(self.color_focus, self.focus).mix(self.color_hover, self.hover).mix(self.color_down, self.down).mix(self.color_disabled, self.disabled))
                let c = self.rect_size * 0.5
                sdf.move_to(c.x + 3.5, c.y - 7.0)
                sdf.line_to(c.x - 3.5, c.y)
                sdf.line_to(c.x + 3.5, c.y + 7.0)
                sdf.stroke(self.border_color, 2.4)
                return sdf.result
            }
        }
    }

    SolidView{width: Fill height: Fill flow: Down draw_bg.color: canvas

    if demo_mode {
        View{width: Fill height: 34 flow: Right align: Align{y: 0.5} padding: Inset{left: 14 right: 14} spacing: 8 draw_bg.color: soft
            Label{width: Fill text: "本地演示 · 虚构数据，退出后重置" draw_text.color: accent draw_text.text_style.font_size: 11}
            Link{text: "退出演示" on_click: || leave_demo()}
        }
    }
    if authorization != nil {
        View{width: Fill height: Fill flow: Down spacing: 12 padding: 12
            View{width: Fill height: 48 flow: Right align: Align{y: 0.5} spacing: 12
                BackButton{on_click: || cancel_authorization()}
                Label{text: if authorization.purpose == "login" {"账号授权"} else {if authorization.purpose == "email" {"修改邮箱"} else {"修改手机号"}} draw_text.color: ink draw_text.text_style.font_size: 17}
            }
            auth_reader := WebReader{width: Fill height: Fill on_error: || { auth_message = "授权网页加载失败，请检查连接后重试。"; refresh() }}
            Label{width: Fill text: auth_message draw_text.color: muted draw_text.text_style.font_size: 12}
            Secondary{text: "重新打开网页" on_click: || open_authorization_page()}
        }
    } else if auth_state != "signed_in" {
        ScrollYView{width: Fill height: Fill flow: Down padding: Inset{left: 16 right: 16 top: 80 bottom: 24} spacing: 14 align: Align{x: 0.5}
            Card{padding: 24 spacing: 12
                Label{text: "欢迎来到礼遇" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 22}}
                Label{text: "猜得到的心意。登录或注册后继续。" draw_text.color: muted draw_text.text_style.font_size: 13}
                Label{width: Fill text: auth_message draw_text.color: accent draw_text.text_style.font_size: 12}
                if auth_state == "signed_out" { Primary{width: Fill text: if account_busy {"请稍候…"} else {"登录或注册"} on_click: || sign_in()} }
                if auth_state == "error" { Secondary{width: Fill text: "重试连接" on_click: || check_auth()} }
                Secondary{width: Fill text: "本地演示" on_click: || enter_demo()}
                Label{width: Fill text: "无需服务器 · 使用虚构用户与数据" draw_text.color: faint draw_text.text_style.font_size: 11}
            }
        }
    } else {
    View{width: Fill height: Fill flow: Right
    if desktop_mode {
        View{width: 208 height: Fill flow: Down padding: Inset{left: 12 right: 12 top: 20 bottom: 14} spacing: 6 draw_bg.color: bar
            View{width: Fill height: Fit flow: Down padding: Inset{left: 6 bottom: 16} spacing: 2
                Label{text: "礼遇 LiYu" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                Label{text: "猜得到的心意" draw_text.color: muted draw_text.text_style.font_size: 12.5}
            }
            for nav in [{id: "discover", name: "挑礼", icon: "gift"}, {id: "box", name: "礼盒", icon: "box"}, {id: "pact", name: "约定", icon: "pact"}, {id: "contacts", name: "熟人", icon: "contacts"}, {id: "me", name: "我", icon: "me"}] {
                View{width: Fill height: 48 flow: Overlay
                    RoundedView{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 14 right: 10} spacing: 12 draw_bg +: {color: if tab == nav.id {soft} else {bar} border_radius: 8.0}
                        Image{width: 21 height: 21 src: http_resource(assets + "/assets/ui/nav-" + nav.icon + if tab == nav.id {"-on.png"} else {".png"}) fit: ImageFit.Stretch}
                        Label{text: nav.name draw_text.color: if tab == nav.id {accent} else {muted} draw_text.text_style.font_size: 14}
                    }
                    NavHit{on_click: || go(nav.id)}
                }
            }
            View{width: Fill height: Fill}
            if account != nil { Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: account.display_name draw_text.color: muted draw_text.text_style.font_size: 12} }
        }
    }
    View{width: Fill height: Fill flow: Down
    View{width: Fill height: 58 flow: Right align: Align{x: 0.5 y: 0.5} padding: Inset{left: 12 right: 12} draw_bg.color: bar
        View{width: if desktop_mode {140} else {54} height: Fill align: Align{x: 0.0 y: 0.5}
            if stage != "browse" || (tab == "discover" && (shop_origin_contact_id >= 0 || wish_shop_id >= 0 || gift_replacing_product)) || (tab == "box" && box_origin_tab != "") || (tab == "command" && command_browse_origin_tab != "") {
                BackButton{on_click: || back()}
            }
            if stage == "browse" && tab == "wishes" { BackButton{on_click: || back()} }
        }
        View{width: Fill height: Fill align: Align{x: 0.5 y: 0.5}
            if tab == "discover" && stage == "browse" { Label{text: "挑礼" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "discover" && stage == "detail" { Label{text: "商品详情" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "box" && stage == "browse" { Label{text: "礼盒" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "box" && stage == "gift_detail" { Label{text: if gift_side == "inbox" && gift_is_unwrapped(gift_detail) {"礼物详情"} else {"礼盒详情"} draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if stage == "contract_status" { Label{text: "约定状态" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "box" && stage == "gift_product_detail" { Label{text: "商品详情" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "pact" && stage == "browse" { Label{text: "约定" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "contacts" && stage == "browse" { Label{text: "熟人" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "contacts" && stage == "contact_detail" { Label{text: "熟人详情" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "contacts" && stage == "contact_profile" { Label{text: "详细资料" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "contacts" && stage == "contact_edit" { Label{text: "编辑" + friend_field_name(friend_edit_field) draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "contacts" && stage == "tags" { Label{text: "熟人标签" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "contacts" && stage == "tag_manage" { Label{text: "管理标签" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "contacts" && stage == "tag_people" { Label{text: if tag_selected_id < 0 {"未设置标签的熟人"} else {tag_by_id(tag_selected_id).name} draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "contacts" && stage == "tag_members_edit" { Label{text: "设置标签成员" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "contacts" && stage == "tag_batch_select" { Label{text: "选择熟人" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "contacts" && stage == "tag_batch_choose" { Label{text: "选择标签" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "contacts" && stage == "tag_new" { Label{text: "新建标签" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "contacts" && stage == "tag_edit" { Label{text: "编辑标签" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "contacts" && stage == "contact_tags" { Label{text: "设置标签" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "contacts" && stage == "contact_section" { Label{text: if contact_section_kind == "wishes" {"TA 的心愿单"} else {if contact_section_kind == "sent" {"我送 TA 的礼盒"} else {"TA 送我的礼物"}} draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "contacts" && stage == "contact_wish_detail" { Label{text: "心愿单" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "me" && stage == "browse" { Label{text: "我" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "me" && stage == "profile" { Label{text: "个人资料" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "me" && stage == "profile_edit" { Label{text: "修改显示名" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "me" && stage == "address_edit" { Label{text: if address_edit_id < 0 {"添加收货地址"} else {"编辑收货地址"} draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "me" && stage == "address_delete" { Label{text: "删除收货地址" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "me" && stage == "wallet" { Label{text: "我的钱包" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "me" && stage == "settings" { Label{text: "设置" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "me" && stage == "about" { Label{text: "关于礼遇" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "wishes" && stage == "browse" { Label{text: "我的心愿单" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "wishes" && stage == "wish_detail" { Label{text: "心愿单" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if stage == "wish_pick" { Label{text: "加入心愿单" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if stage == "wish_new" { Label{text: "新建心愿单" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if stage == "wish_add_vague" { Label{text: "填写商品需求" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "wishes" && stage == "wish_edit" { Label{text: if wish_publish_mode {"发布心愿单"} else {"编辑心愿单"} draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "wishes" && stage == "wish_confirm_close" { Label{text: "提前结束" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "wishes" && stage == "wish_confirm_delete" { Label{text: "删除心愿单" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "command" && stage == "browse" { Label{text: "一句话开始" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "command" && stage == "draft" && draft_kind == "wish" { Label{text: "发布心愿单" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
        if (tab == "command" && stage == "audience") || (tab == "wishes" && stage == "wish_audience") { Label{text: "谁可以看" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "command" && stage == "draft" && draft_kind == "gift" { Label{text: "设置礼盒" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "command" && stage == "recipient" { Label{text: "选择熟人" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
            if tab == "command" && stage == "checkout" { Label{text: "确认订单" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}} }
        }
        View{width: if desktop_mode {140} else {54} height: Fill flow: Right align: Align{x: 1.0 y: 0.5} spacing: 4
            if tab == "discover" && stage == "browse" && shop_side == "wish" { Link{height: 34 text: "新建心愿单" draw_text.text_style.font_size: 12 on_click: || begin("wish", -1)} }
            if tab == "box" && stage == "browse" { Link{height: 34 text: "挑礼" draw_text.text_style.font_size: 12 on_click: || begin("gift", -1)} }
            if tab == "wishes" && stage == "browse" { Link{height: 34 text: "＋ 新建" draw_text.text_style.font_size: 12 on_click: || begin("wish", -1)} }
        }
    }
    View{width: Fill height: Fill flow: Down
        if notice != "" { Label{width: Fill height: Fit margin: Inset{left: 16 right: 16 top: 4 bottom: 4} text: notice draw_text.color: accent draw_text.text_style.font_size: 12} }
        if tab == "discover" && stage == "browse" {
            ScrollYView{width: Fill height: Fill flow: Down padding: Inset{left: 16 right: 16 top: 10 bottom: 12} spacing: 14
                RoundedView{width: Fill height: Fit flow: Right padding: 4 spacing: 4 draw_bg +: {color: well border_radius: 8.0}
                    if shop_side == "shop" { SegmentOn{text: "挑商品" on_click: || {shop_side = "shop"; refresh()}} } else { Segment{text: "挑商品" on_click: || {shop_side = "shop"; refresh()}} }
                    if shop_side == "wish" { SegmentOn{text: "熟人的心愿单" on_click: || {shop_side = "wish"; shop_origin_contact_id = -1; refresh()}} } else { Segment{text: "熟人的心愿单" on_click: || {shop_side = "wish"; shop_origin_contact_id = -1; refresh()}} }
                }
                if shop_side == "shop" {
                    if wish_shop_id >= 0 { Label{width: Fill text: "正在为「" + wish_shop_title + "」挑选商品" draw_text.color: accent draw_text.text_style.font_size: 12} }
                    View{width: Fill height: Fit flow: Right{wrap: true} wrap_spacing: 8 spacing: 8
                        for i in categories.len() {
                            if category_index == i { ChipOn{text: categories[i].name on_click: || {category_index = i; refresh()}} }
                            else { Chip{text: categories[i].name on_click: || {category_index = i; refresh()}} }
                        }
                    }
                    if products.len() == 0 { Label{text: "正在读取商品目录…" draw_text.color: muted} }
                    View{width: Fill height: Fit flow: Right{wrap: true} wrap_spacing: 12 spacing: 12
                        for i in products.len() { if visible_product(products[i]) {
                            View{width: 181 height: Fit flow: Overlay
                                RoundedView{width: 181 height: Fit flow: Down padding: 8 spacing: 3 draw_bg +: {color: surface border_color: border border_size: 1.0 border_radius: 8.0}
                                    Image{width: 165 height: 165 src: http_resource(product_image(products[i])) fit: ImageFit.CropToFill}
                                    Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: products[i].name draw_text.color: ink draw_text.text_style.font_size: 13.5}
                                    Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: products[i].brand draw_text.color: faint draw_text.text_style.font_size: 11.5}
                                    View{width: Fill height: Fit flow: Right align: Align{x: 0.0 y: 0.5}
                                        Label{width: Fill text: money(products[i].price_cents) draw_text.color: accent draw_text.text_style.font_size: 15}
                                        if products[i].physical { Label{text: "实物" draw_text.color: muted draw_text.text_style.font_size: 11} }
                                        else { Label{text: "电子券" draw_text.color: muted draw_text.text_style.font_size: 11} }
                                    }
                                }
                                RowHit{on_click: || choose_product(i)}
                            }
                        } }
                    }
                }
                if shop_side == "wish" {
                    View{width: Fill height: 84 flow: Overlay
                        Card{height: Fill padding: 0 spacing: 0
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 18 right: 18} spacing: 10
                                RoundedView{width: 38 height: 38 align: Align{x: 0.5 y: 0.5} draw_bg +: {color: soft border_radius: 8.0} Label{text: "♡" draw_text.color: accent draw_text.text_style.font_size: 19}}
                                View{width: Fill height: Fit flow: Down spacing: 3
                                    Label{text: "我的心愿单" draw_text.color: ink draw_text.text_style.font_size: 15}
                                    Label{text: my_wishes.len() + " 份心愿单" draw_text.color: faint draw_text.text_style.font_size: 12}
                                }
                                Label{text: "›" draw_text.color: faint draw_text.text_style.font_size: 21}
                            }
                        }
                        RowHit{on_click: || open_wishes()}
                    }
                    Label{text: "熟人的心愿单" draw_text.color: muted draw_text.text_style: theme.font_bold{font_size: 13}}
                    if friend_wishes.len() == 0 { Card{padding: 20 Label{text: "暂无可见的熟人心愿单" draw_text.color: faint}} }
                    for w in friend_wishes {
                        let wd = preview_by_id(w.id)
                        View{width: Fill height: Fit flow: Overlay
                            Card{padding: 14 spacing: 10
                                View{width: Fill height: Fit flow: Right align: Align{x: 0.0 y: 0.5} spacing: 10
                                    RoundedView{width: 36 height: 36 align: Align{x: 0.5 y: 0.5} draw_bg +: {color: soft border_radius: 8.0} Label{text: initial(w.owner.display_name) draw_text.color: accent draw_text.text_style.font_size: 15}}
                                    View{width: Fill height: Fit flow: Down spacing: 2
                                        Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: w.title draw_text.color: ink draw_text.text_style.font_size: 15}
                                        Label{text: w.owner.display_name + " · " + w.event_on draw_text.color: faint draw_text.text_style.font_size: 12}
                                    }
                                    Label{text: occasion_name(w.occasion) draw_text.color: accent draw_text.text_style.font_size: 11}
                                }
                                if wd != nil {
                                    View{width: Fill height: Fit flow: Right spacing: 8
                                        for i in wd.items.len() { if i < 5 {
                                            let p = product_for_item(wd.items[i])
                                            if p != nil { Image{width: 52 height: 52 src: http_resource(product_image(p)) fit: ImageFit.CropToFill} }
                                        } }
                                    }
                                    Label{text: "商品清单 · " + wd.items.len() + " 项 · 还有 " + open_wish_count(wd) + " 项未认领" draw_text.color: muted draw_text.text_style.font_size: 12.5}
                                }
                            }
                            RowHit{on_click: || {tab = "wishes"; wishes_origin_tab = ""; choose_wish(w.id); wish_detail_from_discover = true}}
                        }
                    }
                    Label{width: Fill text: "收到礼盒就能看到商品信息；送礼人身份在拆开礼盒后揭晓。" draw_text.color: faint draw_text.text_style.font_size: 12}
                }
            }
        }
        if tab == "discover" && stage == "detail" && selected_product >= 0 {
            let p = products[selected_product]
            ScrollYView{width: Fill height: Fill flow: Down padding: Inset{left: 16 right: 16 top: 10 bottom: 16} spacing: 14
                Image{width: Fill height: 360 src: http_resource(product_image(p)) fit: ImageFit.CropToFill}
                View{width: Fill height: Fit flow: Down spacing: 5
                    Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: p.name draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                    View{width: Fill height: Fit flow: Right align: Align{x: 0.0 y: 0.0} padding: Inset{bottom: 6} spacing: 9
                        Label{text: money(p.price_cents) draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 20}}
                        Label{width: Fill max_lines: 1 text_overflow: Ellipsis margin: Inset{top: 10} text: product_meta(p) draw_text.color: faint draw_text.text_style.font_size: 11.5}
                    }
                }
                View{width: Fill height: Fit flow: Right spacing: 8
                    Primary{width: Fill text: "送给TA" on_click: || gift_selected_product()}
                    Secondary{width: Fill text: "加入心愿单" on_click: || open_wish_picker(selected_product)}
                }
                Card{padding: 14 spacing: 10
                    Label{text: "商品介绍" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                    Label{width: Fill text: p.description draw_text.color: muted draw_text.text_style.font_size: 14.5}
                    Label{text: "规格  " + p.spec draw_text.color: muted draw_text.text_style.font_size: 13}
                    if p.physical { Label{text: "类型  实物商品" draw_text.color: muted draw_text.text_style.font_size: 13} }
                    else { Label{text: "类型  电子商品" draw_text.color: muted draw_text.text_style.font_size: 13} }
                }
                Card{padding: 14 spacing: 7
                    Label{text: "送礼提示" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                    Label{width: Fill text: "收礼人可以看到商品信息；选择「猜我是谁」时，猜对送礼人才能拆开礼盒。" draw_text.color: muted draw_text.text_style.font_size: 13}
                }
                Label{text: "同类还有" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                View{width: Fill height: Fit flow: Right{wrap: true} wrap_spacing: 12 spacing: 12
                    for i in products.len() { if i != selected_product && products[i].category == p.category {
                        View{width: 181 height: Fit flow: Overlay
                            Card{width: 181 padding: 8 spacing: 4
                                Image{width: 165 height: 165 src: http_resource(product_image(products[i])) fit: ImageFit.CropToFill}
                                Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: products[i].name draw_text.color: ink draw_text.text_style.font_size: 13.5}
                                Label{text: money(products[i].price_cents) draw_text.color: accent draw_text.text_style.font_size: 15}
                            }
                            RowHit{on_click: || choose_product(i)}
                        }
                    } }
                }
            }
        }
        if tab == "box" && stage == "browse" {
            ScrollYView{width: Fill height: Fill flow: Down padding: Inset{left: 16 right: 16 top: 10 bottom: 16} spacing: 14
                RoundedView{width: Fill height: Fit flow: Right padding: 4 spacing: 4 draw_bg +: {color: well border_radius: 8.0}
                    if gift_side == "inbox" { SegmentOn{text: "收到的" on_click: || set_gift_side("inbox")} } else { Segment{text: "收到的" on_click: || set_gift_side("inbox")} }
                    if gift_side == "outbox" { SegmentOn{text: "送出的" on_click: || set_gift_side("outbox")} } else { Segment{text: "送出的" on_click: || set_gift_side("outbox")} }
                }
                Card{padding: 0 spacing: 2
                    if gift_side == "inbox" && inbox.len() == 0 { Label{text: "暂无收到的礼盒" draw_text.color: faint} }
                    if gift_side == "outbox" && outbox.len() == 0 { Label{text: "暂无送出的礼盒" draw_text.color: faint} }
                    if gift_side == "inbox" { for g in inbox {
                        View{width: Fill height: 100 flow: Overlay
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 14 right: 14} spacing: 10
                                let p = gift_product(g)
                                if p != nil { Image{width: 44 height: 44 src: http_resource(product_image(p)) fit: ImageFit.CropToFill} }
                                View{width: Fill height: Fit flow: Down spacing: 3
                                    if p != nil { Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: p.name draw_text.color: ink draw_text.text_style.font_size: 15} }
                                    else { Label{text: if gift_is_unwrapped(g) {"一份礼物"} else {"一个礼盒"} draw_text.color: ink draw_text.text_style.font_size: 15} }
                                    if g.state == "sealed" || g.state == "opened" { Label{text: "送礼人待揭晓" draw_text.color: faint draw_text.text_style.font_size: 12} }
                                    else { Label{text: state_name(g.state) draw_text.color: faint draw_text.text_style.font_size: 12} }
                                    Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: "有效期至 " + expiry_time(g.expires_at) draw_text.color: faint draw_text.text_style.font_size: 11}
                                }
                                Label{text: state_name(g.state) draw_text.color: accent draw_text.text_style.font_size: 12}
                            }
                            RowHit{on_click: || choose_gift(g.id)}
                        }
                    } }
                    if gift_side == "outbox" { for g in outbox {
                        View{width: Fill height: 80 flow: Overlay
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 14 right: 14} spacing: 10
                                let p = product_by_id(g.product_id)
                                if p != nil { Image{width: 44 height: 44 src: http_resource(product_image(p)) fit: ImageFit.CropToFill} }
                                View{width: Fill height: Fit flow: Down spacing: 3
                                    if p != nil { Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: p.name draw_text.color: ink draw_text.text_style.font_size: 15} }
                                    Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: "送给 " + g.recipient.display_name + " · " + expiry_short(g.expires_at) + " 到期" draw_text.color: faint draw_text.text_style.font_size: 11.5}
                                }
                                Label{text: if g.state == "sealed" && !g.ready {"待完成礼盒设置"} else {state_name(g.state)} draw_text.color: accent draw_text.text_style.font_size: 12}
                            }
                            RowHit{on_click: || choose_gift(g.id)}
                        }
                    } }
                }
            }
        }
        if tab == "box" && stage == "gift_product_detail" && gift_detail != nil {
            let p = gift_product(gift_detail)
            ScrollYView{width: Fill height: Fill flow: Down padding: Inset{left: 16 right: 16 top: 10 bottom: 16} spacing: 14
                if p == nil { Card{padding: 20 Label{text: "商品信息暂不可用" draw_text.color: muted}} }
                if p != nil {
                    Image{width: Fill height: 320 src: http_resource(product_image(p)) fit: ImageFit.CropToFill}
                    View{width: Fill height: Fit flow: Down spacing: 6
                        Label{width: Fill text: p.name draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 20}}
                        Label{text: "商品参考价  " + money(p.price_cents) draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 18}}
                        Label{width: Fill text: product_meta(p) draw_text.color: faint draw_text.text_style.font_size: 12}
                    }
                    Card{padding: 16 spacing: 10
                        Label{text: "商品介绍" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}}
                        Label{width: Fill text: p.description draw_text.color: muted draw_text.text_style.font_size: 14}
                    }
                    Card{padding: 16 spacing: 9
                        Label{text: "商品参数" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}}
                        Label{text: "品牌  " + p.brand draw_text.color: muted draw_text.text_style.font_size: 13}
                        Label{text: if category_name(p.category) == p.kind {"类别  " + p.kind} else {"类别  " + category_name(p.category) + " · " + p.kind} draw_text.color: muted draw_text.text_style.font_size: 13}
                        Label{width: Fill text: "规格  " + p.spec draw_text.color: muted draw_text.text_style.font_size: 13}
                        Label{text: if p.physical {"类型  实物商品"} else {"类型  电子商品"} draw_text.color: muted draw_text.text_style.font_size: 13}
                    }
                }
            }
        }
        if tab == "box" && stage == "gift_detail" {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                if gift_detail == nil && gift_detail_error == "" { Label{text: "正在读取礼盒…" draw_text.color: faint} }
                if gift_detail == nil && gift_detail_error != "" {
                    Card{padding: 16 spacing: 12
                        Label{width: Fill text: gift_detail_error draw_text.color: muted draw_text.text_style.font_size: 14}
                        Secondary{width: Fill text: "重新加载" on_click: || {gift_detail_error = ""; get("/gifts/" + gift_detail_id, "gift_detail"); refresh()}}
                    }
                }
                if gift_detail != nil {
                    if gift_side == "outbox" {
                        let p = product_by_id(gift_detail.product_id)
                        Card{padding: 16 spacing: 13
                            View{width: Fill height: Fit flow: Right align: Align{x: 0.0 y: 0.5} spacing: 12
                                if p != nil { Image{width: 88 height: 88 src: http_resource(product_image(p)) fit: ImageFit.CropToFill} }
                                View{width: Fill height: Fit flow: Down spacing: 6
                                    if p != nil { Label{width: Fill max_lines: 2 text_overflow: Ellipsis text: p.name draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}} }
                                    Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: "送给 " + gift_detail.recipient.display_name draw_text.color: muted draw_text.text_style.font_size: 13}
                                    Label{text: if gift_detail.state == "sealed" && !gift_detail.ready {"待完成礼盒设置"} else {state_name(gift_detail.state)} draw_text.color: accent draw_text.text_style.font_size: 13}
                                }
                            }
                        }
                        Card{padding: 16 spacing: 11
                            Label{text: "礼盒信息" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                            Label{text: "收礼人  " + gift_detail.recipient.display_name draw_text.color: muted draw_text.text_style.font_size: 13}
                            Label{text: "礼盒金额  " + money(gift_detail.price_cents) draw_text.color: muted draw_text.text_style.font_size: 13}
                            Label{text: "有效期至  " + expiry_time(gift_detail.expires_at) draw_text.color: muted draw_text.text_style.font_size: 13}
                            Label{text: "礼盒编号  " + gift_detail.id draw_text.color: faint draw_text.text_style.font_size: 12}
                        }
                        if !gift_detail.ready && gift_detail.state == "sealed" {
                            Card{padding: 16 spacing: 10
                                Label{text: "完成礼盒设置后，TA 才能打开" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                                View{width: Fill height: Fit flow: Right{wrap: true} wrap_spacing: 4 spacing: 4
                                    for mode in [{id: "guess_who", name: "猜我是谁"}, {id: "question", name: "回答问题"}, {id: "free", name: "直接打开"}] {
                                        if draft_unlock == mode.id { ChipOn{text: mode.name on_click: || {draft_unlock = mode.id; refresh()}} }
                                        else { Chip{text: mode.name on_click: || {draft_unlock = mode.id; refresh()}} }
                                    }
                                }
                                if draft_unlock != "free" { clue_entry := Entry{empty_text: if draft_unlock == "guess_who" {"提示（可选）"} else {"题目"} text: draft_clue on_change: |v| draft_clue = v} }
                                if draft_unlock == "question" { answer_entry := Entry{empty_text: "正确答案" text: draft_answer on_change: |v| draft_answer = v} }
                                message_entry := Entry{empty_text: "想说的话（可选）" text: draft_message on_change: |v| draft_message = v}
                                if draft_error != "" { Label{text: draft_error draw_text.color: accent draw_text.text_style.font_size: 12} }
                                Primary{width: Fill text: "保存设置并允许开盒" on_click: || configure_outbox_gift()}
                            }
                        }
                        Card{padding: 16 spacing: 10
                            Label{text: "礼盒进度" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                            if gift_detail.state == "sealed" { Label{text: "等待 TA 打开礼盒" draw_text.color: muted draw_text.text_style.font_size: 13} }
                            if gift_detail.state == "opened" { Label{text: "TA 正在解谜" draw_text.color: muted draw_text.text_style.font_size: 13} }
                            if gift_detail.state == "revealed" { Label{text: "TA 已拆开礼盒" draw_text.color: muted draw_text.text_style.font_size: 13} }
                            if gift_detail.state == "handled" { Label{text: "TA 已收下礼物" draw_text.color: muted draw_text.text_style.font_size: 13} }
                            if gift_detail.state == "expired" { Label{text: "礼盒已过期退回" draw_text.color: muted draw_text.text_style.font_size: 13} }
                            if gift_detail.state == "withdrawn" { Label{text: "礼盒已撤回" draw_text.color: muted draw_text.text_style.font_size: 13} }
                            if p != nil && p.physical && gift_detail.state == "handled" {
                                if gift_detail.carrier_delivered { Label{text: "物流  已送达" draw_text.color: muted draw_text.text_style.font_size: 13} }
                                else { Label{text: "物流  待送达" draw_text.color: muted draw_text.text_style.font_size: 13} }
                                if gift_detail.recipient_confirmed { Label{text: "收礼确认  已确认" draw_text.color: muted draw_text.text_style.font_size: 13} }
                                else { Label{text: "收礼确认  待确认" draw_text.color: muted draw_text.text_style.font_size: 13} }
                            }
                        }
                        if gift_detail.contract_text != "" {
                            View{width: Fill height: Fit flow: Overlay
                                Card{padding: 16 spacing: 10
                                    View{width: Fill height: Fit flow: Right align: Align{x: 0.0 y: 0.5} spacing: 12
                                        Label{width: Fill text: "附带的约定" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                                        Label{text: if gift_detail.contract_status == nil {"尚未生效"} else {contract_state(gift_detail.contract_status)} draw_text.color: accent draw_text.text_style.font_size: 12}
                                    }
                                    Label{width: Fill text: gift_detail.contract_text draw_text.color: muted draw_text.text_style.font_size: 14}
                                }
                                RowHit{on_click: || open_contract_status(gift_detail.id, gift_detail.contract_text, gift_detail.contract_status, "outbox")}
                            }
                        }
                        if gift_detail.can_withdraw { Secondary{width: Fill text: "撤回未打开的礼盒" on_click: || gift_action("withdraw", {})} }
                    }
                    if gift_side == "inbox" {
                        View{width: Fill height: 156 flow: Overlay
                            Card{height: Fill padding: 14 flow: Right align: Align{x: 0.0 y: 0.5} spacing: 12
                                let p = gift_product(gift_detail)
                                if p != nil { Image{width: 96 height: 96 src: http_resource(product_image(p)) fit: ImageFit.CropToFill} }
                                View{width: Fill height: Fit flow: Down spacing: 3
                                    if p != nil { Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: p.name draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}} }
                                    else { Label{text: if gift_is_unwrapped(gift_detail) {"一份礼物"} else {"一个礼盒"} draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}} }
                                    if p != nil { Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: p.brand + " · " + p.spec draw_text.color: muted draw_text.text_style.font_size: 12} }
                                    View{width: Fill height: Fit flow: Right
                                        Label{width: Fill text: state_name(gift_detail.state) draw_text.color: accent draw_text.text_style.font_size: 12}
                                        Label{text: "商品详情  ›" draw_text.color: faint draw_text.text_style.font_size: 11}
                                    }
                                    if gift_detail.sender != nil { Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: "送礼人  " + gift_detail.sender.display_name draw_text.color: muted draw_text.text_style.font_size: 12} }
                                    else { Label{text: "送礼人待揭晓" draw_text.color: muted draw_text.text_style.font_size: 12} }
                                }
                            }
                            RowHit{on_click: || {stage = "gift_product_detail"; refresh()}}
                        }
                        if gift_detail.state == "sealed" || gift_detail.state == "opened" {
                            Card{padding: 16 spacing: 12
                                Label{text: "有效期至  " + expiry_time(gift_detail.expires_at) draw_text.color: muted draw_text.text_style.font_size: 13}
                                if gift_detail.clue != "" { Label{width: Fill text: gift_detail.clue draw_text.color: muted draw_text.text_style.font_size: 13} }
                                if gift_detail.state == "sealed" && gift_detail.ready { Primary{width: Fill text: "打开礼盒" on_click: || gift_action("open", {})} }
                                if gift_detail.state == "sealed" && !gift_detail.ready { Label{text: "送礼人正在设置礼盒，请稍后再打开。" draw_text.color: muted draw_text.text_style.font_size: 12} }
                                if gift_detail.state == "opened" {
                                    guess_entry := Entry{empty_text: if gift_detail.unlock_kind == "guess_who" {"猜猜送礼人姓名"} else {"输入问题答案"} text: guess on_change: |v| guess = v}
                                    Secondary{width: Fill text: "回答并拆盒" on_click: || gift_action("answer", {answer: guess})}
                                    if gift_detail.unlock_kind == "guess_who" {
                                        Secondary{width: Fill text: if ai_busy {"AI 正在分析…"} else {"AI 帮我分析线索"} on_click: || ask_sender_clue()}
                                        Label{width: Fill text: "点击 AI 会把这个礼盒的提示和至多 30 位熟人的名字发送给你配置的模型；它不知道真正答案。" draw_text.color: faint draw_text.text_style.font_size: 11}
                                    }
                                    if gift_detail.attempts_left == 0 { Label{text: "还没猜中，可以继续猜。" draw_text.color: muted draw_text.text_style.font_size: 12} }
                                    if ai_text != "" { Label{width: Fill text: ai_text draw_text.color: muted draw_text.text_style.font_size: 13} }
                                }
                            }
                        }
                        if gift_detail.state == "revealed" && gift_mode == "" {
                            Card{padding: 16 spacing: 9
                                View{width: Fill height: Fit flow: Right spacing: 9
                                    Secondary{width: Fill text: "卖了换钱" on_click: || {gift_mode = "cash"; refresh()}}
                                    Secondary{width: Fill text: if gift_detail.physical {"发货给我"} else {"领取卡券"} on_click: || {gift_mode = "shipping"; refresh()}}
                                }
                                View{width: Fill height: Fit flow: Right spacing: 9
                                    Secondary{width: Fill text: "兑换商品" on_click: || {gift_mode = "exchange"; refresh()}}
                                    Secondary{width: Fill text: "送给别人" on_click: || {gift_mode = "transfer"; refresh()}}
                                }
                            }
                        }
                        if gift_detail.state == "revealed" || gift_detail.state == "accepted" || gift_detail.state == "exchanged" || gift_detail.state == "cashed_out" || gift_detail.state == "transferred" || gift_detail.state == "forwarded" {
                            Card{padding: 16 spacing: 10
                                Label{text: "礼物信息" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                                Label{text: "礼物金额  " + money(gift_detail.price_cents) draw_text.color: muted draw_text.text_style.font_size: 13}
                                if gift_detail.message != "" { Label{width: Fill text: gift_detail.message draw_text.color: muted draw_text.text_style.font_size: 13} }
                                Label{text: "礼物编号  " + gift_detail.id draw_text.color: faint draw_text.text_style.font_size: 12}
                            }
                            if gift_detail.contract_text != "" {
                                View{width: Fill height: Fit flow: Overlay
                                    Card{padding: 16 spacing: 10
                                        View{width: Fill height: Fit flow: Right align: Align{x: 0.0 y: 0.5} spacing: 12
                                            Label{width: Fill text: "附带的约定" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                                            Label{text: if gift_detail.contract_status == nil {"尚未生效"} else {contract_state(gift_detail.contract_status)} draw_text.color: accent draw_text.text_style.font_size: 12}
                                        }
                                        Label{width: Fill text: gift_detail.contract_text draw_text.color: muted draw_text.text_style.font_size: 14}
                                    }
                                    RowHit{on_click: || open_contract_status(gift_detail.id, gift_detail.contract_text, gift_detail.contract_status, "inbox")}
                                }
                            }
                            if gift_detail.state == "revealed" && gift_mode == "cash" {
                                Card{padding: 16 spacing: 10
                                    Label{text: "卖了换钱" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                                    if recovery_quote != nil { Label{text: "平台回收价  " + money(recovery_quote.recovery_cents) draw_text.color: accent draw_text.text_style.font_size: 18} }
                                    Primary{width: Fill text: "确认卖出并存入钱包" on_click: || gift_action("cash-out", {})}
                                    Secondary{width: Fill text: "返回选择" on_click: || {gift_mode = ""; refresh()}}
                                }
                            }
                            if (gift_detail.state == "revealed" && gift_mode == "shipping") || (gift_detail.state == "exchanged" && gift_mode == "shipping") {
                                Card{padding: 16 spacing: 10
                                    Label{text: if gift_detail.physical {"发货给我"} else {"领取卡券"} draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                                    if gift_detail.physical {
                                        for a in addresses { Chip{text: a.recipient_name + " · " + a.phone on_click: || {recipient_name = a.recipient_name; recipient_phone = a.phone; recipient_address = a.address; refresh()}} }
                                        name_entry := Entry{empty_text: "收货人" text: recipient_name on_change: |v| recipient_name = v}
                                        phone_entry := Entry{empty_text: "手机号" text: recipient_phone on_change: |v| recipient_phone = v}
                                        address_entry := Entry{empty_text: "完整地址" text: recipient_address on_change: |v| recipient_address = v}
                                        Primary{width: Fill text: "提交收货信息" on_click: || gift_ship()}
                                    } else { Primary{width: Fill text: "确认领取卡券" on_click: || gift_action("accept", {agree: true})} }
                                    Secondary{width: Fill text: "返回选择" on_click: || {gift_mode = ""; refresh()}}
                                }
                            }
                            if gift_detail.state == "revealed" && gift_mode == "exchange" {
                                Card{padding: 16 spacing: 10
                                    Label{text: "兑换商品" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                                    if recovery_quote != nil { Label{text: "可抵扣  " + money(recovery_quote.recovery_cents) draw_text.color: accent draw_text.text_style.font_size: 16} }
                                    for p in products { if p.id != gift_detail.product_id {
                                        View{width: Fill height: 70 flow: Overlay
                                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 8 right: 8} spacing: 10
                                                Image{width: 48 height: 48 src: http_resource(product_image(p)) fit: ImageFit.CropToFill}
                                                View{width: Fill height: Fit flow: Down spacing: 2
                                                    Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: p.name draw_text.color: ink draw_text.text_style.font_size: 13}
                                                    Label{text: money(p.price_cents) draw_text.color: accent draw_text.text_style.font_size: 12}
                                                }
                                                Label{text: if exchange_product_id == p.id {"✓"} else {"○"} draw_text.color: accent draw_text.text_style.font_size: 18}
                                            }
                                            RowHit{on_click: || {exchange_product_id = p.id; refresh()}}
                                        }
                                    } }
                                    if exchange_product_id >= 0 && recovery_quote != nil { let chosen = product_by_id(exchange_product_id); if chosen != nil {
                                        Label{text: if recovery_quote.recovery_cents >= chosen.price_cents {"退回钱包 " + money(recovery_quote.recovery_cents - chosen.price_cents)} else {"需补差价 " + money(chosen.price_cents - recovery_quote.recovery_cents)} draw_text.color: accent draw_text.text_style.font_size: 14}
                                    } }
                                    Primary{width: Fill text: "确认兑换" on_click: || gift_exchange()}
                                    Secondary{width: Fill text: "返回选择" on_click: || {gift_mode = ""; refresh()}}
                                }
                            }
                            if gift_detail.state == "revealed" && gift_mode == "transfer" {
                                Card{padding: 16 spacing: 10
                                    Label{text: "送给别人" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                                    transfer_search_entry := Entry{empty_text: "搜索熟人" text: transfer_search on_change: |v| {transfer_search = v; refresh()}}
                                    for f in friends { if transfer_search.trim() == "" || f.display_name.search(transfer_search.trim()) >= 0 {
                                        View{width: Fill height: 44 flow: Overlay
                                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 8 right: 8}
                                                Label{width: Fill text: f.display_name draw_text.color: ink draw_text.text_style.font_size: 14}
                                                Label{text: if transfer_recipient_id == f.id {"✓"} else {"○"} draw_text.color: accent draw_text.text_style.font_size: 18}
                                            }
                                            RowHit{on_click: || {transfer_recipient_id = f.id; refresh()}}
                                        }
                                    } }
                                    Label{text: "有效期（小时，1–720）" draw_text.color: muted draw_text.text_style.font_size: 13}
                                    transfer_expiry_entry := Entry{text: transfer_expiry_hours on_change: |v| transfer_expiry_hours = v}
                                    View{width: Fill height: Fit flow: Right spacing: 8
                                        for mode in [{id: "guess_who", name: "猜我是谁"}, {id: "question", name: "回答问题"}, {id: "free", name: "直接打开"}] {
                                            if transfer_unlock == mode.id { ChipOn{text: mode.name on_click: || {transfer_unlock = mode.id; refresh()}} }
                                            else { Chip{text: mode.name on_click: || {transfer_unlock = mode.id; refresh()}} }
                                        }
                                    }
                                    if transfer_unlock != "free" { transfer_clue_entry := Entry{empty_text: "留一点提示或题目" text: transfer_clue on_change: |v| transfer_clue = v} }
                                    if transfer_unlock == "question" { transfer_answer_entry := Entry{empty_text: "问题答案" text: transfer_answer on_change: |v| transfer_answer = v} }
                                    Primary{width: Fill text: "确认转赠" on_click: || gift_transfer()}
                                    Secondary{width: Fill text: "返回选择" on_click: || {gift_mode = ""; refresh()}}
                                }
                            }
                            if gift_detail.state == "exchanged" && gift_mode == "" { Primary{width: Fill text: if gift_detail.physical {"填写收货信息"} else {"领取卡券"} on_click: || {gift_mode = "shipping"; refresh()}} }
                            if gift_detail.state == "accepted" && shipment != nil {
                                Card{padding: 16 spacing: 8
                                    Label{text: "物流信息" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                                    Label{text: shipment.carrier + "  " + shipment.tracking_number draw_text.color: muted draw_text.text_style.font_size: 13}
                                    for event in shipment.events { Label{text: event.at + "  " + event.description draw_text.color: muted draw_text.text_style.font_size: 12} }
                                    if shipment.carrier_delivered && !shipment.recipient_confirmed { Primary{width: Fill text: "确认收货" on_click: || mutate("/shipments/" + gift_detail.id + "/confirm-receipt", "POST", {}, |_data| {get("/shipments/" + gift_detail.id, "shipment")})} }
                                    if shipment.recipient_confirmed { Label{text: "已确认收货" draw_text.color: accent draw_text.text_style.font_size: 13} }
                                }
                            }
                            if gift_detail.state == "accepted" && !gift_detail.physical && gift_detail.voucher_code != nil { Card{padding: 16 spacing: 8 Label{text: "兑换码" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}} Label{text: gift_detail.voucher_code draw_text.color: accent draw_text.text_style.font_size: 18}} }
                            if gift_detail.state == "transferred" || gift_detail.state == "forwarded" { Card{padding: 16 spacing: 8
                                Label{text: state_name(gift_detail.state) draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                                Secondary{width: Fill text: "查看转赠礼盒" on_click: || {let id = gift_detail.transfer_child_id; gift_side = "outbox"; choose_gift(id)}}
                                if gift_detail.state == "transferred" { Secondary{width: Fill text: "刷新状态" on_click: || get("/gifts/" + gift_detail.id, "gift_detail")} }
                            } }
                            if gift_detail.state == "cashed_out" { Secondary{width: Fill text: "查看我的钱包" on_click: || {tab = "me"; stage = "wallet"; get("/wallet", "wallet"); refresh()}} }
                        }
                    }
                }
            }
        }
        if stage == "contract_status" {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Card{padding: 18 spacing: 14
                    Label{text: "当前状态" draw_text.color: muted draw_text.text_style.font_size: 13}
                    Label{text: if contract_edit_status == nil {"尚未生效"} else {contract_state(contract_edit_status)} draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 24}}
                    if contract_edit_status != nil {
                        Primary{width: Fill text: if contract_busy_id == contract_edit_id {"保存中…"} else {if contract_edit_status == "fulfilled" {"改为待兑现"} else {"标记已兑现"}} on_click: || toggle_contract(contract_edit_id, contract_edit_status)}
                    }
                }
                Card{padding: 16 spacing: 10
                    Label{text: "约定内容" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                    Label{width: Fill text: contract_edit_text draw_text.color: muted draw_text.text_style.font_size: 14}
                }
                if contract_edit_status == nil {
                    Label{width: Fill text: "收礼人同意约定并收下礼物后，双方即可各自记录兑现状态。" draw_text.color: faint draw_text.text_style.font_size: 12}
                } else {
                    Label{width: Fill text: "双方各自记录兑现状态。修改只影响你自己的记录，不会改变对方的状态；标记已兑现后，也可以改回待兑现。" draw_text.color: faint draw_text.text_style.font_size: 12}
                }
                if contract_origin_tab == "pact" {
                    Secondary{width: Fill text: if contract_edit_side == "inbox" {"查看礼物详情"} else {"查看礼盒详情"} on_click: || {gift_side = contract_edit_side; tab = "box"; box_origin_tab = ""; choose_gift(contract_edit_id); gift_from_pact = true}}
                }
            }
        }
        if tab == "pact" && stage == "browse" {
            ScrollYView{width: Fill height: Fill flow: Down padding: Inset{left: 16 right: 16 top: 10 bottom: 16} spacing: 14
                RoundedView{width: Fill height: Fit flow: Right padding: 4 spacing: 4 draw_bg +: {color: well border_radius: 8.0}
                    if pact_side == "mine" { SegmentOn{text: "我答应的" on_click: || {pact_side = "mine"; refresh()}} } else { Segment{text: "我答应的" on_click: || {pact_side = "mine"; refresh()}} }
                    if pact_side == "theirs" { SegmentOn{text: "答应我的" on_click: || {pact_side = "theirs"; refresh()}} } else { Segment{text: "答应我的" on_click: || {pact_side = "theirs"; refresh()}} }
                }
                Label{width: Fill text: "兑现状态由你自己标记，不影响对方的记录。" draw_text.color: faint draw_text.text_style.font_size: 12}
                Card{padding: 0 spacing: 2
                    if pact_count(pact_side) == 0 {
                        View{width: Fill height: 106 flow: Down align: Align{x: 0.5 y: 0.5} spacing: 8
                            Image{width: 28 height: 28 src: http_resource(assets + "/assets/ui/nav-pact.png") fit: ImageFit.Stretch}
                            if pact_side == "mine" { Label{text: "还没有答应的约定" draw_text.color: faint draw_text.text_style.font_size: 13} }
                            else { Label{text: "还没有别人答应的约定" draw_text.color: faint draw_text.text_style.font_size: 13} }
                        }
                    }
                    for c in contracts { if (pact_side == "mine" && c.mine) || (pact_side == "theirs" && !c.mine) {
                        View{width: Fill height: 90 flow: Overlay
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 14 right: 14} spacing: 10
                                RoundedView{width: 44 height: 44 align: Align{x: 0.5 y: 0.5} draw_bg +: {color: soft border_radius: 6.0} Label{text: "✓" draw_text.color: accent draw_text.text_style.font_size: 20}}
                                View{width: Fill height: Fit flow: Down spacing: 6
                                    View{width: Fill height: Fit flow: Right align: Align{x: 0.0 y: 0.5} spacing: 10
                                        Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: c.contract_text draw_text.color: ink draw_text.text_style.font_size: 15}
                                        Label{text: contract_state(c.status) draw_text.color: accent draw_text.text_style.font_size: 12}
                                    }
                                    Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: (if c.mine { "答应 " } else { "送给 " }) + c.peer_name + " · " + c.created_on draw_text.color: faint draw_text.text_style.font_size: 12}
                                }
                            }
                            RowHit{on_click: || open_contract_status(c.gift_id, c.contract_text, c.status, if c.mine {"inbox"} else {"outbox"})}
                        }
                    } }
                }
                Label{width: Fill text: "约定是收礼时答应的一件小事。逾期无惩罚，完成了记得标记。" draw_text.color: faint draw_text.text_style.font_size: 12}
            }
        }
        if tab == "contacts" && stage == "browse" {
            ScrollYView{width: Fill height: Fill flow: Down padding: Inset{left: 16 right: 16 top: 10 bottom: 16} spacing: 14
                SearchBox{contact_search_entry := SearchEntry{empty_text: "搜索熟人" text: contact_search on_change: |v| {contact_search = v; refresh()}}}
                for n in reminders { if n.type == "occasion" {
                    Card{padding: 12 spacing: 5
                        Label{text: n.title draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 14}}
                        Label{width: Fill text: n.body draw_text.color: muted draw_text.text_style.font_size: 12}
                    }
                } }
                View{width: Fill height: 68 flow: Overlay
                    Card{height: Fill padding: Inset{left: 16 right: 16} flow: Right align: Align{x: 0.0 y: 0.5} spacing: 12
                        RoundedView{width: 38 height: 38 align: Align{x: 0.5 y: 0.5} draw_bg +: {color: soft border_radius: 8.0}
                            Image{width: 26 height: 26 src: http_resource(assets + "/assets/ui/tag.png") fit: ImageFit.Stretch}
                        }
                        Label{width: Fill text: "标签" draw_text.color: ink draw_text.text_style.font_size: 15}
                        Label{text: friend_tags.len() + "  ›" draw_text.color: muted draw_text.text_style.font_size: 15}
                    }
                    RowHit{on_click: || open_tags()}
                }
                Card{padding: 0 spacing: 2
                    if friends.len() == 0 { Label{text: "暂无熟人" draw_text.color: faint} }
                    for i in friends.len() { if friend_matches(friends[i], contact_search) {
                        View{width: Fill height: 76 flow: Overlay
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 16 right: 16} spacing: 10
                                RoundedView{width: 36 height: 36 align: Align{x: 0.5 y: 0.5} draw_bg +: {color: soft border_radius: 18.0} Label{text: initial(friends[i].display_name) draw_text.color: accent draw_text.text_style.font_size: 17}}
                                View{width: Fill height: Fit flow: Down spacing: 2
                                    Label{text: friends[i].display_name draw_text.color: ink draw_text.text_style.font_size: 15}
                                    Label{text: if tag_names_for_friend(friends[i].id) == "" {"熟人"} else {tag_names_for_friend(friends[i].id)} draw_text.color: faint draw_text.text_style.font_size: 12}
                                }
                                Label{text: "›" draw_text.color: faint draw_text.text_style.font_size: 21}
                            }
                            RowHit{on_click: || choose_contact(i)}
                        }
                    } }
                }
            }
        }
        if tab == "contacts" && stage == "contact_detail" && contact_index >= 0 {
            let f = friends[contact_index]
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Card{padding: 16 spacing: 10
                    View{width: Fill height: Fit flow: Right align: Align{x: 0.0 y: 0.5} spacing: 12
                        RoundedView{width: 52 height: 52 align: Align{x: 0.5 y: 0.5} draw_bg +: {color: soft border_radius: 26.0}
                            Label{text: initial(f.display_name) draw_text.color: accent draw_text.text_style.font_size: 24}
                        }
                        View{width: Fill height: Fit flow: Down spacing: 3
                            Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: f.display_name draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                            if f.phone != "" { Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: f.phone draw_text.color: muted draw_text.text_style.font_size: 12} }
                            if f.email != "" { Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: f.email draw_text.color: muted draw_text.text_style.font_size: 12} }
                        }
                    }
                    View{width: Fill height: Fit flow: Right spacing: 8
                        Primary{text: "神秘送礼" on_click: || shop_for_contact()}
                        Secondary{text: "详细资料" on_click: || {stage = "contact_profile"; refresh()}}
                    }
                    Secondary{width: Fill text: if ai_busy {"AI 正在挑选…"} else {"AI 帮我挑礼"} on_click: || ask_gift_ideas()}
                    Label{width: Fill text: "点击后会把这位熟人的关系、纪念日、备注和部分在售商品发送给你配置的模型；建议仅供参考。" draw_text.color: faint draw_text.text_style.font_size: 11}
                    if ai_text != "" { Label{width: Fill text: ai_text draw_text.color: muted draw_text.text_style.font_size: 13} }
                }
                View{width: Fill height: 56 flow: Overlay
                    Card{height: Fill padding: Inset{left: 16 right: 16} flow: Right align: Align{x: 0.0 y: 0.5} spacing: 10
                        Image{width: 22 height: 22 src: http_resource(assets + "/assets/ui/tag.png") fit: ImageFit.Stretch}
                        Label{width: Fill text: "标签" draw_text.color: ink draw_text.text_style.font_size: 14}
                        Label{max_lines: 1 text_overflow: Ellipsis text: if tag_names_for_friend(f.id) == "" {"设置标签"} else {tag_names_for_friend(f.id)} draw_text.color: muted draw_text.text_style.font_size: 12}
                        Label{text: "›" draw_text.color: faint draw_text.text_style.font_size: 20}
                    }
                    RowHit{on_click: || {contact_tag_ids_draft = tags_for_friend(f.id); stage = "contact_tags"; refresh()}}
                }
                if friend_wish_count(f.id) > 0 {
                    Card{padding: 0 spacing: 2
                        let preview_count = 0
                        for w in friend_wishes { if w.owner.id == f.id && preview_count < 3 {
                            let preview = preview_by_id(w.id)
                            View{width: Fill height: 140 flow: Overlay
                                View{width: Fill height: Fill flow: Down padding: 18 spacing: 7
                                    View{width: Fill height: Fit flow: Right align: Align{x: 0.0 y: 0.5} spacing: 8
                                        View{width: Fill height: Fit flow: Down spacing: 3
                                            Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: w.title draw_text.color: ink draw_text.text_style.font_size: 15}
                                            Label{text: w.event_on draw_text.color: faint draw_text.text_style.font_size: 12}
                                        }
                                        Label{text: "›" draw_text.color: faint draw_text.text_style.font_size: 21}
                                    }
                                    if preview != nil {
                                        View{width: Fill height: 44 flow: Right spacing: 6
                                            let thumb_count = 0
                                            for item in preview.items { if thumb_count < 4 {
                                                let p = product_for_item(item)
                                                if p != nil { Image{width: 44 height: 44 src: http_resource(product_image(p)) fit: ImageFit.CropToFill} }
                                                thumb_count = thumb_count + 1
                                            } }
                                        }
                                    }
                                }
                                RowHit{on_click: || contact_wish(w.id, "contact_detail")}
                            }
                            preview_count = preview_count + 1
                        } }
                    }
                }
                Card{padding: 0 spacing: 2
                    for row in [{id: "wishes", name: "心愿单"}, {id: "sent", name: "我送 TA 的礼盒"}, {id: "received", name: "TA 送我的礼物"}] {
                        View{width: Fill height: 58 flow: Overlay
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 18 right: 18}
                                Label{width: Fill text: row.name draw_text.color: ink draw_text.text_style.font_size: 15}
                                Label{text: "›" draw_text.color: faint draw_text.text_style.font_size: 21}
                            }
                            RowHit{on_click: || contact_section(row.id)}
                        }
                    }
                }
            }
        }
        if tab == "contacts" && stage == "contact_profile" && contact_index >= 0 {
            let f = friends[contact_index]
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Card{padding: 0 spacing: 2
                    Label{margin: Inset{left: 18 top: 14 bottom: 5} text: "基本资料" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 13}}
                    View{width: Fill height: 56 flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 18 right: 18}
                        Label{width: Fill text: "账号姓名" draw_text.color: ink draw_text.text_style.font_size: 14}
                        Label{text: f.account_name draw_text.color: muted draw_text.text_style.font_size: 13}
                    }
                    for field in [{id: "nickname", name: "称呼"}, {id: "relationship", name: "关系"}, {id: "birthday", name: "生日"}, {id: "wedding_date", name: "结婚日期"}] {
                        View{width: Fill height: 56 flow: Overlay
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 18 right: 18} spacing: 8
                                Label{width: Fill text: field.name draw_text.color: ink draw_text.text_style.font_size: 14}
                                Label{max_lines: 1 text_overflow: Ellipsis text: if friend_field(f, field.id) == "" {"添加"} else {friend_field(f, field.id)} draw_text.color: muted draw_text.text_style.font_size: 13}
                                Label{text: "›" draw_text.color: faint draw_text.text_style.font_size: 20}
                            }
                            RowHit{on_click: || edit_friend(field.id)}
                        }
                    }
                }
                Card{padding: 0 spacing: 2
                    Label{margin: Inset{left: 18 top: 14 bottom: 5} text: "联系方式" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 13}}
                    for field in [{id: "phone", name: "手机号"}, {id: "email", name: "邮箱"}] {
                        View{width: Fill height: 56 flow: Overlay
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 18 right: 18} spacing: 8
                                Label{width: Fill text: field.name draw_text.color: ink draw_text.text_style.font_size: 14}
                                Label{max_lines: 1 text_overflow: Ellipsis text: if friend_field(f, field.id) == "" {"添加"} else {friend_field(f, field.id)} draw_text.color: muted draw_text.text_style.font_size: 13}
                                Label{text: "›" draw_text.color: faint draw_text.text_style.font_size: 20}
                            }
                            RowHit{on_click: || edit_friend(field.id)}
                        }
                    }
                }
                Card{padding: 0 spacing: 2
                    Label{margin: Inset{left: 18 top: 14 bottom: 5} text: "私人备注" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 13}}
                    View{width: Fill height: 72 flow: Overlay
                        View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 18 right: 18} spacing: 8
                            Label{width: Fill max_lines: 2 text_overflow: Ellipsis text: if f.note == "" {"添加备注"} else {f.note} draw_text.color: muted draw_text.text_style.font_size: 13}
                            Label{text: "›" draw_text.color: faint draw_text.text_style.font_size: 20}
                        }
                        RowHit{on_click: || edit_friend("note")}
                    }
                }
                Label{width: Fill text: "这里修改的是你保存的熟人资料，不会改动 TA 的账号或已验证联系方式。" draw_text.color: faint draw_text.text_style.font_size: 12}
            }
        }
        if tab == "contacts" && stage == "contact_edit" && contact_index >= 0 {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Card{padding: 16 spacing: 12
                    Label{text: friend_field_name(friend_edit_field) draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}}
                    friend_edit_entry := Entry{text: friend_edit_value on_change: |v| friend_edit_value = v}
                    Label{width: Fill text: if friend_edit_field == "birthday" || friend_edit_field == "wedding_date" {"使用 YYYY-MM-DD 格式；服务端会在每年提前 7 天及当天提醒。"} else {"仅保存在你的熟人资料中；清空后不显示。"} draw_text.color: faint draw_text.text_style.font_size: 12}
                }
                Primary{width: Fill text: "保存" on_click: || save_friend()}
            }
        }
        if tab == "contacts" && stage == "tags" {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 12
                SearchBox{tag_search_entry := SearchEntry{empty_text: "搜索标签或熟人" text: tag_search on_change: |v| {tag_search = v; refresh()}}}
                Card{padding: 0 spacing: 0
                    View{width: Fill height: 82 flow: Overlay
                        View{width: Fill height: Fill flow: Down padding: Inset{left: 18 right: 18 top: 12 bottom: 10} spacing: 4
                            Label{text: "未设置标签的熟人  (" + untagged_count() + ")" draw_text.color: ink draw_text.text_style.font_size: 15}
                            Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: "查看尚未分类的熟人" draw_text.color: faint draw_text.text_style.font_size: 12}
                        }
                        RowHit{on_click: || open_tag_people(-1)}
                    }
                }
                Card{padding: 0 spacing: 2
                    for tag in friend_tags { if tag_visible(tag) {
                        View{width: Fill height: 82 flow: Overlay
                            View{width: Fill height: Fill flow: Down padding: Inset{left: 18 right: 18 top: 12 bottom: 10} spacing: 4
                                Label{text: tag.name + "  (" + tag.member_count + ")" draw_text.color: ink draw_text.text_style.font_size: 15}
                                Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: if tag.member_count == 0 {"还没有熟人"} else {tag_preview(tag)} draw_text.color: faint draw_text.text_style.font_size: 12}
                            }
                            RowHit{on_click: || open_tag_people(tag.id)}
                        }
                    } }
                }
                View{width: Fill height: Fit flow: Right spacing: 10
                    Primary{width: Fill text: "＋ 新建标签" on_click: || open_tag_form("tags")}
                    Secondary{width: Fill text: "管理" on_click: || {stage = "tag_manage"; refresh()}}
                }
            }
        }
        if tab == "contacts" && stage == "tag_manage" {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 12
                SearchBox{tag_search_entry := SearchEntry{empty_text: "搜索标签" text: tag_search on_change: |v| {tag_search = v; refresh()}}}
                Card{padding: 0 spacing: 2
                    for tag in friend_tags { if tag_visible(tag) {
                        View{width: Fill height: 64 flow: Overlay
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 18 right: 18} spacing: 12
                                Label{text: "◯" draw_text.color: faint draw_text.text_style.font_size: 21}
                                Label{width: Fill text: tag.name + "  (" + tag.member_count + ")" draw_text.color: ink draw_text.text_style.font_size: 15}
                                Label{text: "编辑 ›" draw_text.color: muted draw_text.text_style.font_size: 12}
                            }
                            RowHit{on_click: || {tag_selected_id = tag.id; tag_name_value = tag.name; stage = "tag_edit"; refresh()}}
                        }
                    } }
                }
                Primary{width: Fill text: "＋ 新建标签" on_click: || open_tag_form("tag_manage")}
            }
        }
        if tab == "contacts" && (stage == "tag_new" || stage == "tag_edit") {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Card{padding: 16 spacing: 12
                    Label{text: "标签名称" draw_text.color: ink draw_text.text_style.font_size: 15}
                    tag_name_entry := Entry{empty_text: "例如：家人、同学、同事" text: tag_name_value on_change: |v| tag_name_value = v}
                    Label{text: "一个熟人可以属于多个标签。" draw_text.color: faint draw_text.text_style.font_size: 12}
                }
                if stage == "tag_new" { Primary{width: Fill text: "创建标签" on_click: || create_tag()} }
                else {
                    Primary{width: Fill text: "保存名称" on_click: || rename_tag()}
                    Secondary{width: Fill text: "删除标签" on_click: || delete_tag()}
                }
            }
        }
        if tab == "contacts" && stage == "tag_people" {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 12
                SearchBox{tag_people_search_entry := SearchEntry{empty_text: "搜索熟人" text: tag_people_search on_change: |v| {tag_people_search = v; refresh()}}}
                Label{text: if tag_selected_id < 0 {"未设置标签的熟人  (" + untagged_count() + ")"} else {tag_by_id(tag_selected_id).name + "  (" + tag_by_id(tag_selected_id).member_count + ")"} draw_text.color: muted draw_text.text_style.font_size: 13}
                Card{padding: 0 spacing: 2
                    for i in friends.len() { if friend_in_tag(friends[i].id) && friend_matches(friends[i], tag_people_search) {
                        View{width: Fill height: 76 flow: Overlay
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 16 right: 16} spacing: 12
                                RoundedView{width: 38 height: 38 align: Align{x: 0.5 y: 0.5} draw_bg +: {color: soft border_radius: 19.0} Label{text: initial(friends[i].display_name) draw_text.color: accent draw_text.text_style.font_size: 17}}
                                Label{width: Fill text: friends[i].display_name draw_text.color: ink draw_text.text_style.font_size: 15}
                                Label{text: "›" draw_text.color: faint draw_text.text_style.font_size: 21}
                            }
                            RowHit{on_click: || choose_contact(i)}
                        }
                    } }
                }
                Primary{width: Fill text: if tag_selected_id < 0 {"批量设置标签"} else {"管理成员"} on_click: || {
                    tag_people_search = ""
                    if tag_selected_id < 0 { tag_selected_friend_ids = []; batch_tag_ids = []; stage = "tag_batch_select" }
                    else { let tag = tag_by_id(tag_selected_id); tag_selected_friend_ids = tag.member_ids; stage = "tag_members_edit" }
                    refresh()
                }}
            }
        }
        if tab == "contacts" && (stage == "tag_members_edit" || stage == "tag_batch_select") {
            View{width: Fill height: Fill flow: Down
                ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 10
                    SearchBox{tag_people_search_entry := SearchEntry{empty_text: "搜索熟人" text: tag_people_search on_change: |v| {tag_people_search = v; refresh()}}}
                    Label{text: if stage == "tag_members_edit" {"可多选；每位熟人也可以在其他标签中。"} else {"选择要批量设置标签的熟人。"} draw_text.color: muted draw_text.text_style.font_size: 12}
                    Card{padding: 0 spacing: 2
                        for i in friends.len() { if friend_matches(friends[i], tag_people_search) && (stage == "tag_members_edit" || tags_for_friend(friends[i].id).len() == 0) {
                            View{width: Fill height: 66 flow: Overlay
                                View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 14 right: 14} spacing: 12
                                    Label{text: if has_id(tag_selected_friend_ids, friends[i].id) {"●"} else {"◯"} draw_text.color: if has_id(tag_selected_friend_ids, friends[i].id) {accent} else {faint} draw_text.text_style.font_size: 23}
                                    RoundedView{width: 36 height: 36 align: Align{x: 0.5 y: 0.5} draw_bg +: {color: soft border_radius: 18.0} Label{text: initial(friends[i].display_name) draw_text.color: accent draw_text.text_style.font_size: 16}}
                                    Label{width: Fill text: friends[i].display_name draw_text.color: ink draw_text.text_style.font_size: 14}
                                }
                                RowHit{on_click: || {tag_selected_friend_ids = toggle_id(tag_selected_friend_ids, friends[i].id); refresh()}}
                            }
                        } }
                    }
                }
                View{width: Fill height: Fit padding: 16 draw_bg.color: canvas
                    if stage == "tag_members_edit" { Primary{width: Fill text: "保存成员 (" + tag_selected_friend_ids.len() + ")" on_click: || save_tag_members()} }
                    else { Primary{width: Fill text: "设置标签 (" + tag_selected_friend_ids.len() + ")" on_click: || {if tag_selected_friend_ids.len() > 0 {stage = "tag_batch_choose"; refresh()}}} }
                }
            }
        }
        if tab == "contacts" && stage == "tag_batch_choose" {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Label{text: "已选 " + tag_selected_friend_ids.len() + " 位熟人，可同时加入多个标签" draw_text.color: muted draw_text.text_style.font_size: 13}
                Card{padding: 0 spacing: 2
                    for tag in friend_tags {
                        View{width: Fill height: 58 flow: Overlay
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 18 right: 18} spacing: 12
                                Label{text: if has_id(batch_tag_ids, tag.id) {"●"} else {"◯"} draw_text.color: if has_id(batch_tag_ids, tag.id) {accent} else {faint} draw_text.text_style.font_size: 23}
                                Label{width: Fill text: tag.name draw_text.color: ink draw_text.text_style.font_size: 15}
                            }
                            RowHit{on_click: || {batch_tag_ids = toggle_id(batch_tag_ids, tag.id); refresh()}}
                        }
                    }
                }
                Primary{width: Fill text: "完成" on_click: || {if batch_tag_ids.len() > 0 {batch_tag_friend(0)} else {notice = "请至少选择一个标签。"; refresh()}}}
            }
        }
        if tab == "contacts" && stage == "contact_tags" && contact_index >= 0 {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Label{text: friends[contact_index].display_name + " · 可选择多个标签" draw_text.color: muted draw_text.text_style.font_size: 13}
                Card{padding: 0 spacing: 2
                    for tag in friend_tags {
                        View{width: Fill height: 58 flow: Overlay
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 18 right: 18} spacing: 12
                                Label{text: if has_id(contact_tag_ids_draft, tag.id) {"●"} else {"◯"} draw_text.color: if has_id(contact_tag_ids_draft, tag.id) {accent} else {faint} draw_text.text_style.font_size: 23}
                                Label{width: Fill text: tag.name draw_text.color: ink draw_text.text_style.font_size: 15}
                            }
                            RowHit{on_click: || {contact_tag_ids_draft = toggle_id(contact_tag_ids_draft, tag.id); refresh()}}
                        }
                    }
                }
                Secondary{width: Fill text: "＋ 新建标签" on_click: || open_tag_form("contact_tags")}
                Primary{width: Fill text: "完成" on_click: || save_contact_tags()}
            }
        }
        if tab == "contacts" && stage == "contact_section" && contact_index >= 0 {
            let f = friends[contact_index]
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 12
                Card{padding: 0 spacing: 2
                    if contact_section_kind == "wishes" && friend_wish_count(f.id) == 0 { Label{margin: 20 text: "TA 还没有可见的心愿单" draw_text.color: faint} }
                    if contact_section_kind == "sent" && friend_gift_count(f.id, "sent") == 0 { Label{margin: 20 text: "还没有送给 TA 的礼盒" draw_text.color: faint} }
                    if contact_section_kind == "received" && friend_gift_count(f.id, "received") == 0 { Label{margin: 20 text: "还没有已揭晓由 TA 送来的礼物" draw_text.color: faint} }
                    if contact_section_kind == "wishes" { for w in friend_wishes { if w.owner.id == f.id {
                        View{width: Fill height: 76 flow: Overlay
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 18 right: 18}
                                View{width: Fill height: Fit flow: Down spacing: 3
                                    Label{text: w.title draw_text.color: ink draw_text.text_style.font_size: 15}
                                    Label{text: w.event_on + " · " + occasion_name(w.occasion) draw_text.color: faint draw_text.text_style.font_size: 12}
                                }
                                Label{text: "›" draw_text.color: faint draw_text.text_style.font_size: 21}
                            }
                            RowHit{on_click: || contact_wish(w.id, "contact_section")}
                        }
                    } } }
                    if contact_section_kind == "sent" { for g in outbox { if g.recipient.id == f.id {
                        View{width: Fill height: 76 flow: Overlay
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 18 right: 18} spacing: 10
                                let p = product_by_id(g.product_id)
                                if p != nil { Image{width: 44 height: 44 src: http_resource(product_image(p)) fit: ImageFit.CropToFill} }
                                View{width: Fill height: Fit flow: Down spacing: 3
                                    if p != nil { Label{text: p.name draw_text.color: ink draw_text.text_style.font_size: 15} }
                                    Label{text: state_name(g.state) draw_text.color: faint draw_text.text_style.font_size: 12}
                                }
                                Label{text: "›" draw_text.color: faint draw_text.text_style.font_size: 21}
                            }
                            RowHit{on_click: || contact_gift(g.id, "outbox")}
                        }
                    } } }
                    if contact_section_kind == "received" { for g in inbox { if g.sender != nil && g.sender.id == f.id {
                        View{width: Fill height: 76 flow: Overlay
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 18 right: 18} spacing: 10
                                let p = product_by_id(g.product_id)
                                if p != nil { Image{width: 44 height: 44 src: http_resource(product_image(p)) fit: ImageFit.CropToFill} }
                                View{width: Fill height: Fit flow: Down spacing: 3
                                    if p != nil { Label{text: p.name draw_text.color: ink draw_text.text_style.font_size: 15} }
                                    Label{text: state_name(g.state) draw_text.color: faint draw_text.text_style.font_size: 12}
                                }
                                Label{text: "›" draw_text.color: faint draw_text.text_style.font_size: 21}
                            }
                            RowHit{on_click: || contact_gift(g.id, "inbox")}
                        }
                    } } }
                }
            }
        }
        if stage == "wish_pick" {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                if wish_picker_product >= 0 { Card{padding: 14 flow: Right align: Align{x: 0.0 y: 0.5} spacing: 12
                    Image{width: 64 height: 64 src: http_resource(product_image(products[wish_picker_product])) fit: ImageFit.CropToFill}
                    View{width: Fill height: Fit flow: Down spacing: 5
                        Label{width: Fill text: products[wish_picker_product].name draw_text.color: ink draw_text.text_style.font_size: 15}
                        Label{text: money(products[wish_picker_product].price_cents) draw_text.color: accent draw_text.text_style.font_size: 13}
                    }
                } }
                Label{text: "选择一张心愿单" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                Label{width: Fill text: "发布前仅自己可见；可以继续添加商品，整理好再发布。" draw_text.color: faint draw_text.text_style.font_size: 12}
                if wish_lists_loading { Label{text: "正在读取心愿单…" draw_text.color: faint draw_text.text_style.font_size: 13} }
                if !wish_lists_loading && draft_wish_count() == 0 { Card{padding: 18 spacing: 7
                    Label{text: "没有可用的心愿单" draw_text.color: ink draw_text.text_style.font_size: 14}
                    Label{width: Fill text: "在下方新建一张，即可把这件商品放进去。" draw_text.color: faint draw_text.text_style.font_size: 12}
                } }
                for w in my_wishes { if w.status == "draft" {
                    View{width: Fill height: 82 flow: Overlay
                        Card{height: Fill padding: 16 spacing: 6
                            View{width: Fill height: Fit flow: Right spacing: 10
                                Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: w.title draw_text.color: ink draw_text.text_style.font_size: 15}
                                Label{text: if w.item_count >= 8 {"已满"} else {"加入 ›"} draw_text.color: accent draw_text.text_style.font_size: 12}
                            }
                            Label{text: w.item_count + "/8 项" draw_text.color: faint draw_text.text_style.font_size: 12}
                        }
                        RowHit{on_click: || add_product_to_wish(w.id)}
                    }
                } }
                Primary{width: Fill text: "＋ 新建心愿单" on_click: || start_wish_draft(true)}
            }
        }
        if stage == "wish_new" {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Card{padding: 16 spacing: 12
                    Label{text: "心愿单名称" draw_text.color: muted draw_text.text_style.font_size: 13}
                    Entry{empty_text: "例如：生日心愿" text: wish_new_title on_change: |v| wish_new_title = v}
                    Label{text: "说明（选填）" draw_text.color: muted draw_text.text_style.font_size: 13}
                    Entry{empty_text: "写一点心愿说明" text: wish_new_note on_change: |v| wish_new_note = v}
                }
                Label{width: Fill text: "可以逐件加入商品，整理好后再发布。发布前仅自己可见。" draw_text.color: faint draw_text.text_style.font_size: 12}
                Primary{width: Fill text: if wish_busy {"正在创建…"} else {if wish_new_from_picker {"创建心愿单并加入商品"} else {"创建心愿单"}} on_click: || create_wish_draft()}
            }
        }
        if stage == "wish_add_vague" {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Label{text: "想要哪一类" draw_text.color: ink draw_text.text_style.font_size: 15}
                View{width: Fill height: Fit flow: Right{wrap: true} wrap_spacing: 8 spacing: 8
                    for kind in ["咖啡", "电影", "甜点", "鲜花", "数码", "家居", "盲盒", "玩具"] {
                        if draft_vague_kind == kind { ChipOn{text: kind on_click: || {draft_vague_kind = kind; refresh()}} }
                        else { Chip{text: kind on_click: || {draft_vague_kind = kind; refresh()}} }
                    }
                }
                Label{text: "预算" draw_text.color: ink draw_text.text_style.font_size: 15}
                View{width: Fill height: Fit flow: Right{wrap: true} wrap_spacing: 8 spacing: 8
                    for budget in [{cents: 0, name: "不限"}, {cents: 10000, name: "¥100 以内"}, {cents: 30000, name: "¥300 以内"}, {cents: 50000, name: "¥500 以内"}, {cents: 100000, name: "¥1000 以内"}] {
                        if draft_budget_cents == budget.cents { ChipOn{text: budget.name on_click: || {draft_budget_cents = budget.cents; refresh()}} }
                        else { Chip{text: budget.name on_click: || {draft_budget_cents = budget.cents; refresh()}} }
                    }
                }
                Entry{empty_text: "有什么要求（选填）" text: draft_wants on_change: |v| draft_wants = v}
                Primary{width: Fill text: if wish_busy {"正在加入…"} else {"加入心愿单"} on_click: || add_vague_wish()}
            }
        }
        if tab == "wishes" && stage == "browse" {
            ScrollYView{width: Fill height: Fill flow: Down padding: Inset{left: 16 right: 16 top: 10 bottom: 16} spacing: 12
                if wish_lists_loading && my_wishes.len() == 0 { Card{padding: 20 Label{text: "正在读取心愿单…" draw_text.color: faint}} }
                if !wish_lists_loading && my_wishes.len() == 0 { Card{padding: 20 spacing: 8
                    Label{text: "还没有心愿单" draw_text.color: ink}
                    Label{width: Fill text: "先建一张心愿单，把喜欢的商品逐件放进来，整理好再发布。" draw_text.color: faint draw_text.text_style.font_size: 12}
                } }
                for w in my_wishes {
                    View{width: Fill height: Fit flow: Overlay
                        Card{padding: 14 spacing: 10
                            View{width: Fill height: Fit flow: Right spacing: 10 align: Align{x: 0.0 y: 0.5}
                                RoundedView{width: 36 height: 36 align: Align{x: 0.5 y: 0.5} draw_bg +: {color: soft border_radius: 8.0} Label{text: initial(w.owner.display_name) draw_text.color: accent draw_text.text_style.font_size: 17}}
                                View{width: Fill height: Fit flow: Down spacing: 2
                                    Label{text: w.title draw_text.color: ink draw_text.text_style.font_size: 15}
                                    Label{text: "商品清单 · " + w.item_count + " 项" draw_text.color: faint draw_text.text_style.font_size: 12}
                                    if w.status != "draft" { Label{text: "有效期至 " + expiry_time(w.expires_at) draw_text.color: faint draw_text.text_style.font_size: 11} }
                                }
                                Label{text: wishlist_state(w.status) draw_text.color: accent draw_text.text_style.font_size: 11}
                            }
                            Label{width: Fill text: w.note draw_text.color: muted draw_text.text_style.font_size: 12.5}
                        }
                        RowHit{on_click: || choose_wish(w.id)}
                    }
                }
            }
        }
        if (tab == "wishes" && stage == "wish_detail") || (tab == "contacts" && stage == "contact_wish_detail") {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                if wish_detail == nil { Label{text: "正在读取心愿单…" draw_text.color: faint} }
                if wish_detail != nil {
                    Card{padding: 14 spacing: 10
                        View{width: Fill height: Fit flow: Right align: Align{x: 0.0 y: 0.5} spacing: 12
                            RoundedView{width: 44 height: 44 align: Align{x: 0.5 y: 0.5} draw_bg +: {color: soft border_radius: 8.0} Label{text: initial(wish_detail.owner.display_name) draw_text.color: accent draw_text.text_style.font_size: 16}}
                            View{width: Fill height: Fit flow: Down spacing: 2
                                Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: wish_detail.title draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                                Label{text: wish_detail.owner.display_name + " · " + wish_detail.event_on draw_text.color: faint draw_text.text_style.font_size: 12}
                            }
                            Label{text: occasion_name(wish_detail.occasion) draw_text.color: accent draw_text.text_style.font_size: 12}
                        }
                        Label{width: Fill text: wish_detail.note draw_text.color: muted draw_text.text_style.font_size: 13}
                        if wish_detail.status != "draft" { Label{text: "有效期至 " + expiry_time(wish_detail.expires_at) draw_text.color: muted draw_text.text_style.font_size: 12} }
                        if wish_detail.status == "draft" { Label{text: "未发布 · 商品清单 " + wish_detail.items.len() + "/8 项 · 仅自己可见" draw_text.color: accent draw_text.text_style.font_size: 12.5} }
                        else { Label{text: "商品清单 · " + wish_detail.items.len() + " 项 · 还有 " + open_wish_count(wish_detail) + " 项未认领" draw_text.color: muted draw_text.text_style.font_size: 12.5} }
                        View{width: Fill height: 6 flow: Right spacing: 2
                            for item in wish_detail.items {
                                if item.status == "open" { RoundedView{width: Fill height: 6 draw_bg +: {color: selected border_radius: 3.0}} }
                                else { RoundedView{width: Fill height: 6 draw_bg +: {color: accent border_radius: 3.0}} }
                            }
                        }
                    }
                    if wish_detail.items.len() == 0 { Card{padding: 18 spacing: 6
                        Label{text: "还没有加入商品" draw_text.color: ink draw_text.text_style.font_size: 14}
                        Label{width: Fill text: "可以添加多件商品，也可以写下想要的种类。" draw_text.color: faint draw_text.text_style.font_size: 12}
                    } }
                    if wish_detail.items.len() > 0 { Card{padding: 6 spacing: 2
                        for item in wish_detail.items {
                            let p = product_for_item(item)
                            View{width: Fill height: 72 flow: Right align: Align{x: 0.0 y: 0.5} padding: 8 spacing: 10
                                if p != nil { Image{width: 52 height: 52 src: http_resource(product_image(p)) fit: ImageFit.CropToFill} }
                                View{width: Fill height: Fit flow: Down spacing: 3
                                    if p != nil && item.product_id != nil { Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: p.name draw_text.color: ink draw_text.text_style.font_size: 14} }
                                    if p != nil && item.product_id == nil { Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: item.kind + " · 商品需求" draw_text.color: ink draw_text.text_style.font_size: 14} }
                                    if p == nil { Label{text: if item.product_id == nil {item.kind + " · 商品需求"} else {"商品信息暂不可用"} draw_text.color: ink draw_text.text_style.font_size: 14} }
                                    Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: if wish_detail.status == "draft" {if item.wants == "" {"尚未发布"} else {item.wants}} else {wish_state_name(item.status)} draw_text.color: faint draw_text.text_style.font_size: 12}
                                }
                                if wish_detail.status == "draft" { Link{text: "移除" on_click: || remove_wish_item(item.id)} }
                                if p != nil && account != nil && wish_detail.owner.id != account.id && item.status == "open" { Secondary{text: "送给TA" on_click: || gift_wish_item(item)} }
                            }
                        }
                    }
                    }
                    if account != nil && wish_detail.owner.id == account.id {
                        if wish_detail.status == "draft" {
                            if wish_detail.items.len() < 8 { Primary{width: Fill text: "继续挑选商品" on_click: || shop_for_wish()} }
                            if wish_detail.items.len() < 8 { Secondary{width: Fill text: "填写商品需求" on_click: || start_vague_wish()} }
                            Primary{width: Fill text: "发布心愿单" on_click: || publish_wish()}
                            Secondary{width: Fill text: "编辑资料" on_click: || edit_wish()}
                        }
                        View{width: Fill height: Fit flow: Right{wrap: true} wrap_spacing: 8 spacing: 8
                            if wish_detail.is_open { Secondary{text: "编辑" on_click: || edit_wish()} }
                            if wish_detail.is_open { Secondary{text: "提前结束" on_click: || {stage = "wish_confirm_close"; refresh()}} }
                            Secondary{text: "删除" on_click: || {stage = "wish_confirm_delete"; refresh()}}
                        }
                    }
                }
            }
        }
        if tab == "wishes" && stage == "wish_edit" {
            View{width: Fill height: Fill flow: Down
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Label{text: "什么日子" draw_text.color: muted draw_text.text_style.font_size: 13}
                View{width: Fill height: Fit flow: Right{wrap: true} wrap_spacing: 8 spacing: 8
                    for o in [{id: "birthday", name: "生日"}, {id: "wedding", name: "结婚"}, {id: "housewarming", name: "乔迁"}, {id: "graduation", name: "毕业"}, {id: "baby", name: "宝宝"}, {id: "other", name: "其他"}] {
                        if edit_occasion == o.id { ChipOn{text: o.name on_click: || {edit_occasion = o.id; refresh()}} }
                        else { Chip{text: o.name on_click: || {edit_occasion = o.id; refresh()}} }
                    }
                }
                Label{text: "心愿单名称" draw_text.color: muted draw_text.text_style.font_size: 13}
                wish_edit_title := Entry{text: edit_title on_change: |v| edit_title = v}
                Label{text: "日子" draw_text.color: muted draw_text.text_style.font_size: 13}
                wish_edit_date := Entry{text: edit_date on_change: |v| edit_date = v}
                Label{text: "说明" draw_text.color: muted draw_text.text_style.font_size: 13}
                wish_edit_note := Entry{text: edit_note on_change: |v| edit_note = v}
                Label{text: if wish_detail.status == "draft" {"有效期从发布时开始计算"} else {"有效期至 " + expiry_time(wish_detail.expires_at)} draw_text.color: muted draw_text.text_style.font_size: 13}
                wish_edit_expiry := Entry{empty_text: "重新设置有效期（小时，留空则不变）" text: edit_expiry_hours on_change: |v| edit_expiry_hours = v}
                Label{text: "可设置 1–720 小时（最多 30 天）。" draw_text.color: faint draw_text.text_style.font_size: 12}
                Card{padding: 0 spacing: 0
                    View{width: Fill height: 62 flow: Overlay
                        View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 16 right: 16} spacing: 12
                            Label{text: "♙" draw_text.color: accent draw_text.text_style.font_size: 22}
                            Label{width: Fill text: "谁可以看" draw_text.color: ink draw_text.text_style.font_size: 15}
                            Label{text: audience_summary() draw_text.color: muted draw_text.text_style.font_size: 13}
                            Label{text: "›" draw_text.color: faint draw_text.text_style.font_size: 20}
                        }
                        RowHit{on_click: || {audience_search = ""; stage = "wish_audience"; refresh()}}
                    }
                }
            }
            View{width: Fill height: Fit padding: Inset{left: 16 right: 16 top: 8 bottom: 8} draw_bg.color: canvas
                Primary{width: Fill text: if wish_busy {"正在保存…"} else {if wish_publish_mode {"确认发布"} else {if wish_detail.status == "draft" {"保存资料"} else {"保存修改"}}} on_click: || save_wish_edit()}
            }
            }
        }
        if tab == "wishes" && stage == "wish_confirm_close" {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Card{padding: 16 spacing: 10
                    Label{text: "提前结束这份心愿单？" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                    Label{width: Fill text: "结束后熟人不能再认领其中的商品。" draw_text.color: muted draw_text.text_style.font_size: 13}
                }
                Primary{width: Fill text: "确认提前结束" on_click: || confirm_wish_action("close")}
                Secondary{width: Fill text: "取消" on_click: || {stage = "wish_detail"; refresh()}}
            }
        }
        if tab == "wishes" && stage == "wish_confirm_delete" {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Card{padding: 16 spacing: 10
                    Label{text: "删除这份心愿单？" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                    Label{width: Fill text: "删除后无法恢复这份心愿单。" draw_text.color: muted draw_text.text_style.font_size: 13}
                }
                Primary{width: Fill text: "确认删除" on_click: || confirm_wish_action("delete")}
                Secondary{width: Fill text: "取消" on_click: || {stage = "wish_detail"; refresh()}}
            }
        }
        if tab == "me" && stage == "browse" {
            ScrollYView{width: Fill height: Fill flow: Down padding: Inset{left: 16 right: 16 top: 10 bottom: 16} spacing: 14
                View{width: Fill height: Fit flow: Overlay
                    Card{padding: 16 spacing: 0
                        View{width: Fill height: Fit flow: Right align: Align{x: 0.0 y: 0.5} spacing: 14
                            if profile != nil { Image{width: 56 height: 56 src: http_resource(profile_image()) fit: ImageFit.CropToFill} }
                            else { RoundedView{width: 56 height: 56 align: Align{x: 0.5 y: 0.5} draw_bg +: {color: soft border_radius: 28.0}
                                Label{text: if account == nil {"?"} else {initial(account.display_name)} draw_text.color: accent draw_text.text_style.font_size: 23}
                            } }
                            View{width: Fill height: Fit flow: Down spacing: 2
                                if account == nil { Label{text: "正在读取账户…" draw_text.color: faint} }
                                if account != nil { Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: account.display_name draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}} }
                                if profile != nil && profile.email != nil && profile.email != "" { Label{width: Fill height: 24 max_lines: 1 text_overflow: Ellipsis text: "邮箱  " + profile.email draw_text.color: faint draw_text.text_style.font_size: 13} }
                                if profile != nil && profile.phone != nil && profile.phone != "" { Label{width: Fill height: 24 max_lines: 1 text_overflow: Ellipsis text: "手机  " + profile.phone draw_text.color: faint draw_text.text_style.font_size: 13} }
                            }
                        }
                    }
                    RowHit{on_click: || {stage = "profile"; refresh()}}
                }
                View{width: Fill height: Fit flow: Right spacing: 10
                    Card{width: Fill padding: 12 spacing: 2 Label{text: outbox.len() + "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}} Label{text: "送出" draw_text.color: faint draw_text.text_style.font_size: 12}}
                    Card{width: Fill padding: 12 spacing: 2 Label{text: inbox.len() + "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}} Label{text: "收到" draw_text.color: faint draw_text.text_style.font_size: 12}}
                }
                Card{padding: 0 spacing: 0
                    for row in [{id: "profile", name: "个人资料"}, {id: "wallet", name: "我的钱包"}] {
                        View{width: Fill height: 52 flow: Overlay
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 18 right: 18}
                                Label{width: Fill text: row.name draw_text.color: ink draw_text.text_style.font_size: 14}
                                Label{text: "›" draw_text.color: faint draw_text.text_style.font_size: 21}
                            }
                            RowHit{on_click: || {stage = row.id; if row.id == "wallet" { get("/wallet", "wallet") }; refresh()}}
                        }
                    }
                }
