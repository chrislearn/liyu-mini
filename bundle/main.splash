                else { if tab == "box" { go("box") } }
                if tab == "contacts" {
                    if stage == "contact_edit" { stage = "contact_profile"; refresh() }
                    else { if stage == "contact_profile" || stage == "contact_section" { stage = "contact_detail"; refresh() }
                    else { if stage == "contact_wish_detail" { stage = contact_wish_origin; refresh() }
                    else { go("contacts") } } }
                }
