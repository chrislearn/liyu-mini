                    for row in [{id: "wishes", name: "我的心愿单"}, {id: "inbox", name: "收到的礼盒"}, {id: "outbox", name: "送出的礼盒"}] {
                        View{width: Fill height: 52 flow: Overlay
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 18 right: 18}
                                Label{width: Fill text: row.name draw_text.color: ink draw_text.text_style.font_size: 14}
                                Label{text: "›" draw_text.color: faint draw_text.text_style.font_size: 21}
                            }
                            RowHit{on_click: || {if row.id == "wishes" {open_wishes()} else {open_box(row.id)}}}
                        }
                    }
                }
                Card{padding: 0 spacing: 0
                    for row in [{id: "settings", name: "设置"}, {id: "about", name: "关于礼遇"}] {
                        View{width: Fill height: 52 flow: Overlay
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 18 right: 18}
                                Label{width: Fill text: row.name draw_text.color: ink draw_text.text_style.font_size: 14}
                                Label{text: "›" draw_text.color: faint draw_text.text_style.font_size: 21}
                            }
                            RowHit{on_click: || {stage = row.id; refresh()}}
                        }
                    }
                }
                View{width: Fill height: Fit flow: Down spacing: 10 padding: Inset{top: 10 bottom: 10}
                    Secondary{width: Fill text: if demo_mode {"登录真实账号"} else {"切换账号"} on_click: || switch_account()}
                    Secondary{width: Fill text: if demo_mode {"退出本地演示"} else {"退出登录"} on_click: || logout()}
                }
            }
        }
        if tab == "me" && stage == "profile" {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Label{text: "基本资料" draw_text.color: muted draw_text.text_style: theme.font_bold{font_size: 13}}
                Card{padding: 0 spacing: 0
                    View{width: Fill height: 64 flow: Overlay
                        View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 18 right: 18} spacing: 12
                            Label{text: "显示名" draw_text.color: ink draw_text.text_style.font_size: 14}
                            Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: if profile != nil {profile.display_name} else {"正在加载…"} draw_text.color: muted draw_text.text_style.font_size: 13}
                            Label{text: "›" draw_text.color: faint draw_text.text_style.font_size: 21}
                        }
                        RowHit{on_click: || edit_display_name()}
                    }
                    View{width: Fill height: 88 flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 18 right: 18} spacing: 14
                        Label{width: Fill text: "头像" draw_text.color: ink draw_text.text_style.font_size: 14}
                        if profile != nil { Image{width: 56 height: 56 src: http_resource(profile_image()) fit: ImageFit.CropToFill} }
                    }
                }
                Card{padding: 0 spacing: 0
                    for field in [{id: "phone", name: "手机号"}, {id: "email", name: "邮箱"}] {
                        View{width: Fill height: 60 flow: Overlay
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 18 right: 18} spacing: 12
                                Label{text: field.name draw_text.color: ink draw_text.text_style.font_size: 14}
                                let value = if profile == nil {nil} else {if field.id == "phone" {profile.phone} else {profile.email}}
                                Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: if value == nil || value == "" {"未绑定"} else {value} draw_text.color: muted draw_text.text_style.font_size: 12}
                                Label{text: "›" draw_text.color: faint draw_text.text_style.font_size: 21}
                            }
                            RowHit{on_click: || edit_my_contact(field.id)}
                        }
                    }
                }
                View{width: Fill height: 36 flow: Right align: Align{x: 0.0 y: 0.5}
                    Label{width: Fill text: "收货地址" draw_text.color: muted draw_text.text_style: theme.font_bold{font_size: 13}}
                    Link{text: "+ 添加地址" on_click: || edit_address(-1)}
                }
                if addresses.len() == 0 { Card{padding: 18 spacing: 6
                    Label{text: "还没有保存地址" draw_text.color: ink draw_text.text_style.font_size: 14}
                    Label{width: Fill text: "支持多个收货地址，可设置默认地址。" draw_text.color: faint draw_text.text_style.font_size: 12}
                } }
                for a in addresses {
                    View{width: Fill height: 110 flow: Overlay
                        Card{height: Fill padding: 16 spacing: 7
                            View{width: Fill height: Fit flow: Right spacing: 10
                                Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: a.recipient_name + "  " + a.phone draw_text.color: ink draw_text.text_style.font_size: 14}
                                if a.is_default { Label{text: "默认" draw_text.color: accent draw_text.text_style.font_size: 12} }
                                Label{text: "›" draw_text.color: faint draw_text.text_style.font_size: 18}
                            }
                            Label{width: Fill max_lines: 2 text_overflow: Ellipsis text: a.address draw_text.color: muted draw_text.text_style.font_size: 13}
                        }
                        RowHit{on_click: || edit_address(a.id)}
                    }
                }
            }
        }
        if tab == "me" && stage == "profile_edit" {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Card{padding: 16 spacing: 10
                    Label{text: "显示名" draw_text.color: muted draw_text.text_style.font_size: 13}
                    Entry{empty_text: "输入显示名" text: profile_edit_value on_change: |v| profile_edit_value = v}
                    Label{text: "1–50 个字，让熟人更容易认出你。" draw_text.color: faint draw_text.text_style.font_size: 12}
                }
                Primary{width: Fill text: if profile_busy {"正在保存…"} else {"保存"} on_click: || save_display_name()}
            }
        }
        if tab == "me" && stage == "address_edit" {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Card{padding: 16 spacing: 10
                    Label{text: "收货人" draw_text.color: muted draw_text.text_style.font_size: 13}
                    Entry{empty_text: "收货人姓名" text: address_edit_name on_change: |v| address_edit_name = v}
                    Label{text: "手机号" draw_text.color: muted draw_text.text_style.font_size: 13}
                    Entry{empty_text: "11 位手机号" text: address_edit_phone on_change: |v| address_edit_phone = v}
                    Label{text: "详细地址" draw_text.color: muted draw_text.text_style.font_size: 13}
                    Entry{height: 88 is_multiline: true empty_text: "省 / 市 / 区、街道、门牌号" text: address_edit_text on_change: |v| address_edit_text = v}
                    Chip{text: if address_edit_default {"✓ 设为默认地址"} else {"○ 设为默认地址"} on_click: || {if !profile_busy {address_edit_default = !address_edit_default; refresh()}}}
                }
                Primary{width: Fill text: if profile_busy {"正在保存…"} else {"保存地址"} on_click: || save_address()}
                if address_edit_id >= 0 { Secondary{width: Fill text: "删除地址" on_click: || {if !profile_busy {stage = "address_delete"; notice = ""; refresh()}}} }
            }
        }
        if tab == "me" && stage == "address_delete" {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Card{padding: 16 spacing: 10
                    Label{text: "删除这个收货地址？" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}}
                    Label{width: Fill text: address_edit_name + " · " + address_edit_phone draw_text.color: muted draw_text.text_style.font_size: 13}
                    Label{width: Fill text: address_edit_text draw_text.color: faint draw_text.text_style.font_size: 13}
                }
                Primary{width: Fill text: if profile_busy {"正在删除…"} else {"确认删除"} on_click: || delete_address()}
                Secondary{width: Fill text: "取消" on_click: || {if !profile_busy {stage = "address_edit"; notice = ""; refresh()}}}
            }
        }
        if tab == "me" && stage == "wallet" {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Card{padding: 16 spacing: 8
                    Label{text: "礼遇余额" draw_text.color: muted draw_text.text_style.font_size: 13}
                    if wallet != nil { Label{text: money(wallet.balance_cents) draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 26}} }
                    Label{width: Fill text: "只在礼遇内使用 · 折现、换购退差都进这里" draw_text.color: faint draw_text.text_style.font_size: 12}
                }
                Label{text: "流水" draw_text.color: muted draw_text.text_style: theme.font_bold{font_size: 13}}
                if wallet == nil { Card{padding: 20 Label{text: "正在加载流水…" draw_text.color: faint draw_text.text_style.font_size: 13}} }
                if wallet != nil && wallet.ledger.len() == 0 {
                    Card{padding: 20 spacing: 6
                        Label{text: "暂无流水" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 14}}
                        Label{width: Fill text: "卖出礼物或换购产生差额后，记录会显示在这里。" draw_text.color: faint draw_text.text_style.font_size: 12}
                    }
                }
                if wallet != nil { for entry in wallet.ledger {
                    Card{padding: 16 spacing: 6
                        View{width: Fill height: Fit flow: Right align: Align{x: 0.0 y: 0.5} spacing: 8
                            Label{width: Fill text: wallet_kind_name(entry) draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 14}}
                            Label{text: wallet_amount(entry.amount_cents) draw_text.color: if entry.amount_cents < 0 {muted} else {accent} draw_text.text_style: theme.font_bold{font_size: 15}}
                        }
                        Label{text: expiry_time(entry.created_at_epoch) + " · 礼盒 #" + entry.gift_id draw_text.color: faint draw_text.text_style.font_size: 12}
                    }
                } }
            }
        }
        if tab == "me" && stage == "settings" {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Label{text: "外观" draw_text.color: muted draw_text.text_style: theme.font_bold{font_size: 13}}
                Card{padding: 14 spacing: 10
                    RoundedView{width: Fill height: Fit flow: Right padding: 4 spacing: 4 draw_bg +: {color: well border_radius: 8.0}
                        if appearance != "light" { SegmentOn{text: "深色" on_click: || set_appearance("dark")} }
                        else { Segment{text: "深色" on_click: || set_appearance("dark")} }
                        if appearance == "light" { SegmentOn{text: "浅色" on_click: || set_appearance("light")} }
                        else { Segment{text: "浅色" on_click: || set_appearance("light")} }
                    }
                }
                Label{text: "数据" draw_text.color: muted draw_text.text_style: theme.font_bold{font_size: 13}}
                Card{padding: 14 spacing: 8
                    Label{width: Fill text: status draw_text.color: muted draw_text.text_style.font_size: 13}
                    Secondary{text: if demo_mode {"刷新演示数据"} else {"刷新服务端数据"} on_click: || load_all()}
                }
            }
        }
        if tab == "me" && stage == "about" {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Card{padding: 16 spacing: 10
                    Label{text: "礼遇 LIYU-MINI" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                    Label{width: Fill text: "使用 OctoScript / Splash 呈现的 LIYU 简化版本。商品、熟人、心愿单与礼盒记录均来自本地 liyu-server。" draw_text.color: muted draw_text.text_style.font_size: 13}
                }
                Secondary{text: "一句话开始" on_click: || open_command()}
            }
        }
        if tab == "command" && stage == "browse" {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Card{padding: 16 spacing: 10
                    Label{text: "用一句话开始" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                    Label{width: Fill text: "从真实商品和熟人生成待确认的礼盒或心愿单。" draw_text.color: muted draw_text.text_style.font_size: 13}
                    command_entry := Entry{empty_text: "例如：送林舟一份咖啡" text: draft_command on_change: |v| draft_command = v}
                    Primary{text: "生成待确认卡片" on_click: || parse_command()}
                }
                Secondary{text: "新建心愿单" on_click: || begin("wish", -1)}
                Secondary{text: "挑礼" on_click: || begin("gift", -1)}
            }
        }
        if (tab == "command" && stage == "audience") || (tab == "wishes" && stage == "wish_audience") {
            View{width: Fill height: Fill flow: Down
                ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                    SearchBox{audience_search_entry := SearchEntry{empty_text: "搜索熟人或标签" text: audience_search on_change: |v| {audience_search = v; refresh()}}}
                    Card{padding: 0 spacing: 0
                        View{width: Fill height: 64 flow: Overlay
                            View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 16 right: 16} spacing: 12
                                Label{text: "♙" draw_text.color: accent draw_text.text_style.font_size: 22}
                                Label{width: Fill text: "所有熟人" draw_text.color: ink draw_text.text_style.font_size: 15}
                                Label{text: if draft_audience_all {"●"} else {"◯"} draw_text.color: if draft_audience_all {accent} else {faint} draw_text.text_style.font_size: 23}
                            }
                            RowHit{on_click: || {draft_audience_all = true; draft_audience_ids = []; draft_audience_tag_ids = []; refresh()}}
                        }
                    }
                    if friend_tags.len() > 0 {
                        Label{text: "我的标签" draw_text.color: muted draw_text.text_style.font_size: 13}
                        Card{padding: 0 spacing: 2
                            for tag in friend_tags { if audience_search.trim() == "" || tag.name.search(audience_search.trim()) >= 0 {
                                View{width: Fill height: 60 flow: Overlay
                                    View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 16 right: 16} spacing: 12
                                        Image{width: 24 height: 24 src: http_resource(assets + "/assets/ui/tag.png") fit: ImageFit.Stretch}
                                        Label{width: Fill text: tag.name + " (" + tag.member_count + ")" draw_text.color: ink draw_text.text_style.font_size: 15}
                                        Label{text: if has_id(draft_audience_tag_ids, tag.id) {"●"} else {"◯"} draw_text.color: if has_id(draft_audience_tag_ids, tag.id) {accent} else {faint} draw_text.text_style.font_size: 23}
                                    }
                                    RowHit{on_click: || {draft_audience_all = false; draft_audience_tag_ids = toggle_id(draft_audience_tag_ids, tag.id); refresh()}}
                                }
                            } }
                        }
                    }
                    Label{text: "熟人" draw_text.color: muted draw_text.text_style.font_size: 13}
                    Card{padding: 0 spacing: 2
                        for friend in friends { if friend_matches(friend, audience_search) {
                            View{width: Fill height: 64 flow: Overlay
                                View{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 16 right: 16} spacing: 12
                                    RoundedView{width: 36 height: 36 align: Align{x: 0.5 y: 0.5} draw_bg +: {color: soft border_radius: 18.0} Label{text: initial(friend.display_name) draw_text.color: accent draw_text.text_style.font_size: 16}}
                                    Label{width: Fill text: friend.display_name draw_text.color: ink draw_text.text_style.font_size: 15}
                                    Label{text: if has_id(draft_audience_ids, friend.id) {"●"} else {"◯"} draw_text.color: if has_id(draft_audience_ids, friend.id) {accent} else {faint} draw_text.text_style.font_size: 23}
                                }
                                RowHit{on_click: || {draft_audience_all = false; draft_audience_ids = toggle_id(draft_audience_ids, friend.id); refresh()}}
                            }
                        } }
                    }
                }
                View{width: Fill height: Fit padding: 16 draw_bg.color: canvas
                    Primary{width: Fill text: "完成 · " + audience_summary() on_click: || {
                        if !draft_audience_all && audience_ids().len() == 0 { notice = "请选择至少一位可见的熟人，或选择所有熟人。"; refresh() }
                        else { notice = ""; if tab == "wishes" { stage = "wish_edit" } else { stage = "draft" }; refresh() }
                    }}
                }
            }
        }
        if tab == "command" && stage == "draft" && draft_kind == "gift" {
            View{width: Fill height: Fill flow: Down
            gift_draft_scroll := ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Card{padding: 14 spacing: 10
                    View{width: Fill height: Fit flow: Right
                        Label{width: Fill text: "已选商品" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                        Secondary{text: "换一件" on_click: || shop_for_gift_replacement()}
                    }
                    if draft_product >= 0 {
                        View{width: Fill height: Fit flow: Right spacing: 10
                            Image{width: 56 height: 56 src: http_resource(product_image(products[draft_product])) fit: ImageFit.CropToFill}
                            View{width: Fill height: Fit flow: Down spacing: 3
                                Label{text: products[draft_product].name draw_text.color: ink draw_text.text_style.font_size: 14}
                                Label{text: products[draft_product].spec draw_text.color: faint draw_text.text_style.font_size: 12}
                                Label{text: money(products[draft_product].price_cents) draw_text.color: accent draw_text.text_style.font_size: 14}
                            }
                        }
                    }
                }
                Label{text: "送给谁（仅自己可见）" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                View{width: Fill height: Fit flow: Right{wrap: true} wrap_spacing: 8 spacing: 8
                    for id in draft_recipient_ids {
                        View{width: 184 height: 56 flow: Overlay
                            RoundedView{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: Inset{left: 38 right: 8} spacing: 7 draw_bg +: {color: button_surface border_color: border border_size: 1.0 border_radius: 8.0}
                                RoundedView{width: 32 height: 32 align: Align{x: 0.5 y: 0.5} draw_bg +: {color: soft border_radius: 16.0}
                                    Label{text: initial(recipient_name(id)) draw_text.color: accent draw_text.text_style.font_size: 15}
                                }
                                Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: recipient_name(id) draw_text.color: ink draw_text.text_style.font_size: 14}
                            }
                            View{width: Fill height: Fill flow: Down padding: Inset{left: 5 top: 5}
                                RemoveHit{on_click: || remove_recipient(id)}
                            }
                        }
                    }
                    Secondary{width: 184 height: 56 text: "+ TA" on_click: || {
                        if friends.len() == 0 { notice = "还没有可选的熟人。"; get("/friends", "friends"); refresh() }
                        else { stage = "recipient"; refresh() }
                    }}
                }
                Label{text: "礼盒有效期" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                gift_expiry_entry := Entry{empty_text: "有效小时数" text: draft_expiry_hours on_change: |v| {draft_expiry_hours = v; quote = nil}}
                Label{text: "默认 24 小时；可设置 1–720 小时（最多 30 天）。" draw_text.color: faint draw_text.text_style.font_size: 12}
                Label{text: "怎么拆开礼盒" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                Label{text: "收礼人都要主动打开礼盒；直接送会立即揭晓，谜题则要答对才能揭晓。" draw_text.color: faint draw_text.text_style.font_size: 12}
                View{width: Fill height: Fit flow: Right{wrap: true} wrap_spacing: 4 spacing: 4
                    for mode in [{id: "guess_who", name: "猜我是谁"}, {id: "question", name: "回答问题"}, {id: "free", name: "直接打开"}] {
                        if draft_unlock == mode.id { ChipOn{text: mode.name on_click: || {draft_unlock = mode.id; draft_error = ""; refresh()}} }
                        else { Chip{text: mode.name on_click: || {draft_unlock = mode.id; draft_error = ""; refresh()}} }
                    }
                }
                if draft_unlock != "free" { clue_entry := Entry{empty_text: if draft_unlock == "guess_who" {"留一点提示（可选）"} else {"填写题目"} text: draft_clue on_change: |v| draft_clue = v} }
                if draft_unlock == "question" { answer_entry := Entry{empty_text: "问题答案" text: draft_answer on_change: |v| draft_answer = v} }
                Label{text: "附个约定（可不填）" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                if contract_templates.len() > 0 {
                    View{width: Fill height: Fit flow: Right{wrap: true} wrap_spacing: 6 spacing: 6
                        for template in contract_templates {
                            if draft_contract == template.body { ChipOn{text: template.label on_click: || {draft_contract = template.body; refresh()}} }
                            else { Chip{text: template.label on_click: || {draft_contract = template.body; refresh()}} }
                        }
                    }
                }
                contract_entry := Entry{empty_text: "答应我一件小事" text: draft_contract on_change: |v| draft_contract = v}
                Label{text: "想说的话（可不填）" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                message_entry := Entry{empty_text: "给收礼人的寄语" text: draft_message on_change: |v| draft_message = v}
            }
            View{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 top: 8 bottom: 8} spacing: 6 draw_bg.color: canvas
                if draft_error != "" { Label{width: Fill text: draft_error draw_text.color: accent draw_text.text_style.font_size: 12} }
                Primary{width: Fill text: "去结算" on_click: || quote_gift()}
            }
            }
        }
        if tab == "command" && stage == "recipient" {
            View{width: Fill height: Fill flow: Down
            recipient_scroll := ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 12
                Label{text: "选择送给谁" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                Label{text: "已选 " + draft_recipient_ids.len() + " 位，点选熟人后添加为收礼人。" draw_text.color: faint draw_text.text_style.font_size: 12}
                View{width: Fill height: Fit flow: Right{wrap: true} wrap_spacing: 8 spacing: 8
                    for i in friends.len() { if !recipient_selected(friends[i].id) {
                        View{width: 184 height: 56 flow: Overlay
                            RoundedView{width: Fill height: Fill flow: Right align: Align{x: 0.0 y: 0.5} padding: 10 spacing: 8 draw_bg +: {color: button_surface border_color: border border_size: 1.0 border_radius: 8.0}
                                RoundedView{width: 38 height: 38 align: Align{x: 0.5 y: 0.5} draw_bg +: {color: soft border_radius: 19.0}
                                    Label{text: initial(friends[i].display_name) draw_text.color: accent draw_text.text_style.font_size: 17}
                                }
                                Label{width: Fill max_lines: 1 text_overflow: Ellipsis text: friends[i].display_name draw_text.color: ink draw_text.text_style.font_size: 14}
                            }
                            RowHit{on_click: || choose_recipient(i)}
                        }
                    } }
                }
            }
            }
        }
        if tab == "command" && stage == "checkout" {
            ScrollYView{width: Fill height: Fill flow: Down padding: 16 spacing: 14
                Card{padding: 16 spacing: 10
                    Label{text: "确认礼盒" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                    if draft_product >= 0 { Label{text: products[draft_product].name draw_text.color: ink} }
                    Label{text: "送给 " + draft_recipient_ids.len() + " 位熟人" draw_text.color: muted}
                    Label{text: "有效期  " + draft_expiry_hours + " 小时（测试支付后开始）" draw_text.color: muted draw_text.text_style.font_size: 13}
                    for id in draft_recipient_ids { Label{text: recipient_name(id) draw_text.color: muted draw_text.text_style.font_size: 13} }
                    Label{text: "解开方式  " + unlock_name(draft_unlock) draw_text.color: muted draw_text.text_style.font_size: 13}
                    if draft_unlock != "free" && draft_clue.trim() != "" { Label{width: Fill text: "提示  " + draft_clue.trim() draw_text.color: muted draw_text.text_style.font_size: 13} }
                    if quote != nil { Label{text: "应付  " + money(quote.total_cents) draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 24}} }
                    Label{width: Fill text: "本地测试结算会在 liyu-server 生成真实测试订单。" draw_text.color: faint draw_text.text_style.font_size: 12}
                }
                Primary{width: Fill text: "确认并测试支付" on_click: || create_order()}
                Secondary{width: Fill text: "返回修改礼盒" on_click: || {stage = "draft"; refresh()}}
            }
        }
    }
    if !desktop_mode { View{width: Fill height: 66 flow: Right padding: Inset{left: 5 right: 5 top: 5 bottom: 5} spacing: 2 draw_bg.color: bar
        for nav in [{id: "discover", name: "挑礼", icon: "gift"}, {id: "box", name: "礼盒", icon: "box"}, {id: "pact", name: "约定", icon: "pact"}, {id: "contacts", name: "熟人", icon: "contacts"}, {id: "me", name: "我", icon: "me"}] {
            View{width: Fill height: Fill flow: Overlay
                View{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 0.5} spacing: 2
                    if tab == nav.id { Image{width: 21 height: 21 src: http_resource(assets + "/assets/ui/nav-" + nav.icon + "-on.png") fit: ImageFit.Stretch} }
                    else { Image{width: 21 height: 21 src: http_resource(assets + "/assets/ui/nav-" + nav.icon + ".png") fit: ImageFit.Stretch} }
                    if tab == nav.id { Label{text: nav.name draw_text.color: accent draw_text.text_style.font_size: 11.5} }
                    else { Label{text: nav.name draw_text.color: muted draw_text.text_style.font_size: 11.5} }
                }
                NavHit{on_click: || go(nav.id)}
            }
        }
    } }
    }
    if desktop_mode && tab != "me" {
        ScrollYView{width: 300 height: Fill flow: Down padding: Inset{left: 0 right: 20 top: 20 bottom: 20} spacing: 14
            if tab == "discover" || tab == "command" {
                Card{padding: 16 spacing: 8
                    Label{text: "怎么玩" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}}
                    Label{width: Fill text: "1 挑选一件商品\n2 设置礼盒的拆开方式，可附一个约定\n3 送出礼盒，等 TA 拆开收到礼物" draw_text.color: muted draw_text.text_style.font_size: 13}
                }
                Card{padding: 16 spacing: 8
                    Label{text: "心愿单" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}}
                    Label{width: Fill text: "生日、乔迁、毕业……列出想要的商品，让熟人知道送什么。" draw_text.color: muted draw_text.text_style.font_size: 13}
                    Secondary{text: "我的心愿单" on_click: || open_wishes()}
                }
            }
            if tab == "box" { Card{padding: 16 spacing: 8
                Label{text: "礼盒一览" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}}
                Label{text: "收到 " + inbox.len() + " 个 · 送出 " + outbox.len() + " 个" draw_text.color: muted draw_text.text_style.font_size: 13}
            } }
            if tab == "pact" { Card{padding: 16 spacing: 8
                Label{text: "关于约定" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}}
                Label{width: Fill text: "只写轻约定，不涉及钱；兑现了记得标记。" draw_text.color: muted draw_text.text_style.font_size: 13}
            } }
            if tab == "contacts" { Card{padding: 16 spacing: 8
                Label{text: "熟人" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}}
                Label{text: friends.len() + " 位熟人" draw_text.color: muted draw_text.text_style.font_size: 13}
            } }
        }
    }
    }}}
    }
}
