          "path",
          "poll_key"
        ]
      },
      "liyu.delete": {
        "method": "POST",
        "path": "/api/v1/host/delete"
      },
      "liyu.patch": {
        "method": "POST",
        "path": "/api/v1/host/patch"
      },
      "liyu.post": {
        "method": "POST",
        "path": "/api/v1/host/post"
      },
      "liyu.put": {
        "method": "POST",
        "path": "/api/v1/host/put"
      },
      "liyu.read": {
        "method": "GET",
        "path": "/api/v1/host/read",
        "query_keys": [
          "path"
        ]
      }
    },
    "scopes": [
      "app.session"
    ],
    "token_url": "https://liyu.taidge.com/oauth/token"
  },
  "capabilities": [
    "images",
    "model",
    "net",
    "storage",
    "auth",
    "runtime",
    "device_calendar"
  ],
  "host_api": {
    "optional": {
      "device_calendar.calendars.list": 1,
      "device_calendar.calendars.select": 1,
      "device_calendar.events.create": 1,
      "device_calendar.events.get": 1,
      "device_calendar.events.list": 1,
      "device_calendar.events.update": 1,
      "device_calendar.permission.request": 1,
      "device_calendar.permission.status": 1
    },
    "required": {
      "auth.backend.request": 1
    }
  },
  "id": "liyu-mini",
  "integrity": {
    "bundle_blake3": "05fa201c17fe5660ccbbff42aed2a8084acdddadaa3ab9c16c0c4d3117ca7b1d"
  },
  "name": "LIYU-MINI",
  "network": {
    "hosts": [
      "liyu.taidge.com"
    ]
  },
  "requires": [
    "backend-api-v1",
    "host-api-v1"
  ],
  "schema": 1,
  "storage": {
    "accounts": true
  },
  "version": "1.0.41"
