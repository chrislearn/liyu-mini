{
  "backend": {
    "authorization_url": "https://liyu.taidge.com/oauth/authorize",
    "client_id": "liyu-mini-host-v1",
    "id": "liyu",
    "logout_url": "https://liyu.taidge.com/oauth/logout",
    "me_url": "https://liyu.taidge.com/oauth/me",
    "operations": {
      "liyu.contact_status": {
        "method": "GET",
        "path": "/api/v1/host/contact-status",
